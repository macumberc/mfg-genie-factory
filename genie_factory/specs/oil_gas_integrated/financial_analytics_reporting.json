          "name": "transaction_id",
          "sql_type": "STRING",
          "comment": "Unique financial transaction identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('FT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.cost_center_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "transaction_date",
          "sql_type": "DATE",
          "comment": "Date of the financial transaction",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "cost_center_id",
          "sql_type": "STRING",
          "comment": "Cost center identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "cost_center_name",
          "sql_type": "STRING",
          "comment": "Cost center name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "division",
          "sql_type": "STRING",
          "comment": "Division: Upstream, Downstream, Midstream, Corporate",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
