          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('FK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.cost_center_id) + 30000 AS STRING), 6, '0'))"
        },
