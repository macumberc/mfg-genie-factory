          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "operating_margin_pct",
          "sql_type": "DOUBLE",
          "comment": "Operating margin percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-10.0, 5.0 + ({qty_noise} * {seasonal_mult}) * 30.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "roic_pct",
          "sql_type": "DOUBLE",
          "comment": "Return on invested capital",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-5.0, 3.0 + ({qty_noise} * {seasonal_mult}) * 17.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "opex_per_boe",
          "sql_type": "DOUBLE",
          "comment": "Operating expense per barrel of oil equivalent",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(5.0, 8.0 + {qty_noise} * 22.0), 2)"
        },
        {
          "name": "headcount",
          "sql_type": "INT",
          "comment": "Full-time equivalent headcount",
          "is_dimension": false,
          "generation_expr": "CAST(50 + FLOOR({qty_noise} * 450) AS INT)"
        }
      ],
