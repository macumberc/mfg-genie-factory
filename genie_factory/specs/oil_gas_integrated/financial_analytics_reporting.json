          "comment": "Geographic region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "account_type",
          "sql_type": "STRING",
          "comment": "Account: Revenue, OPEX, CAPEX, Depreciation, G&A",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'Revenue' WHEN {status_noise} < 0.55 THEN 'OPEX' WHEN {status_noise} < 0.72 THEN 'CAPEX' WHEN {status_noise} < 0.85 THEN 'Depreciation' ELSE 'G&A' END"
        },
        {
          "name": "amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Transaction amount in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1000.0, {qty_noise} * 5000000.0), 2)"
        },
        {
          "name": "budget_amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Budgeted amount in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1000.0, {qty_noise} * 5200000.0), 2)"
        },
        {
          "name": "gl_category",
          "sql_type": "STRING",
          "comment": "GL category: Production, Exploration, Refining, Marketing, Transportation, Admin",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.22 THEN 'Production' WHEN {alt_status_noise} < 0.38 THEN 'Exploration' WHEN {alt_status_noise} < 0.55 THEN 'Refining' WHEN {alt_status_noise} < 0.70 THEN 'Marketing' WHEN {alt_status_noise} < 0.85 THEN 'Transportation' ELSE 'Admin' END"
        }
      ],
