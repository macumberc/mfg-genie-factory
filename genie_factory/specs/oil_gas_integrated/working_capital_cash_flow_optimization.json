  "example_sqls": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', transaction_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.cash_transactions",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "How has highest amount changed over time?",
      "sql_lines": [
        "SELECT transaction_date, MEASURE(max_amount) AS max_amount",
        "FROM {fqn}.cash_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY transaction_date",
        "LIMIT 10"
      ]
    },
    {
      "question": "How has total payables trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, MEASURE(total_payables_usd) AS total_payables_usd",
        "FROM {fqn}.working_capital_snapshots_metrics",
        "GROUP BY ALL",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "How does cash flow amount in compare across business units?",
      "sql_lines": [
        "SELECT business_unit_name, SUM(amount_usd) AS total_amount_usd",
        "FROM {fqn}.cash_transactions",
        "GROUP BY business_unit_name",
        "ORDER BY business_unit_name",
        "LIMIT 10"
      ]
    },
    {
      "question": "How has total accounts receivable balance in trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, SUM(accounts_receivable_usd) AS total_accounts_receivable_usd",
        "FROM {fqn}.working_capital_snapshots",
        "GROUP BY snapshot_date",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "How has the average current ratio (current assets / current liabilities) changed over time?",
      "sql_lines": [
        "SELECT kpi_month, AVG(current_ratio) AS avg_current_ratio",
        "FROM {fqn}.cashflow_kpi_monthly",
        "GROUP BY kpi_month ORDER BY kpi_month"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', transaction_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.cash_transactions",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    }
  ],
  "sql_snippets": {
    "filters": [
      {
        "sql": "flow_type = 'Collection'",
