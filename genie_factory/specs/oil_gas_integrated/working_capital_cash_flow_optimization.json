{
  "company_name": "CashFlow Energy",
  "industry": "Oil & Gas Integrated",
  "use_case": "Working capital and cash flow optimization for integrated oil and gas operations",
  "space_title": "CashFlow Energy - Working Capital & Cash Flow Optimization 💰",
  "space_description": "**Subindustry:** Oil & Gas Integrated\n\n**Use case:** Working Capital & Cash Flow Optimization\n\nCashFlow Energy — treasury and working-capital analytics across 20 business units spanning Upstream, Downstream, Midstream, and Corporate. Treasury and the Controller use this space to monitor daily inflows / outflows, receivables aging, and DSO/DPO trends; the CFO and Treasurer use it for liquidity planning, cash-conversion-cycle reduction, net debt management, and free-cash-flow forecasting to support dividend and buyback decisions.\n\n**Key KPIs**\n- Free cash flow ($MM) — primary shareholder-return funding source\n- DSO (days sales outstanding) — IOC benchmark 30-45 days\n- DPO (days payable outstanding) — typically 30-50 days for majors\n- Cash conversion cycle (days) — DSO + DIO - DPO; lower = better\n- Current ratio — liquidity health, target >1.0\n- Net debt ($MM) — leverage indicator\n- Accounts receivable / payable / inventory ($MM) — working-capital component balances\n- Cash balance ($MM) — on-hand liquidity by business unit\n\n**Data sources**\n- `cash_transactions` — daily inflows, outflows, intercompany, tax, dividend with days outstanding\n- `working_capital_snapshots` — weekly AR, AP, inventory, cash, DSO, DPO snapshots\n- `cashflow_kpi_monthly` — monthly free cash flow, cash conversion cycle, current ratio, net debt",
  "schema_basename": "og_integrated_cashflow",
  "tables": [
    {
      "table_name": "cash_transactions",
      "description": "Daily cash inflows and outflows including collections, disbursements, and intercompany transfers.",
      "columns": [
        {
          "name": "transaction_id",
          "sql_type": "STRING",
          "comment": "Unique cash transaction identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('CT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.business_unit_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "transaction_date",
          "sql_type": "DATE",
          "comment": "Date of the cash transaction",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "business_unit_id",
          "sql_type": "STRING",
          "comment": "Business unit identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "business_unit_name",
          "sql_type": "STRING",
          "comment": "Business unit name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "segment",
          "sql_type": "STRING",
          "comment": "Business segment: Upstream, Downstream, Midstream, Corporate",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Geographic region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "flow_type",
          "sql_type": "STRING",
          "comment": "Flow type: Collection, Disbursement, Intercompany, Tax Payment, Dividend",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'Collection' WHEN {status_noise} < 0.65 THEN 'Disbursement' WHEN {status_noise} < 0.80 THEN 'Intercompany' WHEN {status_noise} < 0.92 THEN 'Tax Payment' ELSE 'Dividend' END"
        },
        {
          "name": "amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Cash flow amount in USD (positive = inflow)",
          "is_dimension": false,
          "generation_expr": "ROUND(CASE WHEN {alt_status_noise} < 0.35 THEN {qty_noise} * 8000000.0 ELSE -{qty_noise} * 6000000.0 END, 2)"
        },
        {
          "name": "counterparty",
          "sql_type": "STRING",
          "comment": "Counterparty: Customer, Supplier, Government, Internal, Shareholder",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.30 THEN 'Customer' WHEN {alt_status_noise2} < 0.55 THEN 'Supplier' WHEN {alt_status_noise2} < 0.72 THEN 'Government' WHEN {alt_status_noise2} < 0.88 THEN 'Internal' ELSE 'Shareholder' END"
        },
        {
          "name": "days_outstanding",
          "sql_type": "INT",
          "comment": "Days since invoice or commitment",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(0, FLOOR({qty_noise} * 120)) AS INT)"
        }
      ],
