          "cash negative"
        ],
        "instruction": "Use to identify business units burning cash."
      }
    ],
    "expressions": [
      {
        "alias": "net_working_capital_usd",
        "sql": "working_capital_snapshots.accounts_receivable_usd + working_capital_snapshots.inventory_usd - working_capital_snapshots.accounts_payable_usd",
        "display_name": "net working capital",
        "synonyms": [
          "NWC",
          "working capital"
        ]
      },
      {
        "alias": "cash_conversion_cycle",
        "sql": "ROUND(working_capital_snapshots.dso_days - working_capital_snapshots.dpo_days, 1)",
        "display_name": "cash conversion cycle",
        "synonyms": [
          "CCC",
          "cash cycle"
        ]
      },
      {
        "alias": "transaction_month",
        "sql": "DATE_TRUNC('month', cash_transactions.transaction_date)",
        "display_name": "transaction month",
        "synonyms": [
          "month",
          "period"
        ]
      }
    ],
    "measures": [
      {
        "alias": "total_inflows_usd",
        "sql": "SUM(CASE WHEN cash_transactions.amount_usd > 0 THEN cash_transactions.amount_usd ELSE 0 END)",
        "display_name": "total cash inflows",
        "synonyms": [
          "collections",
          "inflows"
        ]
      },
      {
        "alias": "total_outflows_usd",
        "sql": "SUM(CASE WHEN cash_transactions.amount_usd < 0 THEN ABS(cash_transactions.amount_usd) ELSE 0 END)",
        "display_name": "total cash outflows",
        "synonyms": [
          "disbursements",
          "outflows"
        ]
      },
      {
        "alias": "total_free_cash_flow",
        "sql": "SUM(cashflow_kpi_monthly.free_cash_flow_usd)",
        "display_name": "total free cash flow",
        "synonyms": [
          "FCF",
          "free cash"
        ]
      },
      {
        "alias": "avg_current_ratio",
        "sql": "AVG(cashflow_kpi_monthly.current_ratio)",
        "display_name": "average current ratio",
        "synonyms": [
          "liquidity",
          "current ratio"
        ]
      }
    ]
  },
  "benchmarks": [
    {
      "question": "How has total inflows trended over time?",
      "sql_lines": [
        "SELECT transaction_date, MEASURE(total_inflows_usd) AS total_inflows_usd",
        "FROM {fqn}.cash_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY transaction_date"
      ]
    },
    {
      "question": "How has total outflows trended over time?",
      "sql_lines": [
        "SELECT transaction_date, MEASURE(total_outflows_usd) AS total_outflows_usd",
        "FROM {fqn}.cash_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY transaction_date"
      ]
    },
    {
      "question": "What has been the peak accounts_receivable each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', snapshot_date) AS month, MEASURE(max_accounts_receivable) AS peak_accounts_receivable_usd",
        "FROM {fqn}.working_capital_snapshots_metrics",
        "WHERE snapshot_date IS NOT NULL",
        "GROUP BY ALL",
        "HAVING peak_accounts_receivable_usd IS NOT NULL",
        "ORDER BY month"
      ]
    },
    {
      "question": "How has total receivables trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, MEASURE(total_receivables_usd) AS total_receivables_usd",
        "FROM {fqn}.working_capital_snapshots_metrics",
        "GROUP BY ALL",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "Which business units have the most cash flow amount?",
      "sql_lines": [
        "SELECT business_unit_name, SUM(amount_usd) AS total_amount_usd",
        "FROM {fqn}.cash_transactions",
        "WHERE business_unit_name IS NOT NULL",
        "GROUP BY business_unit_name",
        "ORDER BY total_amount_usd DESC"
