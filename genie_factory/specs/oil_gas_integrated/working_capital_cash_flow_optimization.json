        {
          "name": "free_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Free cash flow in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(-5000000.0 + {qty_noise} * 50000000.0, 2)"
        },
        {
          "name": "cash_conversion_cycle_days",
          "sql_type": "DOUBLE",
          "comment": "Cash conversion cycle in days",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-10.0, 15.0 + {qty_noise} * 60.0), 1)"
        },
        {
          "name": "current_ratio",
          "sql_type": "DOUBLE",
          "comment": "Current ratio (current assets / current liabilities)",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(0.5, 0.8 + ({qty_noise} * {seasonal_mult}) * 1.5), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "net_debt_usd",
          "sql_type": "DOUBLE",
          "comment": "Net debt position in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-50000000.0, {qty_noise} * 300000000.0), 2)"
        }
      ],
