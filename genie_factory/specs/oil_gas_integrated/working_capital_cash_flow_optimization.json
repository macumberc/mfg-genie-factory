          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('CK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.business_unit_id) + 30000 AS STRING), 6, '0'))"
        },
        {
          "name": "kpi_month",
          "sql_type": "DATE",
          "comment": "First day of the KPI month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "business_unit_id",
