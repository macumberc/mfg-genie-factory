          "name": "snapshot_date",
          "expr": "snapshot_date"
        },
        {
          "name": "business_unit_id",
          "expr": "business_unit_id"
        },
        {
          "name": "segment",
          "expr": "segment"
        },
        {
          "name": "region",
          "expr": "region"
        }
      ],
      "measures": [
        {
          "name": "total_receivables_usd",
          "expr": "SUM(accounts_receivable_usd)",
          "comment": "Total accounts receivable in USD"
        },
        {
          "name": "total_payables_usd",
          "expr": "SUM(accounts_payable_usd)",
          "comment": "Total accounts payable in USD"
        },
        {
          "name": "total_inventory_usd",
          "expr": "SUM(inventory_usd)",
          "comment": "Total inventory value in USD"
        },
        {
          "name": "total_cash_balance_usd",
          "expr": "SUM(cash_balance_usd)",
          "comment": "Total cash and equivalents in USD"
        },
        {
          "name": "avg_dso_days",
          "expr": "AVG(dso_days)",
          "comment": "Average days sales outstanding"
        },
        {
          "name": "total_dpo_days",
          "expr": "SUM(dpo_days)",
          "comment": "Total dpo days"
        },
        {
          "name": "max_accounts_receivable",
          "expr": "MAX(accounts_receivable_usd)",
          "comment": "Maximum accounts receivable usd"
        }
      ]
