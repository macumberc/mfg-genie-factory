      "question": "Which vehicle class: heavy duty, medium duty, light duty, sprinters have the highest total cargo weight in kilograms?",
      "sql_lines": [
        "SELECT vehicle_class, SUM(cargo_weight_kg) AS total_metric",
        "FROM {fqn}.fleet_operations",
        "GROUP BY 1",
