          "name": "operation_id",
          "sql_type": "STRING",
          "comment": "Unique fleet operation identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('FOP-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "operation_date",
          "sql_type": "DATE",
          "comment": "Date of the fleet operation",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "vehicle_id",
          "sql_type": "STRING",
          "comment": "Vehicle asset identifier",
          "is_dimension": true,
          "generation_expr": ""
