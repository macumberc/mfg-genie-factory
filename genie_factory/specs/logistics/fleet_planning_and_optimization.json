  "benchmarks": [
    {
      "question": "What is the monthly trend in on time operation count?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', operation_date) AS month, MEASURE(on_time_operation_count) AS on_time_operation_count",
        "FROM {fqn}.fleet_operations_metrics",
        "GROUP BY ALL",
        "ORDER BY month"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', operation_date) AS month, COUNT(DISTINCT operation_id) AS distinct_transaction_count",
        "FROM {fqn}.fleet_operations",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "What has been the peak monthly_revenue each month?",
      "sql_lines": [
        "SELECT report_month, MEASURE(max_monthly_revenue) AS max_monthly_revenue",
        "FROM {fqn}.fleet_kpi_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY report_month"
      ]
    },
    {
      "question": "Which vehicles have the highest total total route distance in kilometers?",
      "sql_lines": [
        "SELECT vehicle_name, SUM(route_distance_km) AS total_metric",
        "FROM {fqn}.fleet_operations",
        "GROUP BY 1",
        "ORDER BY total_metric DESC",
        "LIMIT 10"
      ]
    },
