    {
      "question": "Which vehicles have the best dispatched hours of available hours?",
      "sql_lines": [
        "SELECT vehicle_name, AVG(utilization_pct) AS avg_utilization_pct",
        "FROM {fqn}.vehicle_utilization_snapshots",
        "GROUP BY vehicle_name",
        "ORDER BY avg_utilization_pct DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which depots have the most idle hours?",
      "sql_lines": [
        "SELECT depot_code, SUM(idle_hours) AS total_idle_hours",
        "FROM {fqn}.vehicle_utilization_snapshots vus",
        "JOIN {fqn}.fleet_operations fo ON vus.vehicle_id = fo.vehicle_id",
        "GROUP BY depot_code",
        "ORDER BY total_idle_hours DESC",
        "LIMIT 10"
