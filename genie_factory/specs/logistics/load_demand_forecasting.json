  "metric_views": [
    {
      "view_name": "shipment_orders_metrics",
      "source_table": "shipment_orders",
      "dimensions": [
        {
          "name": "order_date",
          "expr": "order_date"
        },
        {
          "name": "lane_category",
          "expr": "lane_category"
        },
        {
          "name": "origin_hub",
          "expr": "origin_hub"
        },
        {
          "name": "order_status",
          "expr": "order_status"
        }
      ],
      "measures": [
        {
          "name": "total_freight_revenue",
          "expr": "SUM(freight_charge_usd) FILTER (WHERE order_status = 'Delivered')",
          "comment": "Total revenue from delivered shipments in USD"
        },
        {
          "name": "total_weight_delivered_lbs",
          "expr": "SUM(weight_lbs) FILTER (WHERE order_status = 'Delivered')",
          "comment": "Total weight delivered in pounds"
        },
        {
          "name": "delivered_order_count",
          "expr": "COUNT(DISTINCT CASE WHEN order_status = 'Delivered' THEN order_id END)",
          "comment": "Count of delivered orders"
        },
        {
          "name": "total_order_count",
          "expr": "COUNT(DISTINCT order_id)",
          "comment": "Total orders placed"
        },
        {
          "name": "delayed_order_count",
          "expr": "COUNT(DISTINCT CASE WHEN order_status = 'Delayed' THEN order_id END)",
          "comment": "Count of delayed orders"
        },
        {
          "name": "avg_transit_days",
          "expr": "AVG(transit_days) FILTER (WHERE order_status = 'Delivered')",
          "comment": "Average transit days for delivered orders"
        },
        {
          "name": "unique_lane_count",
          "expr": "COUNT(DISTINCT lane_id)",
          "comment": "Number of distinct lanes"
        },
        {
          "name": "max_weight_lbs",
          "expr": "MAX(weight_lbs)",
          "comment": "Maximum weight lbs"
        }
      ]
    },
    {
      "view_name": "demand_forecasts_metrics",
      "source_table": "demand_forecasts",
      "dimensions": [
        {
          "name": "forecast_month",
          "expr": "forecast_month"
        },
        {
          "name": "lane_category",
          "expr": "lane_category"
        },
        {
          "name": "hub_code",
          "expr": "hub_code"
        },
        {
          "name": "model_version",
          "expr": "model_version"
        }
      ],
      "measures": [
        {
          "name": "total_forecasted_shipments",
          "expr": "SUM(forecasted_shipments)",
          "comment": "Sum of forecasted shipment counts"
        },
        {
          "name": "total_actual_shipments",
          "expr": "SUM(actual_shipments)",
          "comment": "Sum of actual shipment counts"
        },
        {
          "name": "total_forecasted_weight_tons",
          "expr": "SUM(forecasted_weight_tons)",
          "comment": "Total forecasted weight in tons"
        },
        {
          "name": "total_actual_weight_tons",
          "expr": "SUM(actual_weight_tons)",
          "comment": "Total actual weight in tons"
