          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.125 THEN 'HUB-CHI' WHEN {status_noise} < 0.25 THEN 'HUB-DAL' WHEN {status_noise} < 0.375 THEN 'HUB-ATL' WHEN {status_noise} < 0.5 THEN 'HUB-LAX' WHEN {status_noise} < 0.625 THEN 'HUB-NYC' WHEN {status_noise} < 0.75 THEN 'HUB-SEA' WHEN {status_noise} < 0.875 THEN 'HUB-DEN' ELSE 'HUB-MIA' END"
