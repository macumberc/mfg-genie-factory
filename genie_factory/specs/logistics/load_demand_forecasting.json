          "sql_type": "DOUBLE",
          "comment": "Actual total weight in tons",
          "is_dimension": false,
          "generation_expr": "ROUND((150 + {qty_noise} * 1350) * (6.0 + {qty_noise} * 14.0) * (0.90 + {qty_noise} * 0.20), 1)"
        }
