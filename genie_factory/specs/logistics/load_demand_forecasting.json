          "comment": "Forecast model version",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.33 THEN 'v2.0' WHEN {alt_status_noise} < 0.66 THEN 'v2.1' ELSE 'v2.2' END"
        },
        {
          "name": "forecasted_shipments",
