          "sql_type": "INT",
          "comment": "Actual shipment count for month",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR((150 + {qty_noise} * 1350) * (0.88 + {qty_noise} * 0.24)) AS INT)"
        },
        {
          "name": "forecasted_weight_tons",
          "sql_type": "DOUBLE",
          "comment": "Predicted total weight in tons",
          "is_dimension": false,
          "generation_expr": "ROUND((150 + {qty_noise} * 1350) * (6.0 + {qty_noise} * 14.0), 1)"
        },
