          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.125 THEN 'Chicago Hub' WHEN {status_noise} < 0.25 THEN 'Dallas Hub' WHEN {status_noise} < 0.375 THEN 'Atlanta Hub' WHEN {status_noise} < 0.5 THEN 'Los Angeles Hub' WHEN {status_noise} < 0.625 THEN 'New York Hub' WHEN {status_noise} < 0.75 THEN 'Seattle Hub' WHEN {status_noise} < 0.875 THEN 'Denver Hub' ELSE 'Miami Hub' END"
        },
        {
          "name": "destination_hub",
          "sql_type": "STRING",
          "comment": "Destination hub",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.125 THEN 'Denver Hub' WHEN {alt_status_noise} < 0.25 THEN 'Miami Hub' WHEN {alt_status_noise} < 0.375 THEN 'New York Hub' WHEN {alt_status_noise} < 0.5 THEN 'Chicago Hub' WHEN {alt_status_noise} < 0.625 THEN 'Dallas Hub' WHEN {alt_status_noise} < 0.75 THEN 'Atlanta Hub' WHEN {alt_status_noise} < 0.875 THEN 'Los Angeles Hub' ELSE 'Seattle Hub' END"
        },
        {
          "name": "weight_lbs",
          "sql_type": "DOUBLE",
          "comment": "Shipment weight in pounds",
          "is_dimension": false,
          "generation_expr": "ROUND(500 + {qty_noise} * 39500, 1)"
