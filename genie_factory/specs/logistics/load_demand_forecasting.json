          "comment": "Status: Delivered, In Transit, Delayed, Cancelled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.03 THEN 'Cancelled' WHEN {alt_status_noise2} < 0.10 THEN 'Delayed' WHEN {alt_status_noise2} < 0.18 THEN 'In Transit' ELSE 'Delivered' END"
