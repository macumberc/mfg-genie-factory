      "sql_lines": [
        "SELECT depot_name, SUM(distance_km) AS total_distance_km",
        "FROM {fqn}.route_legs",
        "WHERE leg_date >= DATE_SUB(CURRENT_DATE(), 7)",
        "GROUP BY depot_name",
        "ORDER BY total_distance_km DESC",
        "LIMIT 10"
