      "table_name": "route_efficiency_metrics",
      "description": "Weekly aggregated route efficiency metrics per vehicle including total distance, fuel, on-time delivery rate, cost per delivery, and CO2 emissions.",
      "columns": [
        {
          "name": "metric_id",
          "sql_type": "STRING",
          "comment": "Unique weekly metric record ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('MET-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "week_start",
          "sql_type": "DATE",
          "comment": "Start of reporting week",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('week', dt)"
