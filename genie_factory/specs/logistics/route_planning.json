        },
        {
          "name": "vehicle_type",
          "sql_type": "STRING",
          "comment": "Vehicle class: Semi, Truck, or Van",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "total_distance_km",
          "sql_type": "DOUBLE",
          "comment": "Total distance driven in the week in km",
          "is_dimension": false,
          "generation_expr": "ROUND(800 + {qty_noise} * 4200, 1)"
        },
        {
          "name": "total_fuel_liters",
          "sql_type": "DOUBLE",
          "comment": "Total fuel consumed in the week in liters",
          "is_dimension": false,
          "generation_expr": "ROUND((800 + {qty_noise} * 4200) / (3.0 + {qty_noise} * 5.0), 2)"
        },
        {
          "name": "on_time_delivery_pct",
          "sql_type": "DOUBLE",
          "comment": "Percentage of deliveries completed on time",
          "is_dimension": false,
          "generation_expr": "ROUND(75 + ({qty_noise} * {seasonal_mult}) * 24, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "deliveries_completed",
          "sql_type": "INT",
          "comment": "Number of deliveries completed in the week",
          "is_dimension": false,
          "generation_expr": "CAST(5 + FLOOR({qty_noise} * 25) AS INT)"
        },
        {
          "name": "cost_per_delivery_usd",
          "sql_type": "DOUBLE",
          "comment": "Average fuel cost per delivery in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(40 + {qty_noise} * 160, 2)"
        },
        {
          "name": "co2_emissions_kg",
          "sql_type": "DOUBLE",
          "comment": "Estimated CO2 emissions in kg for the week",
          "is_dimension": false,
          "generation_expr": "ROUND((800 + {qty_noise} * 4200) / (3.0 + {qty_noise} * 5.0) * 2.68, 1)"
        }
