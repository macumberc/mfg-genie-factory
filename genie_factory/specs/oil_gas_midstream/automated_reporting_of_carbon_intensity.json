          "name": "carbon_intensity_kg_boe",
          "sql_type": "DOUBLE",
          "comment": "Carbon intensity kg CO2e per BOE",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1.0, 5.0 + ({qty_noise} * {seasonal_mult}) * 25.0), 2)",
