          "name": "throughput_boe",
          "sql_type": "DOUBLE",
          "comment": "Throughput BOE for intensity",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(100.0, ({qty_noise} * {seasonal_mult}) * 50000.0), 0)",
          "seasonal_amplitude": 0.15
        },
