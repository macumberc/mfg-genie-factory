  "benchmarks": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', run_date) AS month, COUNT(DISTINCT run_id) AS distinct_transactions",
        "FROM {fqn}.simulation_runs",
        "WHERE run_id IS NOT NULL AND run_date IS NOT NULL",
        "GROUP BY month",
        "ORDER BY month"
      ]
    },
    {
      "question": "How has highest throughput change percent changed over time?",
      "sql_lines": [
        "SELECT run_date, MEASURE(max_throughput_change_percent) AS max_throughput_change_percent",
        "FROM {fqn}.simulation_runs_metrics",
        "WHERE run_date IS NOT NULL",
        "GROUP BY ALL",
        "ORDER BY run_date"
      ]
    },
    {
      "question": "How has total ebitda mm trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, MEASURE(avg_ebitda_mm) AS avg_ebitda_mm",
        "FROM {fqn}.outcome_snapshots_metrics",
        "GROUP BY ALL",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "Which scenarios have the best average throughput change percentage?",
      "sql_lines": [
        "WITH scenario_throughput AS (SELECT scenario_id, MEASURE(avg_throughput_change_pct) AS avg_throughput_change_pct",
        "FROM {fqn}.simulation_runs_metrics",
        "WHERE scenario_id IS NOT NULL",
        "GROUP BY ALL) SELECT scenario_id, avg_throughput_change_pct, RANK() OVER (ORDER BY avg_throughput_change_pct DESC) AS rank",
        "FROM scenario_throughput",
        "WHERE avg_throughput_change_pct IS NOT NULL QUALIFY rank <= 10",
        "ORDER BY rank"
      ]
    },
    {
      "question": "Which scenarios have the highest total revenue impact millions?",
      "sql_lines": [
        "WITH ranked_scenarios AS ( SELECT scenario_id, MEASURE(avg_revenue_impact_mm) AS total_revenue_impact_mm, RANK() OVER (ORDER BY MEASURE(avg_revenue_impact_mm) DESC) AS rnk",
        "FROM {fqn}.simulation_runs_metrics",
        "GROUP BY ALL ) SELECT scenario_id, total_revenue_impact_mm",
        "FROM ranked_scenarios",
        "WHERE rnk <= 10",
        "ORDER BY total_revenue_impact_mm DESC"
      ]
    },
    {
      "question": "What is the average regulatory risk 0-100 by scenario name?",
      "sql_lines": [
        "SELECT scenario_name, AVG(regulatory_risk_score) AS avg_regulatory_risk_score",
        "FROM {fqn}.outcome_snapshots",
        "GROUP BY scenario_name ORDER BY avg_regulatory_risk_score DESC"
      ]
    },
    {
      "question": "Which scenario types have the highest total weighted npv millions?",
      "sql_lines": [
        "SELECT scenario_type, SUM(weighted_npv_mm) AS total_metric",
        "FROM {fqn}.scenario_kpi_monthly",
        "GROUP BY 1",
        "ORDER BY total_metric DESC",
        "LIMIT 10"
      ]
    }
  ],
