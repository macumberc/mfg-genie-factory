  "metric_views": [
    {
      "view_name": "compliance_events_metrics",
      "source_table": "compliance_events",
      "dimensions": [
        {
          "name": "event_date",
          "expr": "event_date"
        },
        {
          "name": "reg_id",
          "expr": "reg_id"
        },
        {
          "name": "regulatory_body",
          "expr": "regulatory_body"
        },
        {
          "name": "compliance_area",
          "expr": "compliance_area"
        },
        {
          "name": "event_type",
          "expr": "event_type"
        },
        {
          "name": "severity",
          "expr": "severity"
        },
        {
          "name": "status",
          "expr": "status"
        }
      ],
      "measures": [
        {
          "name": "total_events",
          "expr": "COUNT(DISTINCT event_id)",
          "comment": "Total compliance events"
        },
        {
          "name": "total_fines_usd",
          "expr": "SUM(fine_amount_usd)",
          "comment": "Total fines USD"
        },
        {
          "name": "avg_resolution_days",
          "expr": "AVG(resolution_days)",
          "comment": "Avg resolution days"
        },
        {
          "name": "violation_count",
          "expr": "COUNT(DISTINCT CASE WHEN event_type = 'Violation' THEN event_id END)",
          "comment": "Total violations"
        },
        {
          "name": "max_fine_amount",
          "expr": "MAX(fine_amount_usd)",
          "comment": "Maximum fine amount usd"
        }
      ]
    },
    {
      "view_name": "audit_snapshots_metrics",
      "source_table": "audit_snapshots",
      "dimensions": [
        {
          "name": "snapshot_date",
          "expr": "snapshot_date"
        },
        {
          "name": "reg_id",
          "expr": "reg_id"
        },
        {
          "name": "regulatory_body",
          "expr": "regulatory_body"
        },
        {
          "name": "compliance_area",
          "expr": "compliance_area"
        }
      ],
      "measures": [
        {
          "name": "avg_compliance_score",
          "expr": "AVG(compliance_score)",
          "comment": "Avg compliance score"
        },
        {
          "name": "total_open_findings",
          "expr": "SUM(open_findings)",
          "comment": "Total open findings"
        },
        {
          "name": "total_overdue_actions",
