      "table_name": "financial_kpi_monthly",
      "description": "Monthly financial KPIs including operating margin, ROIC, and efficiency ratios.",
      "columns": [
        {
          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('MLK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.cost_center_id) + 30000 AS STRING), 6, '0'))"
        },
        {
          "name": "kpi_month",
          "sql_type": "DATE",
          "comment": "First day of KPI month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "cost_center_id",
          "sql_type": "STRING",
          "comment": "Cost center identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "division",
          "sql_type": "STRING",
          "comment": "Division",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "operating_margin_pct",
          "sql_type": "DOUBLE",
          "comment": "Operating margin percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-10.0, 5.0 + ({qty_noise} * {seasonal_mult}) * 30.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "roic_pct",
          "sql_type": "DOUBLE",
          "comment": "Return on invested capital",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-5.0, 3.0 + ({qty_noise} * {seasonal_mult}) * 17.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "cost_per_unit",
          "sql_type": "DOUBLE",
          "comment": "Operating cost per unit of output",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(2.0, 5.0 + {qty_noise} * 20.0), 2)"
        },
        {
          "name": "headcount",
          "sql_type": "INT",
          "comment": "Full-time equivalent headcount",
          "is_dimension": false,
          "generation_expr": "CAST(30 + FLOOR({qty_noise} * 270) AS INT)"
        }
      ],
