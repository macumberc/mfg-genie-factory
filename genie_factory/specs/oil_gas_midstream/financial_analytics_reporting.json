          "comment": "Cost center name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "division",
          "sql_type": "STRING",
          "comment": "Division: Transportation, Processing, Storage, Maintenance, Commercial, Corporate",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
