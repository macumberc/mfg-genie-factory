  "example_sqls": [
    {
      "question": "How has total transaction amount trended over time?",
      "sql_lines": [
        "SELECT transaction_date, MEASURE(total_amount_usd) AS total_amount_usd",
        "FROM {fqn}.financial_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY transaction_date"
      ]
    },
    {
      "question": "How has total budget trended over time?",
      "sql_lines": [
        "SELECT transaction_date, MEASURE(total_budget_usd) AS total_budget_usd",
        "FROM {fqn}.financial_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY transaction_date"
      ]
    },
    {
      "question": "How has total planned revenue trended over time?",
      "sql_lines": [
