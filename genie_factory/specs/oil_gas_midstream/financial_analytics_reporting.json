        "GROUP BY ALL",
        "ORDER BY snapshot_month"
      ]
    },
    {
      "question": "How has total transaction amount trended over time?",
      "sql_lines": [
        "SELECT transaction_date, SUM(amount_usd) AS total_amount_usd",
        "FROM {fqn}.financial_transactions",
        "GROUP BY transaction_date",
        "ORDER BY transaction_date"
      ]
    },
    {
      "question": "How has total planned monthly revenue trended over time?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', snapshot_month) AS month, SUM(planned_revenue_usd) AS total_planned_revenue_usd",
