  "benchmarks": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', transaction_date) AS month, COUNT(DISTINCT transaction_id) AS distinct_transactions",
        "FROM {fqn}.procurement_transactions",
        "WHERE transaction_date IS NOT NULL AND transaction_id IS NOT NULL",
        "GROUP BY month",
        "ORDER BY month"
      ]
    },
