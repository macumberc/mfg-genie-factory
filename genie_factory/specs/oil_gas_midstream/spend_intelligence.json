          "sql_type": "STRING",
          "comment": "Transaction ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('PT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.supplier_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "transaction_date",
          "sql_type": "DATE",
          "comment": "Transaction date",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
