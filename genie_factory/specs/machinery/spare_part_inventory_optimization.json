  "benchmarks": [
    {
      "question": "What is the monthly trend in total issued qty count?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', txn_date) AS month, MEASURE(total_issued_qty) AS total_issued_qty",
        "FROM {fqn}.parts_transactions_metrics",
        "GROUP BY ALL",
        "ORDER BY month"
      ]
    },
    {
      "question": "How has total received qty count changed over time?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', txn_date) AS month, MEASURE(total_received_qty) AS total_received_qty",
        "FROM {fqn}.parts_transactions_metrics",
        "WHERE txn_date IS NOT NULL",
        "GROUP BY ALL",
        "ORDER BY month"
      ]
    },
    {
      "question": "How has average inventory turnover ratio trended by month?",
      "sql_lines": [
        "SELECT kpi_month, MEASURE(avg_turnover) AS avg_turnover",
        "FROM {fqn}.inventory_kpi_metrics",
        "GROUP BY ALL",
        "ORDER BY kpi_month"
      ]
    },
    {
      "question": "How has total stockout events changed over time?",
      "sql_lines": [
        "SELECT kpi_month, MEASURE(total_stockouts) AS total_stockouts",
        "FROM {fqn}.inventory_kpi_metrics",
        "GROUP BY ALL",
        "ORDER BY kpi_month"
      ]
    },
    {
      "question": "What are the top spare part number by total transaction quantity?",
      "sql_lines": [
        "WITH ranked_parts AS ( SELECT part_number, SUM(quantity) AS total_quantity, RANK() OVER (ORDER BY SUM(quantity) DESC) AS quantity_rank",
        "FROM {fqn}.parts_transactions",
        "WHERE part_number IS NOT NULL",
        "GROUP BY part_number ) SELECT part_number, total_quantity",
        "FROM ranked_parts",
        "WHERE quantity_rank <= 10",
        "ORDER BY quantity_rank"
      ]
    },
    {
      "question": "Which spare part numbers have the highest total quantity on hand?",
      "sql_lines": [
        "WITH ranked_parts AS ( SELECT part_number, SUM(on_hand_qty) AS total_on_hand_qty, RANK() OVER (ORDER BY SUM(on_hand_qty) DESC) AS rank",
        "FROM {fqn}.inventory_snapshots",
        "WHERE part_number IS NOT NULL AND on_hand_qty IS NOT NULL",
        "GROUP BY part_number ) SELECT part_number, total_on_hand_qty",
        "FROM ranked_parts",
        "WHERE rank = 1"
      ]
    },
    {
      "question": "Which spare part numbers have the highest average inventory turnover ratio?",
      "sql_lines": [
        "SELECT part_number, AVG(turnover_ratio) AS avg_turnover_ratio, RANK() OVER (ORDER BY AVG(turnover_ratio) DESC) AS turnover_rank",
        "FROM {fqn}.inventory_kpi_monthly",
        "WHERE part_number IS NOT NULL AND turnover_ratio IS NOT NULL",
        "GROUP BY part_number",
        "ORDER BY avg_turnover_ratio DESC"
      ]
    }
  ],
