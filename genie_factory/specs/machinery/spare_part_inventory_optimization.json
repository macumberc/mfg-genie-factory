      "columns": [
        {
          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI record ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('IK-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "kpi_month",
