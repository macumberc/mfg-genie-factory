          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "turnover_ratio",
          "sql_type": "DOUBLE",
          "comment": "Inventory turnover ratio",
          "is_dimension": false,
          "generation_expr": "ROUND(0.5 + (({qty_noise} * {seasonal_mult}) * 11.5), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "fill_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "Order fill rate percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(80.0 + (({qty_noise} * {seasonal_mult}) * 19.5), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "stockout_events",
          "sql_type": "INT",
          "comment": "Number of stockout events",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 5) AS INT)"
        },
        {
          "name": "carrying_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Monthly carrying cost in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(200.0 + ({qty_noise} * 4800.0), 2)"
        },
        {
          "name": "emergency_orders",
          "sql_type": "INT",
          "comment": "Emergency orders placed",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 4) AS INT)"
        },
        {
          "name": "avg_lead_time_days",
          "sql_type": "DOUBLE",
          "comment": "Average supplier lead time in days",
          "is_dimension": false,
          "generation_expr": "ROUND(3.0 + ({qty_noise} * 27.0), 1)"
        }
