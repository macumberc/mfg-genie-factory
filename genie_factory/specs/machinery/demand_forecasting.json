        },
        {
          "name": "order_status",
          "sql_type": "STRING",
          "comment": "Status: Confirmed, Shipped, Backlog, Cancelled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.04 THEN 'Cancelled' WHEN {alt_status_noise} < 0.20 THEN 'Backlog' WHEN {alt_status_noise} < 0.35 THEN 'Confirmed' ELSE 'Shipped' END"
        },
