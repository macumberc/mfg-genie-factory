  "benchmarks": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', order_date) AS order_month, COUNT(DISTINCT order_id) AS distinct_transactions",
        "FROM {fqn}.customer_orders",
        "WHERE order_date IS NOT NULL",
        "GROUP BY order_month",
        "ORDER BY order_month"
      ]
    },
    {
      "question": "How has highest order quantity changed over time?",
      "sql_lines": [
        "SELECT order_date, MEASURE(max_order_quantity) AS max_order_quantity",
        "FROM {fqn}.customer_orders_metrics",
        "GROUP BY ALL",
        "ORDER BY order_date"
      ]
    },
    {
      "question": "What has been the peak forecast_accuracy_percent each month?",
      "sql_lines": [
        "SELECT kpi_month, MEASURE(max_forecast_accuracy_percent) AS max_forecast_accuracy_percent",
        "FROM {fqn}.demand_kpi_metrics",
        "GROUP BY ALL",
        "ORDER BY kpi_month"
      ]
    },
    {
      "question": "How has total backlog units changed over time?",
      "sql_lines": [
        "SELECT kpi_month, MEASURE(total_backlog) AS total_backlog",
        "FROM {fqn}.demand_kpi_metrics",
        "GROUP BY ALL",
        "ORDER BY kpi_month"
      ]
    },
    {
      "question": "What are the top equipment model ordered by total units ordered?",
      "sql_lines": [
        "WITH ranked_models AS ( SELECT equipment_model, SUM(order_quantity) AS total_units_ordered, RANK() OVER (ORDER BY SUM(order_quantity) DESC) AS model_rank",
        "FROM {fqn}.customer_orders",
        "WHERE equipment_model IS NOT NULL",
        "GROUP BY equipment_model ) SELECT equipment_model, total_units_ordered",
        "FROM ranked_models",
        "WHERE model_rank <= 10",
        "ORDER BY model_rank"
      ]
    },
    {
      "question": "What is the average mean absolute percentage error by product family?",
      "sql_lines": [
        "SELECT product_family, AVG(mape_pct) AS avg_mape_pct",
        "FROM {fqn}.demand_forecasts",
        "GROUP BY product_family ORDER BY avg_mape_pct DESC"
      ]
    },
    {
      "question": "Which equipment models have the highest average forecast accuracy?",
      "sql_lines": [
        "WITH ranked_models AS ( SELECT equipment_model, AVG(forecast_accuracy_pct) AS avg_forecast_accuracy_pct, RANK() OVER (ORDER BY AVG(forecast_accuracy_pct) DESC) AS rank",
        "FROM {fqn}.demand_kpi_monthly",
        "WHERE equipment_model IS NOT NULL AND forecast_accuracy_pct IS NOT NULL",
        "GROUP BY equipment_model ) SELECT equipment_model, avg_forecast_accuracy_pct",
        "FROM ranked_models",
        "WHERE rank <= 10",
        "ORDER BY avg_forecast_accuracy_pct DESC"
      ]
    }
  ]
