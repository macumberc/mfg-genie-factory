          "name": "invoice_amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Invoice amount in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500.0 + ({qty_noise} * 99500.0) * (0.95 + {status_noise} * 0.10), 2)"
        },
        {
          "name": "payment_terms_days",
          "sql_type": "INT",
          "comment": "Payment terms in days",
          "is_dimension": false,
          "generation_expr": "CAST(CASE WHEN {status_noise} < 0.30 THEN 30 WHEN {status_noise} < 0.60 THEN 45 WHEN {status_noise} < 0.85 THEN 60 ELSE 90 END AS INT)"
        },
        {
          "name": "delivery_status",
          "sql_type": "STRING",
          "comment": "Delivery: On Time, Late, Early",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.70 THEN 'On Time' WHEN {alt_status_noise} < 0.90 THEN 'Late' ELSE 'Early' END"
        },
        {
          "name": "quality_accepted",
          "sql_type": "BOOLEAN",
          "comment": "Whether goods passed quality inspection",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.92 THEN true ELSE false END"
        },
        {
          "name": "maverick_spend",
          "sql_type": "BOOLEAN",
          "comment": "Whether this was off-contract/maverick spend",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.85 THEN false ELSE true END"
        }
