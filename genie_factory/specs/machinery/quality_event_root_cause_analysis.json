{
  "company_name": "QualityFirst Manufacturing",
  "industry": "Machinery",
  "use_case": "Quality event root cause analysis and corrective action tracking",
  "space_title": "QualityFirst Manufacturing - Quality RCA 🔍",
  "space_description": "**Subindustry:** Machinery\n\n**Use case:** Quality Event Root Cause Analysis & CAPA Tracking\n\nQualityFirst Manufacturing — enterprise quality analytics covering defects, CAPA workflow, and supplier/process root causes across product lines and categories. Quality Engineers and CAPA owners drive root-cause investigations day-to-day; the VP Quality and CFO use it to track Cost of Poor Quality, customer complaints, and audit-finding closure against compliance targets.\n\n**Key KPIs**\n- Defect PPM (parts per million) — Six Sigma target 3.4 PPM, world-class <100 PPM\n- Cost of Poor Quality ($) — typical 5–10% of revenue, leaders <2%\n- First-pass yield (%) — world-class ≥99%\n- CAPA closure rate (%) — target ≥90% within SLA\n- Open critical quality events — escalation indicator\n- Customer complaints (count) — voice-of-customer KPI\n- Audit findings (count) — regulatory and ISO 9001 health\n- Units affected per event — severity and recall-risk indicator\n\n**Data sources**\n- `quality_events` — defect events with type, root cause, severity, units affected, CAPA status\n- `inspection_records` — inspection/audit records with pass/fail result, units inspected/rejected, findings\n- `quality_kpi_monthly` — monthly PPM, COPQ, CAPA closure rate, first-pass yield, complaints, audit findings",
  "schema_basename": "mach_quality_rca",
  "tables": [
    {
      "table_name": "quality_events",
      "description": "Individual quality event records with defect type, root cause, and impact assessment.",
      "columns": [
        {
          "name": "event_id",
          "sql_type": "STRING",
          "comment": "Unique quality event identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('QE-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "event_date",
          "sql_type": "DATE",
          "comment": "Date of quality event",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "product_line",
          "sql_type": "STRING",
          "comment": "Product line identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "defect_type",
          "sql_type": "STRING",
          "comment": "Defect classification",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.20 THEN 'Dimensional' WHEN {status_noise} < 0.38 THEN 'Surface Finish' WHEN {status_noise} < 0.54 THEN 'Material' WHEN {status_noise} < 0.68 THEN 'Assembly' WHEN {status_noise} < 0.80 THEN 'Weld' WHEN {status_noise} < 0.90 THEN 'Coating' ELSE 'Functional' END"
        },
        {
          "name": "root_cause",
          "sql_type": "STRING",
          "comment": "Root cause category",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.18 THEN 'Operator Error' WHEN {alt_status_noise} < 0.35 THEN 'Machine Drift' WHEN {alt_status_noise} < 0.50 THEN 'Material Defect' WHEN {alt_status_noise} < 0.64 THEN 'Process Parameter' WHEN {alt_status_noise} < 0.76 THEN 'Tooling Wear' WHEN {alt_status_noise} < 0.88 THEN 'Design Issue' ELSE 'Environmental' END"
        },
        {
          "name": "severity",
          "sql_type": "STRING",
          "comment": "Severity: Minor, Major, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.50 THEN 'Minor' WHEN {alt_status_noise2} < 0.82 THEN 'Major' ELSE 'Critical' END"
        },
        {
          "name": "units_affected",
          "sql_type": "INT",
          "comment": "Number of units affected",
          "is_dimension": false,
          "generation_expr": "CAST(1 + FLOOR({qty_noise} * 499) AS INT)"
        },
        {
          "name": "cost_impact_usd",
          "sql_type": "DOUBLE",
          "comment": "Total cost impact in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500.0 + ({qty_noise} * 49500.0), 2)"
        },
        {
          "name": "capa_status",
          "sql_type": "STRING",
          "comment": "CAPA status: Open, In Progress, Closed, Verified",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.15 THEN 'Open' WHEN {alt_status_noise3} < 0.40 THEN 'In Progress' WHEN {alt_status_noise3} < 0.75 THEN 'Closed' ELSE 'Verified' END"
        }
      ],
