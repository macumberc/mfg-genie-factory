          "name": "inspection_type",
          "sql_type": "STRING",
          "comment": "Inspection type: In-Process, Final, Incoming, Audit",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'In-Process' WHEN {status_noise} < 0.65 THEN 'Final' WHEN {status_noise} < 0.85 THEN 'Incoming' ELSE 'Audit' END"
        },
        {
          "name": "result",
          "sql_type": "STRING",
          "comment": "Result: Pass, Fail, Conditional",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.78 THEN 'Pass' WHEN {alt_status_noise} < 0.92 THEN 'Fail' ELSE 'Conditional' END"
        },
