    {
      "question": "Which product line identifiers have the highest total number of units affected?",
      "sql_lines": [
        "SELECT product_line, SUM(units_affected) AS total_units_affected",
        "FROM {fqn}.quality_events",
        "GROUP BY product_line",
        "ORDER BY total_units_affected DESC",
        "LIMIT 10"
