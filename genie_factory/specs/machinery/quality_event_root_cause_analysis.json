    {
      "table_name": "quality_kpi_monthly",
      "description": "Monthly quality KPIs including COPQ, PPM rates, and CAPA closure rates.",
      "columns": [
        {
          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('QK-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "kpi_month",
          "sql_type": "DATE",
          "comment": "Month of KPI record",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', dt)"
        },
        {
          "name": "product_line",
          "sql_type": "STRING",
          "comment": "Product line identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "defect_ppm",
          "sql_type": "DOUBLE",
          "comment": "Defect rate in parts per million",
          "is_dimension": false,
          "generation_expr": "ROUND(100.0 + (({qty_noise} * {seasonal_mult}) * 2900.0), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "copq_usd",
          "sql_type": "DOUBLE",
          "comment": "Cost of poor quality in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(5000.0 + ({qty_noise} * 95000.0), 2)"
        },
        {
          "name": "capa_closure_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "CAPA closure rate percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(50.0 + (({qty_noise} * {seasonal_mult}) * 48.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "first_pass_yield_pct",
          "sql_type": "DOUBLE",
          "comment": "First-pass yield percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(88.0 + (({qty_noise} * {seasonal_mult}) * 11.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "customer_complaints",
          "sql_type": "INT",
          "comment": "Customer complaints received",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 12) AS INT)"
        },
        {
          "name": "audit_findings",
          "sql_type": "INT",
          "comment": "Audit findings in the month",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 8) AS INT)"
        }
