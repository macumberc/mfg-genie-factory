  "metric_views": [
    {
      "view_name": "cash_flow_txn_metrics",
      "source_table": "cash_flow_transactions",
      "dimensions": [
        {
          "name": "txn_date",
          "expr": "txn_date"
        },
        {
          "name": "business_unit_type",
          "expr": "business_unit_type"
        },
        {
          "name": "txn_type",
          "expr": "txn_type"
        },
        {
          "name": "direction",
          "expr": "direction"
        }
      ],
      "measures": [
        {
          "name": "total_inflow",
          "expr": "SUM(CASE WHEN direction = 'Inflow' THEN amount_usd ELSE 0 END)",
          "comment": "Total cash inflows"
        },
        {
          "name": "total_outflow",
          "expr": "SUM(CASE WHEN direction = 'Outflow' THEN amount_usd ELSE 0 END)",
          "comment": "Total cash outflows"
        },
        {
          "name": "total_transactions",
          "expr": "COUNT(DISTINCT txn_id)",
          "comment": "Total transactions"
        },
        {
          "name": "avg_days_outstanding",
          "expr": "AVG(days_outstanding)",
          "comment": "Average days outstanding"
        },
        {
          "name": "unique_business_unit_count",
          "expr": "COUNT(DISTINCT business_unit_id)",
          "comment": "Number of distinct business units"
        },
        {
          "name": "max_amount",
          "expr": "MAX(amount_usd)",
          "comment": "Maximum amount usd"
        },
        {
          "name": "total_payment_terms_days",
          "expr": "SUM(payment_terms_days)",
          "comment": "Total payment terms days"
        }
      ]
    },
    {
      "view_name": "cash_flow_kpi_metrics",
      "source_table": "cash_flow_monthly",
      "dimensions": [
        {
          "name": "kpi_month",
          "expr": "kpi_month"
        },
        {
          "name": "business_unit_type",
          "expr": "business_unit_type"
        }
      ],
      "measures": [
        {
          "name": "total_net_cash_flow",
          "expr": "SUM(net_cash_flow_usd)",
          "comment": "Total net cash flow"
        },
        {
          "name": "total_operating_cf",
          "expr": "SUM(operating_cash_flow_usd)",
          "comment": "Total operating cash flow"
        },
        {
          "name": "avg_collection_rate",
          "expr": "AVG(collection_rate_pct)",
          "comment": "Average AR collection rate"
        },
        {
          "name": "total_working_capital",
          "expr": "SUM(working_capital_usd)",
          "comment": "Total net working capital"
        },
        {
          "name": "total_free_cash_flow",
          "expr": "SUM(free_cash_flow_usd)",
          "comment": "Total free cash flow usd"
        },
        {
          "name": "total_forecast_variance_percent",
          "expr": "SUM(forecast_variance_pct)",
          "comment": "Total forecast variance pct"
        },
        {
          "name": "unique_business_unit_count",
          "expr": "COUNT(DISTINCT business_unit_id)",
          "comment": "Number of distinct business units"
        },
        {
          "name": "max_net_cash_flow",
          "expr": "MAX(net_cash_flow_usd)",
          "comment": "Maximum net cash flow usd"
        }
      ]
