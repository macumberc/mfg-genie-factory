          "name": "net_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Net cash flow for the month",
          "is_dimension": false,
          "generation_expr": "ROUND(-100000.0 + ({qty_noise} * 400000.0), 2)"
        },
        {
          "name": "operating_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Operating cash flow",
          "is_dimension": false,
          "generation_expr": "ROUND(50000.0 + ({qty_noise} * 450000.0), 2)"
        },
        {
          "name": "free_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Free cash flow",
          "is_dimension": false,
          "generation_expr": "ROUND(-50000.0 + ({qty_noise} * 350000.0), 2)"
        },
        {
          "name": "working_capital_usd",
          "sql_type": "DOUBLE",
          "comment": "Net working capital",
          "is_dimension": false,
          "generation_expr": "ROUND(100000.0 + ({qty_noise} * 900000.0), 2)"
        },
        {
          "name": "collection_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "AR collection rate percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(75.0 + (({qty_noise} * {seasonal_mult}) * 24.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "forecast_variance_pct",
          "sql_type": "DOUBLE",
          "comment": "Cash flow forecast vs actual variance",
          "is_dimension": false,
          "generation_expr": "ROUND(-10.0 + (({qty_noise} * {seasonal_mult}) * 20.0), 2)",
          "seasonal_amplitude": 0.15
        }
      ],
