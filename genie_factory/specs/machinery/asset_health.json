  "metric_views": [
    {
      "view_name": "condition_readings_metrics",
      "source_table": "condition_readings",
      "dimensions": [
        {
          "name": "reading_date",
          "expr": "reading_date"
        },
        {
          "name": "asset_type",
          "expr": "asset_type"
        },
        {
          "name": "manufacturer",
          "expr": "manufacturer"
        }
      ],
      "measures": [
        {
          "name": "avg_vibration_velocity",
          "expr": "AVG(vibration_velocity_mm_s)",
          "comment": "Average vibration velocity in mm/s"
        },
        {
          "name": "avg_bearing_temp",
          "expr": "AVG(bearing_temperature_c)",
          "comment": "Average bearing temperature in Celsius"
        },
        {
          "name": "avg_health_index",
          "expr": "AVG(health_index)",
          "comment": "Average computed health index 0-100"
