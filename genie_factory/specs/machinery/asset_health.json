          "name": "reading_id",
          "sql_type": "STRING",
          "comment": "Unique condition reading identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('CR-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "reading_date",
          "sql_type": "DATE",
          "comment": "Date of condition reading",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "asset_id",
          "sql_type": "STRING",
          "comment": "Industrial asset identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "asset_type",
