  "benchmarks": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', reading_date) AS reading_month, COUNT(DISTINCT reading_id) AS distinct_transactions",
        "FROM {fqn}.condition_readings",
        "GROUP BY reading_month",
        "ORDER BY reading_month"
      ]
    },
    {
      "question": "How has highest vibration velocity mm s changed over time?",
      "sql_lines": [
        "SELECT reading_date, MEASURE(max_vibration_velocity_mm_s) AS max_vibration_velocity_mm_s",
        "FROM {fqn}.condition_readings_metrics",
        "GROUP BY ALL",
        "ORDER BY reading_date"
      ]
    },
    {
      "question": "How has highest average health index changed over time?",
      "sql_lines": [
        "SELECT summary_month, MEASURE(max_avg_health_index) AS max_avg_health_index",
        "FROM {fqn}.asset_health_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY summary_month"
      ]
    },
    {
      "question": "How has total maintenance cost trended over time?",
      "sql_lines": [
        "SELECT summary_month, MEASURE(total_maintenance_cost) AS total_maintenance_cost",
        "FROM {fqn}.asset_health_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY summary_month"
      ]
    },
    {
      "question": "Which type of industrial assets have the highest average bearing temperature in celsius?",
      "sql_lines": [
        "WITH avg_temp_by_type AS (SELECT asset_type, MEASURE(avg_bearing_temp) AS avg_bearing_temp",
        "FROM {fqn}.condition_readings_metrics",
        "WHERE asset_type IS NOT NULL",
        "GROUP BY ALL) SELECT asset_type, avg_bearing_temp",
        "FROM (SELECT asset_type, avg_bearing_temp, RANK() OVER (ORDER BY avg_bearing_temp DESC) AS rank",
        "FROM avg_temp_by_type)",
        "WHERE rank = 1"
      ]
    },
    {
      "question": "Which type of industrial assets have the highest average downtime caused by failure in hours?",
      "sql_lines": [
        "SELECT asset_type, AVG(downtime_hours) AS avg_metric",
        "FROM {fqn}.failure_events",
        "GROUP BY 1",
        "ORDER BY avg_metric DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which type of industrial assets have the highest average asset availability percentage?",
      "sql_lines": [
        "WITH asset_type_availability AS (SELECT asset_type, MEASURE(avg_availability) AS avg_availability",
        "FROM {fqn}.asset_health_monthly_metrics",
        "WHERE asset_type IS NOT NULL",
        "GROUP BY ALL), ranked_types AS (SELECT asset_type, avg_availability, RANK() OVER (ORDER BY avg_availability DESC) AS rk",
        "FROM asset_type_availability) SELECT asset_type, avg_availability",
        "FROM ranked_types",
        "WHERE rk = 1"
      ]
    }
  ]
