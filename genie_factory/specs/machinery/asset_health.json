          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "vibration_velocity_mm_s",
          "sql_type": "DOUBLE",
          "comment": "Vibration velocity in mm/s (ISO 10816 scale)",
          "is_dimension": false,
          "generation_expr": "ROUND(0.5 + (({qty_noise} * {seasonal_mult}) * 19.5), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "bearing_temperature_c",
          "sql_type": "DOUBLE",
          "comment": "Bearing temperature in Celsius",
          "is_dimension": false,
          "generation_expr": "ROUND(40.0 + ({qty_noise} * 60.0), 1)"
        },
        {
          "name": "oil_temperature_c",
          "sql_type": "DOUBLE",
          "comment": "Lubricant oil temperature in Celsius",
          "is_dimension": false,
          "generation_expr": "ROUND(35.0 + ({qty_noise} * 45.0), 1)"
        },
        {
          "name": "health_index",
          "sql_type": "DOUBLE",
          "comment": "Computed health index 0-100 (100 = perfect health)",
          "is_dimension": false,
          "generation_expr": "ROUND(30.0 + (({qty_noise} * {seasonal_mult}) * 70.0), 1)",
