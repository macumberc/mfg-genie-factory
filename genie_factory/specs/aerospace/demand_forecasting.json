          "sql_type": "STRING",
          "comment": "Unique order identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('AO-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.part_number) + 10000 AS STRING), 7, '0'))"
        },
        {
          "name": "order_date",
          "sql_type": "DATE",
          "comment": "Date order was placed",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "part_number",
