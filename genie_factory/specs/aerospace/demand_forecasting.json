    {
      "table_name": "demand_forecasts",
      "description": "Monthly demand forecasts vs actuals per part and customer segment with model accuracy tracking.",
      "columns": [
        {
          "name": "forecast_id",
          "sql_type": "STRING",
          "comment": "Unique forecast record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('DF-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.part_number) AS STRING), 7, '0'))"
        },
        {
          "name": "forecast_month",
          "sql_type": "DATE",
          "comment": "Forecast month (first day)",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "part_number",
          "sql_type": "STRING",
          "comment": "Part number",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "part_category",
          "sql_type": "STRING",
          "comment": "Part category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "customer_segment",
          "sql_type": "STRING",
          "comment": "Customer segment",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'Airline' WHEN {status_noise} < 0.55 THEN 'MRO' WHEN {status_noise} < 0.70 THEN 'Military' WHEN {status_noise} < 0.85 THEN 'OEM' ELSE 'Leasing' END"
        },
        {
          "name": "forecasted_units",
          "sql_type": "INT",
          "comment": "Forecasted demand units",
          "is_dimension": false,
          "generation_expr": "CAST(5 + FLOOR({qty_noise} * 95) AS INT)"
        },
        {
          "name": "actual_units",
          "sql_type": "INT",
          "comment": "Actual units ordered",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(1, (5 + FLOOR({qty_noise} * 95)) * (0.75 + {status_noise} * 0.50)) AS INT)"
        },
        {
          "name": "forecast_error_pct",
          "sql_type": "DOUBLE",
          "comment": "Absolute forecast error percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(ABS((({qty_noise} * {seasonal_mult}) * 0.40) - 0.10) * 100.0, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "model_version",
          "sql_type": "STRING",
          "comment": "Forecast model version",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.25 THEN 'v4.0' WHEN {alt_status_noise} < 0.55 THEN 'v4.1' ELSE 'v4.2' END"
        }
      ],
