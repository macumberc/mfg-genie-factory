    {
      "table_name": "demand_kpi_monthly",
      "description": "Monthly demand KPIs including fill rate, backlog value, average lead time, and inventory turns.",
      "columns": [
        {
          "name": "record_id",
          "sql_type": "STRING",
          "comment": "Unique monthly KPI record",
          "is_dimension": false,
          "generation_expr": "CONCAT('DK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.part_number) AS STRING), 7, '0'))"
        },
        {
          "name": "report_month",
          "sql_type": "DATE",
          "comment": "First day of report month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "part_number",
          "sql_type": "STRING",
          "comment": "Part number",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "part_category",
          "sql_type": "STRING",
          "comment": "Part category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "fill_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "Order fill rate percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.5, 75.0 + (({qty_noise} * {seasonal_mult}) * 24.0)), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "backlog_value_usd",
          "sql_type": "DOUBLE",
          "comment": "Open backlog value in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(10000.0 + ({qty_noise} * 490000.0), 2)"
        },
        {
          "name": "avg_lead_time_days",
          "sql_type": "DOUBLE",
          "comment": "Average actual lead time in days",
          "is_dimension": false,
          "generation_expr": "ROUND(10.0 + ({qty_noise} * 110.0), 1)"
        },
        {
          "name": "inventory_turns",
          "sql_type": "DOUBLE",
          "comment": "Inventory turns per year",
          "is_dimension": false,
          "generation_expr": "ROUND(1.0 + ({qty_noise} * 11.0), 2)"
        },
        {
          "name": "on_time_delivery_pct",
          "sql_type": "DOUBLE",
          "comment": "On-time delivery percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.0, 70.0 + (({qty_noise} * {seasonal_mult}) * 28.0)), 2)",
          "seasonal_amplitude": 0.15
        }
      ],
