  "example_sqls": [
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', order_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.aftermarket_orders",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "How has highest order quantity changed over time?",
      "sql_lines": [
        "SELECT order_date, MEASURE(max_order_quantity) AS max_order_quantity",
        "FROM {fqn}.order_metrics",
        "GROUP BY ALL",
        "ORDER BY order_date"
      ]
    },
    {
      "question": "What has been the peak forecasted demand units each month?",
      "sql_lines": [
        "SELECT forecast_month, MEASURE(max_forecasted_units) AS max_forecasted_units",
        "FROM {fqn}.forecast_metrics",
        "GROUP BY ALL",
        "ORDER BY forecast_month"
      ]
    },
    {
      "question": "Which part have the highest total *?",
      "sql_lines": [
        "SELECT part_name, SUM(*) AS record_count, SUM(order_quantity) AS total_order_quantity",
        "FROM {fqn}.aftermarket_orders",
        "WHERE order_status = 'Backlog'",
        "GROUP BY part_name",
        "ORDER BY total_order_quantity DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "What is the trend of total forecasted demand units over time?",
      "sql_lines": [
        "SELECT forecast_month, SUM(forecasted_units) AS total_forecasted_units",
        "FROM {fqn}.demand_forecasts",
        "GROUP BY forecast_month ORDER BY forecast_month"
      ]
    },
    {
      "question": "How has the average order fill rate percentage changed over time?",
      "sql_lines": [
        "SELECT report_month, AVG(fill_rate_pct) AS avg_fill_rate_pct",
        "FROM {fqn}.demand_kpi_monthly",
        "GROUP BY report_month ORDER BY report_month"
      ]
    },
    {
      "question": "How has average quoted lead time changed over time?",
      "sql_lines": [
        "SELECT order_date, MEASURE(avg_lead_time_days) AS avg_lead_time_days",
        "FROM {fqn}.order_metrics",
        "GROUP BY ALL",
        "ORDER BY order_date"
      ]
    }
  ],
