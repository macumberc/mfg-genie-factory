        {
          "name": "customer_segment",
          "sql_type": "STRING",
          "comment": "Customer segment: Airline, MRO, Military, OEM, Leasing",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'Airline' WHEN {status_noise} < 0.55 THEN 'MRO' WHEN {status_noise} < 0.70 THEN 'Military' WHEN {status_noise} < 0.85 THEN 'OEM' ELSE 'Leasing' END"
        },
        {
          "name": "order_quantity",
          "sql_type": "INT",
          "comment": "Units ordered",
          "is_dimension": false,
          "generation_expr": "CAST(1 + FLOOR({qty_noise} * 99) AS INT)"
        },
        {
          "name": "unit_price_usd",
          "sql_type": "DOUBLE",
          "comment": "Price per unit USD",
          "is_dimension": false,
          "generation_expr": ""
        },
        {
          "name": "lead_time_days",
          "sql_type": "INT",
          "comment": "Quoted lead time in days",
          "is_dimension": false,
          "generation_expr": "CAST(5 + FLOOR({qty_noise} * 175) AS INT)"
