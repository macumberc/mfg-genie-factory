    {
      "table_name": "cashflow_monthly",
      "description": "Monthly cash flow KPIs including operating cash flow, free cash flow, and working capital ratio by program.",
      "columns": [
        {
          "name": "record_id",
          "sql_type": "STRING",
          "comment": "Unique monthly record",
          "is_dimension": false,
          "generation_expr": "CONCAT('CF-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.program_id) AS STRING), 7, '0'))"
        },
        {
          "name": "report_month",
          "sql_type": "DATE",
          "comment": "First day of report month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "program_id",
          "sql_type": "STRING",
          "comment": "Aerospace program identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "program_type",
          "sql_type": "STRING",
          "comment": "Program type",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "operating_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Operating cash flow in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(-2000000.0 + ({qty_noise} * 12000000.0), 2)"
        },
        {
          "name": "free_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Free cash flow in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(-3000000.0 + ({qty_noise} * 13000000.0), 2)"
        },
        {
          "name": "working_capital_ratio",
          "sql_type": "DOUBLE",
          "comment": "Current ratio (current assets / current liabilities)",
          "is_dimension": false,
          "generation_expr": "ROUND(0.8 + (({qty_noise} * {seasonal_mult}) * 1.7), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "capex_usd",
          "sql_type": "DOUBLE",
          "comment": "Capital expenditure in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(100000.0 + ({qty_noise} * 2900000.0), 2)"
        },
        {
          "name": "overdue_receivables_pct",
          "sql_type": "DOUBLE",
          "comment": "Percentage of receivables overdue",
          "is_dimension": false,
          "generation_expr": "ROUND(2.0 + (({qty_noise} * {seasonal_mult}) * 18.0), 2)",
          "seasonal_amplitude": 0.15
        }
      ],
