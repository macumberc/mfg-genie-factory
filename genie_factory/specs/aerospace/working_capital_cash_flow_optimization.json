        {
          "name": "accounts_receivable_usd",
          "sql_type": "DOUBLE",
          "comment": "Accounts receivable balance in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500000.0 + ({qty_noise} * 9500000.0), 2)"
        },
        {
          "name": "accounts_payable_usd",
          "sql_type": "DOUBLE",
          "comment": "Accounts payable balance in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(300000.0 + ({qty_noise} * 7700000.0), 2)"
        },
        {
          "name": "wip_inventory_usd",
          "sql_type": "DOUBLE",
          "comment": "Work-in-progress inventory value in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(200000.0 + ({qty_noise} * 4800000.0), 2)"
