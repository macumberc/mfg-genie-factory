{
  "company_name": "AeroCapital Finance",
  "industry": "Aerospace",
  "use_case": "Aerospace working capital and cash flow optimization",
  "space_title": "AeroCapital Finance - Working Capital & Cash Flow \ud83d\udcb0",
  "space_description": "**Subindustry:** Aerospace\n\n**Use case:** Working Capital & Cash Flow Optimization\n\nAeroCapital Finance \u2014 working-capital and cash-flow analytics across 20 aerospace programs spanning 5 program types (Production, Military, Aftermarket, Development, Space). Program Finance Leads use this space to manage receivables / WIP and unblock cash; the CFO uses it to monitor DSO, DPO, cash conversion cycle, and free cash flow against the operating plan; Treasury uses it to forecast liquidity and counterparty exposure.\n\n**Key KPIs**\n- Days Sales Outstanding (DSO) \u2014 A&D benchmark 60-90 days (long contract cycles)\n- Days Payable Outstanding (DPO) \u2014 typical 45-60 days\n- Cash Conversion Cycle (CCC) \u2014 best-in-class A&D <90 days, average 120-150 days\n- Free Cash Flow (USD) by program\n- Operating Cash Flow (USD) \u2014 top CFO scorecard metric\n- WIP inventory (USD) \u2014 major working-capital lever in long-cycle programs\n- Overdue receivables % (target <5%)\n- Working capital ratio (current assets / current liabilities; target 1.5-2.0)\n\n**Data sources**\n- `cash_transactions` \u2014 daily cash in/out by program with counterparty and payment terms\n- `working_capital_snapshots` \u2014 weekly AR / AP / WIP / DSO / DPO / CCC per program\n- `cashflow_monthly` \u2014 monthly OCF, FCF, capex, working capital ratio, overdue receivables %",
  "schema_basename": "aerospace_working_capital",
  "tables": [
    {
      "table_name": "cash_transactions",
      "description": "Daily cash transaction records including collections, disbursements, milestone payments, and program-level cash flows.",
      "columns": [
        {
          "name": "txn_id",
          "sql_type": "STRING",
          "comment": "Unique transaction identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('CT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.program_id) + 10000 AS STRING), 7, '0'))"
        },
        {
          "name": "txn_date",
          "sql_type": "DATE",
          "comment": "Transaction date",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "program_id",
          "sql_type": "STRING",
          "comment": "Aerospace program identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "program_name",
          "sql_type": "STRING",
          "comment": "Program name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "program_type",
          "sql_type": "STRING",
          "comment": "Program type: Production, Development, Aftermarket, Military, Space",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "txn_type",
          "sql_type": "STRING",
          "comment": "Transaction type: Collection, Disbursement, Milestone Payment, Progress Payment, Advance",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'Collection' WHEN {status_noise} < 0.55 THEN 'Disbursement' WHEN {status_noise} < 0.72 THEN 'Milestone Payment' WHEN {status_noise} < 0.88 THEN 'Progress Payment' ELSE 'Advance' END"
        },
        {
          "name": "amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Transaction amount in USD (positive = inflow, negative = outflow)",
          "is_dimension": false,
          "generation_expr": "ROUND((CASE WHEN {alt_status_noise} < 0.30 THEN 1.0 WHEN {alt_status_noise} < 0.55 THEN -1.0 ELSE 1.0 END) * (50000.0 + ({qty_noise} * 4950000.0)), 2)"
        },
        {
          "name": "counterparty",
          "sql_type": "STRING",
          "comment": "Counterparty: Customer, Supplier, Government, Internal",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.35 THEN 'Customer' WHEN {alt_status_noise2} < 0.65 THEN 'Supplier' WHEN {alt_status_noise2} < 0.82 THEN 'Government' ELSE 'Internal' END"
        },
        {
          "name": "currency",
          "sql_type": "STRING",
          "comment": "Transaction currency: USD, EUR, GBP, JPY",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.60 THEN 'USD' WHEN {alt_status_noise3} < 0.80 THEN 'EUR' WHEN {alt_status_noise3} < 0.92 THEN 'GBP' ELSE 'JPY' END"
        },
        {
          "name": "payment_terms_days",
          "sql_type": "INT",
          "comment": "Payment terms in days",
          "is_dimension": false,
          "generation_expr": "CAST(CASE WHEN {alt_status_noise4} < 0.20 THEN 30 WHEN {alt_status_noise4} < 0.50 THEN 45 WHEN {alt_status_noise4} < 0.75 THEN 60 ELSE 90 END AS INT)"
        }
      ],
      "seasonal_patterns": {
        "Production": {
          "3,4,9,10": 0.05
        },
        "Military": {
          "9,10": 0.06
        }
      },
