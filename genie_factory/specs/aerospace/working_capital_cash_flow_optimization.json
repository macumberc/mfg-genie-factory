          "comment": "Days sales outstanding",
          "is_dimension": false,
          "generation_expr": "ROUND(25.0 + ({qty_noise} * 65.0), 1)"
        },
        {
          "name": "dpo_days",
          "sql_type": "DOUBLE",
          "comment": "Days payable outstanding",
          "is_dimension": false,
          "generation_expr": "ROUND(20.0 + ({qty_noise} * 60.0), 1)"
