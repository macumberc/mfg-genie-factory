{
  "company_name": "AeroChain Logistics",
  "industry": "Aerospace",
  "use_case": "Aerospace supply chain and long-lead materials planning",
  "space_title": "AeroChain Logistics - Supply & Materials Planning 🔗",
  "space_description": "**Subindustry:** Aerospace\n\n**Use case:** Supply & Long-Lead Materials Planning\n\nAeroChain Logistics — supply chain analytics across 20 long-lead aerospace materials (titanium, nickel superalloys, composites, forgings) sourced from 6 supplier regions. Procurement Managers use this space to track PO performance and late-delivery risk; the VP of Supply Chain uses it to monitor supplier OTD and single-source exposure; the COO uses it to escalate at-risk material positions blocking production lines.\n\n**Key KPIs**\n- Supplier on-time delivery % (target >95%, industry benchmark 90-95%)\n- Late delivery count vs. total PO count\n- Days of supply (target 30-60 days for production materials, 90+ for long-lead forgings)\n- Supplier quality % (acceptance rate, target >99% on flight-critical)\n- Average lead time (weeks) — titanium 30-40 wks, composites 16-24 wks, forgings 40-60 wks\n- Monthly spend (USD) by material class and supplier region\n- Single-source material count — risk concentration metric\n- Critical / at-risk material count blocking production\n\n**Data sources**\n- `procurement_orders` — daily PO records with quantity, cost, lead time, delivery status, quality acceptance\n- `supply_snapshots` — weekly on-hand, committed, safety stock, days of supply, at-risk flag\n- `supply_kpi_monthly` — monthly supplier OTD %, quality %, spend, lead time, single-source flag",
  "schema_basename": "aerospace_supply_planning",
  "tables": [
    {
      "table_name": "procurement_orders",
      "description": "Daily procurement order records for aerospace materials with supplier, lead time, cost, and delivery status.",
      "columns": [
        {
          "name": "po_id",
          "sql_type": "STRING",
          "comment": "Unique purchase order identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('PO-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.material_id) + 10000 AS STRING), 7, '0'))"
        },
        {
          "name": "order_date",
          "sql_type": "DATE",
          "comment": "Date PO was placed",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "material_id",
          "sql_type": "STRING",
          "comment": "Material identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_name",
          "sql_type": "STRING",
          "comment": "Material descriptive name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_class",
          "sql_type": "STRING",
          "comment": "Material class: Titanium, Nickel Superalloy, Carbon Fiber, Aluminum, Specialty Steel, Ceramic Matrix",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "supplier_region",
          "sql_type": "STRING",
          "comment": "Supplier region: North America, Europe, Japan, China, South Korea, Australia",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'North America' WHEN {status_noise} < 0.55 THEN 'Europe' WHEN {status_noise} < 0.70 THEN 'Japan' WHEN {status_noise} < 0.82 THEN 'China' WHEN {status_noise} < 0.92 THEN 'South Korea' ELSE 'Australia' END"
        },
        {
          "name": "order_quantity_kg",
          "sql_type": "DOUBLE",
          "comment": "Order quantity in kilograms",
          "is_dimension": false,
          "generation_expr": "ROUND(100.0 + ({qty_noise} * 9900.0), 2)"
        },
        {
          "name": "unit_cost_usd_kg",
          "sql_type": "DOUBLE",
          "comment": "Cost per kilogram in USD",
          "is_dimension": false,
          "generation_expr": ""
        },
        {
          "name": "lead_time_weeks",
          "sql_type": "INT",
          "comment": "Supplier-quoted lead time in weeks",
          "is_dimension": false,
          "generation_expr": "CAST(4 + FLOOR({qty_noise} * 48) AS INT)"
        },
        {
          "name": "delivery_status",
          "sql_type": "STRING",
          "comment": "Delivery status: On Time, Late, Partial, Cancelled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.60 THEN 'On Time' WHEN {alt_status_noise} < 0.82 THEN 'Late' WHEN {alt_status_noise} < 0.95 THEN 'Partial' ELSE 'Cancelled' END"
        },
        {
          "name": "quality_acceptance",
          "sql_type": "STRING",
          "comment": "Quality acceptance: Accepted, Conditional, Rejected",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.80 THEN 'Accepted' WHEN {alt_status_noise2} < 0.93 THEN 'Conditional' ELSE 'Rejected' END"
        }
      ],
      "seasonal_patterns": {
