    {
      "table_name": "supply_kpi_monthly",
      "description": "Monthly supply chain KPIs including on-time delivery rate, supplier quality, spend, and lead time trends.",
      "columns": [
        {
          "name": "record_id",
          "sql_type": "STRING",
          "comment": "Unique monthly record",
          "is_dimension": false,
          "generation_expr": "CONCAT('SK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.material_id) AS STRING), 7, '0'))"
        },
        {
          "name": "report_month",
          "sql_type": "DATE",
          "comment": "First day of report month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "material_id",
          "sql_type": "STRING",
          "comment": "Material identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_class",
          "sql_type": "STRING",
          "comment": "Material class",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "on_time_delivery_pct",
          "sql_type": "DOUBLE",
          "comment": "Supplier on-time delivery rate",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.0, 65.0 + (({qty_noise} * {seasonal_mult}) * 33.0)), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "supplier_quality_pct",
          "sql_type": "DOUBLE",
          "comment": "Supplier acceptance rate percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.5, 85.0 + (({qty_noise} * {seasonal_mult}) * 14.0)), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "monthly_spend_usd",
          "sql_type": "DOUBLE",
          "comment": "Monthly procurement spend in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(50000.0 + ({qty_noise} * 950000.0), 2)"
        },
        {
          "name": "avg_lead_time_weeks",
          "sql_type": "DOUBLE",
          "comment": "Average actual lead time in weeks",
          "is_dimension": false,
          "generation_expr": "ROUND(4.0 + ({qty_noise} * 36.0), 1)"
        },
        {
          "name": "single_source_flag",
          "sql_type": "STRING",
          "comment": "Single-source risk: Yes, No",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'Yes' ELSE 'No' END"
        }
      ],
