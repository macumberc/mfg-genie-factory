        {
          "name": "water_cut_pct",
          "sql_type": "DOUBLE",
          "comment": "Water cut pct",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(85.0, GREATEST(5.0, 20.0 + ({qty_noise} * {seasonal_mult}) * 55.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "gor_scf_bbl",
          "sql_type": "DOUBLE",
          "comment": "GOR SCF/BBL",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(200.0, 500.0 + ({qty_noise} * {seasonal_mult}) * 4500.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "uptime_pct",
          "sql_type": "DOUBLE",
          "comment": "Well uptime pct",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(60.0, 91.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 16.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "artificial_lift_efficiency_pct",
          "sql_type": "DOUBLE",
          "comment": "Lift efficiency pct",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(98.0, GREATEST(50.0, 78.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 30.0)), 1)",
