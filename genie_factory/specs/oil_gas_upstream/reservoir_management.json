          "comment": "Reading ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('PR-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.reservoir_id) + 100000 AS STRING), 8, '0'))"
        },
