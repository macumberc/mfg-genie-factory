          "name": "oil_bpd",
          "sql_type": "DOUBLE",
          "comment": "Oil BPD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(10.0, 200.0 + ({qty_noise} * {seasonal_mult}) * 2800.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "gas_mcfpd",
          "sql_type": "DOUBLE",
          "comment": "Gas MCF per day",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(50.0, 500.0 + ({qty_noise} * {seasonal_mult}) * 9500.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "water_bpd",
          "sql_type": "DOUBLE",
          "comment": "Water BPD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(5.0, 50.0 + ({qty_noise} * {seasonal_mult}) * 1500.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "reservoir_pressure_psi",
          "sql_type": "DOUBLE",
          "comment": "Reservoir pressure PSI",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(500.0, 2000.0 + {qty_noise} * 6000.0), 0)"
        },
        {
          "name": "bottomhole_temp_f",
          "sql_type": "DOUBLE",
          "comment": "Bottomhole temp F",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(150.0, 180.0 + {qty_noise} * 120.0), 0)"
        },
        {
          "name": "lift_method",
          "sql_type": "STRING",
          "comment": "Lift: Natural Flow, ESP, Rod Pump, Gas Lift, Plunger",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.25 THEN 'Natural Flow' WHEN {status_noise} < 0.45 THEN 'ESP' WHEN {status_noise} < 0.65 THEN 'Rod Pump' WHEN {status_noise} < 0.85 THEN 'Gas Lift' ELSE 'Plunger' END"
        }
      ],
