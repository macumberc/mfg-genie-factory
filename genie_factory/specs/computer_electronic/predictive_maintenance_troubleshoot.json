          "sql_type": "STRING",
          "comment": "Alert level: Normal, Warning, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.75 THEN 'Normal' WHEN {status_noise} < 0.92 THEN 'Warning' ELSE 'Critical' END"
