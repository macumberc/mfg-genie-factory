        {
          "name": "mttr_hours",
          "sql_type": "DOUBLE",
          "comment": "Mean time to repair in hours",
          "is_dimension": false,
          "generation_expr": "ROUND(1.0 + (({qty_noise} * {seasonal_mult}) * 11.0), 1)",
