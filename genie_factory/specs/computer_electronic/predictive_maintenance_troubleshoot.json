  "metric_views": [
    {
      "view_name": "sensor_readings_metrics",
      "source_table": "sensor_readings",
      "dimensions": [
        {
          "name": "reading_date",
          "expr": "reading_date"
        },
        {
          "name": "machine_type",
          "expr": "machine_type"
        },
        {
          "name": "assembly_line",
          "expr": "assembly_line"
        },
        {
          "name": "alert_level",
          "expr": "alert_level"
        }
      ],
      "measures": [
        {
          "name": "total_readings",
          "expr": "COUNT(DISTINCT reading_id)",
          "comment": "Total number of sensor readings"
        },
        {
          "name": "avg_vibration",
          "expr": "AVG(vibration_mm_s)",
          "comment": "Average vibration velocity in mm/s"
        },
        {
          "name": "avg_temperature",
          "expr": "AVG(temperature_c)",
          "comment": "Average operating temperature in Celsius"
        },
        {
          "name": "critical_alert_count",
          "expr": "COUNT(DISTINCT CASE WHEN alert_level = 'Critical' THEN reading_id END)",
          "comment": "Number of critical alert readings"
        },
        {
          "name": "total_power_consumption_kw",
          "expr": "SUM(power_consumption_kw)",
          "comment": "Total power consumption kw"
        },
        {
          "name": "total_anomaly_score",
          "expr": "SUM(anomaly_score)",
          "comment": "Total anomaly score"
        },
        {
          "name": "unique_machine_count",
          "expr": "COUNT(DISTINCT machine_id)",
          "comment": "Number of distinct machines"
        },
        {
          "name": "max_vibration_mm_s",
          "expr": "MAX(vibration_mm_s)",
          "comment": "Maximum vibration mm s"
        }
      ]
    },
    {
      "view_name": "equipment_health_metrics",
      "source_table": "equipment_health_monthly",
      "dimensions": [
        {
          "name": "health_month",
          "expr": "health_month"
        },
        {
          "name": "machine_type",
          "expr": "machine_type"
        },
        {
          "name": "assembly_line",
          "expr": "assembly_line"
        }
      ],
      "measures": [
        {
          "name": "avg_mtbf_hours",
          "expr": "AVG(mtbf_hours)",
          "comment": "Average mean time between failures in hours"
        },
        {
          "name": "avg_mttr_hours",
          "expr": "AVG(mttr_hours)",
          "comment": "Average mean time to repair in hours"
        },
        {
          "name": "avg_availability_pct",
          "expr": "AVG(availability_pct)",
          "comment": "Average equipment availability percentage"
        },
        {
          "name": "total_maintenance_cost",
          "expr": "SUM(maintenance_cost_usd)",
          "comment": "Total maintenance cost in USD"
        },
        {
          "name": "total_total_downtime_hours",
          "expr": "SUM(total_downtime_hours)",
          "comment": "Total total downtime hours"
        },
        {
          "name": "total_prediction_accuracy_percent",
          "expr": "SUM(prediction_accuracy_pct)",
          "comment": "Total prediction accuracy pct"
