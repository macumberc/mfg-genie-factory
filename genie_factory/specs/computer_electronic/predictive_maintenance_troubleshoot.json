        {
          "name": "anomaly_score",
          "sql_type": "DOUBLE",
          "comment": "ML anomaly detection score 0-1",
          "is_dimension": false,
          "generation_expr": "ROUND(({qty_noise} * {seasonal_mult}) * 1.0, 4)",
          "seasonal_amplitude": 0.15
