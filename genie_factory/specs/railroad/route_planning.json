          "comment": "Projected monthly GTM millions",
          "is_dimension": false,
          "generation_expr": "ROUND(200.0 + ({qty_noise} * 3800.0), 2)"
        },
        {
          "name": "maintenance_window_days",
          "sql_type": "INT",
          "comment": "Planned maintenance days",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 10) AS INT)"
        },
        {
          "name": "capex_needed_usd",
          "sql_type": "DOUBLE",
          "comment": "Capital expenditure needed USD",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 5000000.0, 2)"
        },
        {
          "name": "capacity_risk",
          "sql_type": "STRING",
          "comment": "Risk: Low, Moderate, High, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.05 THEN 'Critical' WHEN {status_noise} < 0.18 THEN 'High' WHEN {status_noise} < 0.40 THEN 'Moderate' ELSE 'Low' END"
        }
