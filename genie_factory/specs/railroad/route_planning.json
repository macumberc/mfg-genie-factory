          "sql_type": "DOUBLE",
          "comment": "Total congestion delay hours",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 48.0, 1)"
        },
        {
          "name": "fuel_gallons_per_ton_mile",
          "sql_type": "DOUBLE",
          "comment": "Fuel efficiency gal per 1000 GTM",
          "is_dimension": false,
          "generation_expr": "ROUND(0.8 + ({qty_noise} * 0.7), 3)"
        },
        {
          "name": "corridor_status",
          "sql_type": "STRING",
          "comment": "Status: Fluid, Slow, Congested, Blocked",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.03 THEN 'Blocked' WHEN {status_noise} < 0.12 THEN 'Congested' WHEN {status_noise} < 0.28 THEN 'Slow' ELSE 'Fluid' END"
        }
