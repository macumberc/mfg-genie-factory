        },
        {
          "name": "forecast_month",
          "sql_type": "DATE",
          "comment": "Forecast month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "lane_id",
          "sql_type": "STRING",
          "comment": "Lane identifier",
          "is_dimension": true,
          "generation_expr": ""
