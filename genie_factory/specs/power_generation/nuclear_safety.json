          "name": "record_id",
          "sql_type": "STRING",
          "comment": "Unique component health record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('RCH-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.component_id) + 10000 AS STRING), 6, '0'))"
        },
        {
          "name": "record_date",
          "sql_type": "DATE",
          "comment": "Date of health record",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "component_id",
          "sql_type": "STRING",
          "comment": "Reactor component identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
