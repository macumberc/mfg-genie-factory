          "comment": "Reactor unit designation",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "temperature_celsius",
          "sql_type": "DOUBLE",
          "comment": "Component temperature in Celsius",
          "is_dimension": false,
          "generation_expr": "ROUND(250.0 + ({qty_noise} * 100.0), 1)"
        },
        {
          "name": "pressure_mpa",
          "sql_type": "DOUBLE",
          "comment": "Pressure in megapascals",
          "is_dimension": false,
          "generation_expr": "ROUND(10.0 + ({qty_noise} * 7.0), 2)"
        },
        {
          "name": "radiation_msv",
          "sql_type": "DOUBLE",
          "comment": "Radiation level in millisieverts",
          "is_dimension": false,
          "generation_expr": "ROUND(0.01 + ({qty_noise} * 0.99), 3)"
        },
        {
          "name": "health_status",
          "sql_type": "STRING",
          "comment": "Component health: Normal, Watch, Warning, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.02 THEN 'Critical' WHEN {status_noise} < 0.08 THEN 'Warning' WHEN {status_noise} < 0.18 THEN 'Watch' ELSE 'Normal' END"
        }
