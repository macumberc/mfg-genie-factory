          "name": "inspection_id",
          "sql_type": "STRING",
          "comment": "Unique inspection record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('INS-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.component_id) AS STRING), 7, '0'))"
        },
        {
          "name": "inspection_date",
          "sql_type": "DATE",
          "comment": "Date of inspection",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "component_id",
          "sql_type": "STRING",
