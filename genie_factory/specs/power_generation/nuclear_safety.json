          "comment": "Reactor unit",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "compliance_score",
          "sql_type": "DOUBLE",
          "comment": "NRC compliance score 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(75.0 + (({qty_noise} * {seasonal_mult}) * 25.0), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "deficiency_count",
          "sql_type": "INT",
          "comment": "Number of deficiencies found",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 8) AS INT)"
        },
        {
          "name": "corrective_actions_open",
          "sql_type": "INT",
          "comment": "Number of open corrective actions",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 12) AS INT)"
        },
        {
          "name": "days_since_last_inspection",
          "sql_type": "INT",
          "comment": "Days elapsed since previous inspection",
          "is_dimension": false,
          "generation_expr": "CAST(7 + FLOOR({qty_noise} * 200) AS INT)"
        },
        {
          "name": "inspection_result",
          "sql_type": "STRING",
          "comment": "Result: Pass, Conditional Pass, Fail, Deferred",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.03 THEN 'Fail' WHEN {status_noise} < 0.10 THEN 'Deferred' WHEN {status_noise} < 0.25 THEN 'Conditional Pass' ELSE 'Pass' END"
        }
      ],
