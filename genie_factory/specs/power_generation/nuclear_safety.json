          "comment": "Component name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "component_type",
          "sql_type": "STRING",
          "comment": "Component type: Fuel Assembly, Control Rod, Coolant Pump, Steam Generator, Containment",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "reactor_unit",
