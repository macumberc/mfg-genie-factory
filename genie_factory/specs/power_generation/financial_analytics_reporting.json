          "comment": "Budget status: On Track, At Risk, Over Budget, Under Budget",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.10 THEN 'Over Budget' WHEN {status_noise} < 0.25 THEN 'At Risk' WHEN {status_noise} < 0.40 THEN 'Under Budget' ELSE 'On Track' END"
        }
