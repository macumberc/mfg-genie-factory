          "sql_type": "DOUBLE",
          "comment": "Transaction amount in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500.0 + ({qty_noise} * 99500.0), 2)"
        },
        {
          "name": "expense_category",
          "sql_type": "STRING",
          "comment": "Category: Labor, Materials, Fuel, Utilities, Services, CapEx",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.25 THEN 'Labor' WHEN {status_noise} < 0.40 THEN 'Materials' WHEN {status_noise} < 0.55 THEN 'Fuel' WHEN {status_noise} < 0.68 THEN 'Utilities' WHEN {status_noise} < 0.82 THEN 'Services' ELSE 'CapEx' END"
        },
        {
          "name": "budget_line_item",
          "sql_type": "STRING",
          "comment": "Budget line item reference",
          "is_dimension": false,
          "generation_expr": "CONCAT('BLI-', LPAD(CAST(FLOOR({qty_noise} * 200) AS STRING), 4, '0'))"
        },
        {
          "name": "approval_status",
          "sql_type": "STRING",
          "comment": "Approval status: Approved, Pending, Rejected",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.03 THEN 'Rejected' WHEN {alt_status_noise} < 0.12 THEN 'Pending' ELSE 'Approved' END"
        }
