          "name": "revenue_usd",
          "sql_type": "DOUBLE",
          "comment": "Revenue in USD (generation cost centers only)",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 500000.0, 2)"
        },
        {
          "name": "actual_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Actual cost in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(10000.0 + ({qty_noise} * 290000.0), 2)"
        },
        {
          "name": "budget_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Budgeted cost in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(12000.0 + ({qty_noise} * 288000.0), 2)"
        },
        {
          "name": "variance_usd",
          "sql_type": "DOUBLE",
          "comment": "Budget variance (budget - actual) in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(({qty_noise} - 0.5) * 50000.0, 2)"
        },
        {
          "name": "variance_pct",
          "sql_type": "DOUBLE",
          "comment": "Variance as percentage of budget",
          "is_dimension": false,
          "generation_expr": "ROUND((({qty_noise} * {seasonal_mult}) - 0.5) * 30.0, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "fiscal_quarter",
          "sql_type": "STRING",
          "comment": "Fiscal quarter: Q1, Q2, Q3, Q4",
          "is_dimension": false,
          "generation_expr": "CASE WHEN MONTH(d.dt) IN (1,2,3) THEN 'Q1' WHEN MONTH(d.dt) IN (4,5,6) THEN 'Q2' WHEN MONTH(d.dt) IN (7,8,9) THEN 'Q3' ELSE 'Q4' END"
        }
