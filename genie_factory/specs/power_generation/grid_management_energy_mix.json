  "benchmarks": [
    {
      "question": "What is the monthly trend in dispatched plant count?",
      "sql_lines": [
        "SELECT record_date, MEASURE(dispatched_plant_count) AS dispatched_plant_count",
        "FROM {fqn}.generation_kpi_monthly",
        "GROUP BY ALL",
        "ORDER BY record_date"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', record_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.generation_units",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "Which power plants have the highest total energy generated in megawatt-hours?",
      "sql_lines": [
        "SELECT plant_name, SUM(generation_mwh) AS total_metric",
        "FROM {fqn}.generation_units",
        "GROUP BY 1",
        "ORDER BY total_metric DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "How has total planned generation in mwh trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, MEASURE(max_planned_mwh) AS max_planned_mwh",
        "FROM {fqn}.dispatch_kpi_monthly",
        "GROUP BY ALL",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "What is the average energy generated in megawatt-hours by power plant identifier?",
      "sql_lines": [
        "SELECT plant_id, AVG(generation_mwh) AS avg_generation_mwh",
        "FROM {fqn}.generation_units",
        "GROUP BY plant_id ORDER BY avg_generation_mwh DESC"
      ]
    },
    {
      "question": "What is the average unit availability percentage 0-100 by generation fuel type?",
      "sql_lines": [
        "SELECT fuel_type, AVG(availability_pct) AS avg_availability_pct",
        "FROM {fqn}.generation_readings",
        "GROUP BY fuel_type ORDER BY avg_availability_pct DESC"
      ]
    },
    {
      "question": "Which generation fuel types have the highest average reserve margin percentage?",
      "sql_lines": [
        "SELECT fuel_type, MEASURE(avg_reserve_margin) AS avg_reserve_margin",
        "FROM {fqn}.dispatch_kpi_monthly",
        "GROUP BY ALL",
        "ORDER BY avg_reserve_margin DESC",
        "LIMIT 10"
      ]
    }
  ]
