  "metric_views": [
    {
      "view_name": "generation_kpi_monthly",
      "source_table": "generation_units",
      "dimensions": [
        {
          "name": "record_date",
          "expr": "record_date"
        },
        {
          "name": "fuel_type",
          "expr": "fuel_type"
        },
        {
          "name": "region",
          "expr": "region"
        },
        {
          "name": "dispatch_status",
          "expr": "dispatch_status"
        }
      ],
      "measures": [
        {
          "name": "total_generation_mwh",
          "expr": "SUM(generation_mwh)",
          "comment": "Total energy generated in MWh"
        },
        {
          "name": "avg_capacity_factor",
          "expr": "AVG(capacity_factor_pct)",
          "comment": "Average capacity factor percentage"
        },
        {
          "name": "dispatched_plant_count",
          "expr": "COUNT(DISTINCT CASE WHEN dispatch_status = 'Dispatched' THEN plant_id END)",
          "comment": "Number of dispatched plants"
        },
        {
          "name": "total_plant_count",
          "expr": "COUNT(DISTINCT plant_id)",
          "comment": "Total number of plants"
        },
        {
          "name": "avg_heat_rate",
          "expr": "AVG(heat_rate_btu_kwh)",
          "comment": "Average heat rate BTU/kWh"
        },
        {
