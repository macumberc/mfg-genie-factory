          "comment": "Planned generation in MWh",
          "is_dimension": false,
          "generation_expr": "ROUND(400.0 + ({qty_noise} * 9600.0), 2)"
        },
        {
          "name": "actual_mwh",
          "sql_type": "DOUBLE",
          "comment": "Actual generation in MWh",
          "is_dimension": false,
          "generation_expr": "ROUND((400.0 + ({qty_noise} * 9600.0)) * (0.85 + {status_noise} * 0.25), 2)"
        },
        {
          "name": "curtailment_mwh",
          "sql_type": "DOUBLE",
          "comment": "Energy curtailed in MWh",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 500.0, 2)"
        },
        {
          "name": "reserve_margin_pct",
          "sql_type": "DOUBLE",
          "comment": "Operating reserve margin percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(8.0 + (({qty_noise} * {seasonal_mult}) * 22.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "dispatch_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Total dispatch cost in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(5000.0 + ({qty_noise} * 95000.0), 2)"
        },
        {
          "name": "forecast_accuracy_pct",
          "sql_type": "DOUBLE",
          "comment": "Demand forecast accuracy percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(80.0 + (({qty_noise} * {seasonal_mult}) * 18.0), 2)",
          "seasonal_amplitude": 0.15
        }
