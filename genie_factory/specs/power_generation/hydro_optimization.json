          "sql_type": "STRING",
          "comment": "Drought risk: Low, Moderate, High, Severe",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.05 THEN 'Severe' WHEN {status_noise} < 0.15 THEN 'High' WHEN {status_noise} < 0.35 THEN 'Moderate' ELSE 'Low' END"
        }
