  "benchmarks": [
    {
      "question": "What is the monthly trend in generating count?",
      "sql_lines": [
        "SELECT record_date, MEASURE(generating_count) AS generating_count",
        "FROM {fqn}.turbine_kpi_monthly",
        "GROUP BY ALL",
        "ORDER BY record_date"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', record_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.wind_turbines",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "How does energy generated in mwh compare across turbines?",
      "sql_lines": [
        "SELECT turbine_name, SUM(generation_mwh) AS total_metric",
        "FROM {fqn}.wind_turbines",
        "GROUP BY 1",
        "ORDER BY total_metric DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "How has total forecasted generation in mwh trended over time?",
      "sql_lines": [
        "SELECT snapshot_date, MEASURE(max_forecasted_generation_mwh) AS max_forecasted_generation_mwh",
        "FROM {fqn}.wind_forecast_monthly",
        "GROUP BY ALL",
        "ORDER BY snapshot_date"
      ]
    },
    {
      "question": "Which turbines have the highest total average wind speed in meters per second?",
      "sql_lines": [
        "SELECT turbine_name, SUM(avg_wind_speed_ms) AS total_avg_wind_speed_ms",
        "FROM {fqn}.wind_turbines",
        "GROUP BY turbine_name",
        "ORDER BY total_avg_wind_speed_ms DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "What is the average deviation from ideal power curve 0-100 by turbine model?",
      "sql_lines": [
        "SELECT turbine_model, AVG(power_curve_deviation_pct) AS avg_power_curve_deviation_pct",
        "FROM {fqn}.performance_readings",
        "GROUP BY turbine_model ORDER BY avg_power_curve_deviation_pct DESC"
      ]
    },
    {
      "question": "Which wind farms have the highest average turbine availability?",
      "sql_lines": [
        "SELECT wind_farm, MEASURE(avg_availability) AS avg_availability",
