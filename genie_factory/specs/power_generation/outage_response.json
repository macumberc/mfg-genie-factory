        {
          "name": "availability_pct",
          "sql_type": "DOUBLE",
          "comment": "Unit availability percentage 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(60.0 + ({qty_noise} * 40.0), 2)"
        },
        {
          "name": "operational_status",
          "sql_type": "STRING",
          "comment": "Status: Running, Standby, Forced Outage, Planned Outage",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.08 THEN 'Forced Outage' WHEN {status_noise} < 0.15 THEN 'Planned Outage' WHEN {status_noise} < 0.25 THEN 'Standby' ELSE 'Running' END"
        }
