          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.15 THEN 'Diagnosing' WHEN {status_noise} < 0.30 THEN 'Parts Ordered' WHEN {status_noise} < 0.55 THEN 'In Repair' WHEN {status_noise} < 0.75 THEN 'Testing' ELSE 'Restored' END"
        },
