          "sql_type": "STRING",
          "comment": "Unique outage event identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('OUT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.unit_id) AS STRING), 7, '0'))"
        },
        {
          "name": "outage_date",
          "sql_type": "DATE",
          "comment": "Date outage began",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "unit_id",
          "sql_type": "STRING",
          "comment": "Generator unit identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "unit_type",
          "sql_type": "STRING",
          "comment": "Generator type",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "station",
          "sql_type": "STRING",
          "comment": "Power station name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "outage_type",
          "sql_type": "STRING",
          "comment": "Outage type: Forced, Planned, Maintenance, Emergency",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'Forced' WHEN {status_noise} < 0.60 THEN 'Planned' WHEN {status_noise} < 0.85 THEN 'Maintenance' ELSE 'Emergency' END"
        },
        {
          "name": "cause_code",
          "sql_type": "STRING",
          "comment": "Root cause category: Mechanical, Electrical, Boiler, Controls, External",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.30 THEN 'Mechanical' WHEN {alt_status_noise} < 0.55 THEN 'Electrical' WHEN {alt_status_noise} < 0.72 THEN 'Boiler' WHEN {alt_status_noise} < 0.88 THEN 'Controls' ELSE 'External' END"
        },
        {
          "name": "duration_hours",
          "sql_type": "DOUBLE",
          "comment": "Outage duration in hours",
          "is_dimension": false,
          "generation_expr": "ROUND(2.0 + ({qty_noise} * 478.0), 1)"
        },
        {
          "name": "lost_generation_mwh",
          "sql_type": "DOUBLE",
          "comment": "Estimated lost generation in MWh",
          "is_dimension": false,
          "generation_expr": "ROUND(100.0 + ({qty_noise} * 9900.0), 2)"
        },
        {
          "name": "repair_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Repair and restoration cost in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(5000.0 + ({qty_noise} * 495000.0), 2)"
