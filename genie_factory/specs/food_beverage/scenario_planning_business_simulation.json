          "comment": "Scenario: Base, Optimistic, Pessimistic, Disruption",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.10 THEN 'Disruption' WHEN {status_noise} < 0.30 THEN 'Pessimistic' WHEN {status_noise} < 0.55 THEN 'Optimistic' ELSE 'Base' END"
        },
