        {
          "name": "expected_revenue_usd",
          "sql_type": "DOUBLE",
          "comment": "Expected monthly revenue USD",
          "is_dimension": false,
          "generation_expr": "ROUND(50000.0 + ({qty_noise} * 450000.0), 2)"
        },
        {
          "name": "revenue_at_risk_usd",
          "sql_type": "DOUBLE",
          "comment": "Revenue at risk from downside scenarios",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 100000.0, 2)"
        },
        {
          "name": "optimal_price_change_pct",
          "sql_type": "DOUBLE",
          "comment": "Recommended price change pct",
          "is_dimension": false,
          "generation_expr": "ROUND((({qty_noise} * {seasonal_mult}) - 0.4) * 15.0, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "investment_priority",
          "sql_type": "STRING",
          "comment": "Priority: Invest, Maintain, Harvest, Divest",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.10 THEN 'Divest' WHEN {status_noise} < 0.25 THEN 'Harvest' WHEN {status_noise} < 0.55 THEN 'Maintain' ELSE 'Invest' END"
        },
        {
          "name": "confidence_level_pct",
          "sql_type": "DOUBLE",
          "comment": "Scenario confidence 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(50.0 + (({qty_noise} * {seasonal_mult}) * 45.0), 1)",
