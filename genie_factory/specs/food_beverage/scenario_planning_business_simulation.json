  "metric_views": [
    {
      "view_name": "scenario_kpi_monthly",
      "source_table": "product_categories",
      "dimensions": [
        {
          "name": "run_date",
          "expr": "run_date"
        },
        {
          "name": "segment",
          "expr": "segment"
        },
        {
          "name": "channel",
          "expr": "channel"
        },
        {
          "name": "scenario_type",
          "expr": "scenario_type"
        }
      ],
      "measures": [
        {
          "name": "avg_simulated_revenue",
          "expr": "AVG(simulated_revenue_usd)",
          "comment": "Avg simulated revenue"
        },
        {
          "name": "avg_simulated_margin",
          "expr": "AVG(simulated_margin_pct)",
          "comment": "Avg simulated margin pct"
        },
        {
          "name": "total_simulated_revenue",
          "expr": "SUM(simulated_revenue_usd)",
          "comment": "Total simulated revenue"
        },
        {
          "name": "run_count",
          "expr": "COUNT(DISTINCT run_id)",
          "comment": "Total simulation runs"
        },
        {
          "name": "disruption_count",
          "expr": "COUNT(DISTINCT CASE WHEN scenario_type = 'Disruption' THEN run_id END)",
          "comment": "Disruption scenario count"
        },
        {
          "name": "total_price_change_percent",
          "expr": "SUM(price_change_pct)",
          "comment": "Total price change pct"
        },
        {
          "name": "unique_category_count",
          "expr": "COUNT(DISTINCT category_id)",
          "comment": "Number of distinct categorys"
        },
        {
          "name": "max_simulated_revenue",
          "expr": "MAX(simulated_revenue_usd)",
          "comment": "Maximum simulated revenue usd"
        }
      ]
    },
