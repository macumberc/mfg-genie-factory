{
  "company_name": "CapAlloc Semi",
  "industry": "Semiconductor",
  "use_case": "Supply chain materials management and fab capacity allocation",
  "space_title": "CapAlloc - Supply & Capacity Allocation 🔗",
  "space_description": "**Subindustry:** Semiconductor\n\n**Use case:** Supply Chain Materials & Fab Capacity Allocation\n\nCapAlloc Semi — supplier and capacity analytics covering 20 materials (silicon wafers, photoresists, gases, sputtering targets, EUV consumables) and multiple fab lines. Procurement and Supply Chain use this space to monitor supplier lead times and quality reject rates; the COO and CFO use it to track fab utilization against the 85–90% target, identify single-source risk on EUV / advanced-process consumables, and time capex against projected wafer-start demand.\n\n**Key KPIs**\n- Fab utilization % — consumed vs available wafer starts; world-class 85–90%, >95% signals risk of breakage\n- Wafer starts (weekly) — capacity throughput baseline\n- Material lead time (days) — supplier responsiveness; EUV-related gases often 90+ days\n- Delayed order count — supplier-on-time exposure\n- Reject rate % — incoming quality issues, target <1%\n- Plan adherence % — allocation discipline vs commit; target 95%+\n- Procurement spend (USD) — direct materials COGS line\n- Critical bottleneck count — fab lines flagged as capacity-constrained\n\n**Data sources**\n- `material_orders` — daily supplier purchase orders with lead time, value, quality, and delivery status\n- `capacity_snapshots` — weekly fab-line utilization, wafer starts, and bottleneck classification\n- `allocation_monthly` — monthly allocation plans with adherence percentage and procurement spend",
  "schema_basename": "semiconductor_supply_capacity",
  "tables": [
    {
      "table_name": "material_orders",
      "description": "Daily material procurement order records tracking quantities, costs, lead times, and delivery status for fab consumables and substrates.",
      "columns": [
        {
          "name": "order_id",
          "sql_type": "STRING",
          "comment": "Unique material order identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('MO-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "order_date",
          "sql_type": "DATE",
          "comment": "Date the order was placed",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "material_id",
          "sql_type": "STRING",
          "comment": "Material or component identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_name",
          "sql_type": "STRING",
          "comment": "Human-readable material name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_category",
          "sql_type": "STRING",
          "comment": "Material category grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "supplier_name",
          "sql_type": "STRING",
          "comment": "Supplier name",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.20 THEN 'GlobalWafer Corp' WHEN {status_noise} < 0.35 THEN 'ShinEtsu Materials' WHEN {status_noise} < 0.50 THEN 'Entegris Inc' WHEN {status_noise} < 0.65 THEN 'Versum Materials' WHEN {status_noise} < 0.78 THEN 'Linde PLC' WHEN {status_noise} < 0.90 THEN 'Air Liquide Semi' ELSE 'DuPont Electronics' END"
        },
        {
          "name": "order_quantity",
          "sql_type": "INT",
          "comment": "Quantity ordered (units vary by material)",
          "is_dimension": false,
          "generation_expr": "CAST(10 + FLOOR({qty_noise} * 990) AS INT)"
        },
        {
          "name": "order_value_usd",
          "sql_type": "DOUBLE",
          "comment": "Total order value in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500.0 + {qty_noise} * 99500.0, 2)"
        },
        {
          "name": "lead_time_days",
          "sql_type": "INT",
          "comment": "Supplier quoted lead time in days",
          "is_dimension": false,
          "generation_expr": "CAST(7 + FLOOR({qty_noise} * 113) AS INT)"
        },
        {
          "name": "delivery_status",
          "sql_type": "STRING",
          "comment": "Order delivery status",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.55 THEN 'Delivered' WHEN {alt_status_noise} < 0.72 THEN 'In Transit' WHEN {alt_status_noise} < 0.85 THEN 'Confirmed' WHEN {alt_status_noise} < 0.93 THEN 'Delayed' ELSE 'Cancelled' END"
        },
        {
          "name": "quality_result",
          "sql_type": "STRING",
          "comment": "Incoming quality inspection result",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.82 THEN 'Pass' WHEN {alt_status_noise2} < 0.93 THEN 'Conditional' ELSE 'Reject' END"
        }
      ],
      "seasonal_patterns": {
        "Substrates": {
          "1,2": 0.05,
          "9,10": 0.06
        },
        "Process Chemicals": {
          "3,4": 0.045,
