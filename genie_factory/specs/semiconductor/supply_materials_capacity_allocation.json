    {
      "table_name": "capacity_snapshots",
      "description": "Weekly fab capacity snapshots tracking utilization, available wafer starts, and bottleneck status across process nodes and fab lines.",
      "columns": [
        {
          "name": "snapshot_id",
          "sql_type": "STRING",
          "comment": "Unique capacity snapshot identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('CS-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "snapshot_date",
          "sql_type": "DATE",
          "comment": "Week-ending date of capacity snapshot",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('week', dt)"
        },
        {
          "name": "material_id",
          "sql_type": "STRING",
          "comment": "Material or component identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_name",
          "sql_type": "STRING",
          "comment": "Human-readable material name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "material_category",
          "sql_type": "STRING",
          "comment": "Material category grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "fab_line",
          "sql_type": "STRING",
          "comment": "Fabrication line identifier",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.22 THEN 'FAB-A 3nm' WHEN {status_noise} < 0.42 THEN 'FAB-B 5nm' WHEN {status_noise} < 0.58 THEN 'FAB-C 7nm' WHEN {status_noise} < 0.72 THEN 'FAB-D 14nm' WHEN {status_noise} < 0.85 THEN 'FAB-E 28nm' ELSE 'FAB-F Packaging' END"
        },
        {
          "name": "utilization_pct",
          "sql_type": "DOUBLE",
          "comment": "Fab line utilization percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(40.0, 78.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 40.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "available_wafer_starts",
          "sql_type": "INT",
          "comment": "Available wafer start slots for the week",
          "is_dimension": false,
          "generation_expr": "CAST(100 + FLOOR({qty_noise} * 1900) AS INT)"
        },
        {
          "name": "consumed_wafer_starts",
          "sql_type": "INT",
          "comment": "Consumed wafer start slots",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR((100 + FLOOR({qty_noise} * 1900)) * (0.40 + {qty_noise} * 0.55)) AS INT)"
        },
        {
          "name": "bottleneck_status",
          "sql_type": "STRING",
          "comment": "Capacity bottleneck classification",
          "is_dimension": false,
          "generation_expr": "CASE WHEN (78.0 + ({qty_noise} - 0.5) * 40.0) >= 92.0 THEN 'Critical' WHEN (78.0 + ({qty_noise} - 0.5) * 40.0) >= 85.0 THEN 'Tight' WHEN (78.0 + ({qty_noise} - 0.5) * 40.0) >= 70.0 THEN 'Normal' ELSE 'Underutilized' END"
        }
      ],
