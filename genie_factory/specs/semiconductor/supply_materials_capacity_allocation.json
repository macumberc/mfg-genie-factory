        },
        {
          "name": "material_category",
          "sql_type": "STRING",
          "comment": "Material category grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "fab_line",
          "sql_type": "STRING",
          "comment": "Fabrication line identifier",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.22 THEN 'FAB-A 3nm' WHEN {status_noise} < 0.42 THEN 'FAB-B 5nm' WHEN {status_noise} < 0.58 THEN 'FAB-C 7nm' WHEN {status_noise} < 0.72 THEN 'FAB-D 14nm' WHEN {status_noise} < 0.85 THEN 'FAB-E 28nm' ELSE 'FAB-F Packaging' END"
        },
        {
          "name": "allocated_capacity_units",
          "sql_type": "INT",
          "comment": "Planned allocation in capacity units",
          "is_dimension": false,
          "generation_expr": "CAST(500 + FLOOR({qty_noise} * 9500) AS INT)"
        },
        {
          "name": "consumed_capacity_units",
          "sql_type": "INT",
          "comment": "Actual consumed capacity units",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR((500 + FLOOR({qty_noise} * 9500)) * (0.60 + {qty_noise} * 0.38)) AS INT)"
        },
        {
          "name": "plan_adherence_pct",
          "sql_type": "DOUBLE",
          "comment": "Percentage adherence to allocation plan",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(120.0, GREATEST(50.0, 85.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 40.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "procurement_spend_usd",
          "sql_type": "DOUBLE",
          "comment": "Total procurement spend in USD for the month",
          "is_dimension": false,
          "generation_expr": "ROUND(10000.0 + {qty_noise} * 490000.0, 2)"
        },
        {
          "name": "allocation_priority",
          "sql_type": "STRING",
          "comment": "Allocation priority level",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.30 THEN 'Critical' WHEN {alt_status_noise} < 0.60 THEN 'High' WHEN {alt_status_noise} < 0.85 THEN 'Standard' ELSE 'Low' END"
        }
      ],
