        "instruction": "Use when analyzing incoming material quality issues."
      }
    ],
    "expressions": [
      {
        "alias": "order_month",
        "sql": "DATE_TRUNC('month', material_orders.order_date)",
        "display_name": "order month",
        "synonyms": [
          "procurement month",
          "material order month"
        ]
      },
      {
        "alias": "spare_capacity_pct",
        "sql": "100.0 - capacity_snapshots.utilization_pct",
        "display_name": "spare capacity",
        "synonyms": [
          "available capacity",
          "headroom"
        ]
      },
      {
        "alias": "capacity_gap",
        "sql": "allocation_monthly.allocated_capacity_units - allocation_monthly.consumed_capacity_units",
        "display_name": "capacity gap",
        "synonyms": [
          "unused allocation",
          "capacity slack"
        ]
      }
    ],
    "measures": [
