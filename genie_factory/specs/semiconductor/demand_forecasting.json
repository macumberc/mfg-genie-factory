    {
      "table_name": "demand_forecasts",
      "description": "Weekly demand forecast snapshots comparing predicted vs actual order volumes per SKU, with forecast accuracy tracking.",
      "columns": [
        {
          "name": "forecast_id",
          "sql_type": "STRING",
          "comment": "Unique demand forecast record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('DF-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "forecast_date",
          "sql_type": "DATE",
          "comment": "Week-ending date of forecast",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('week', dt)"
        },
        {
          "name": "sku_id",
          "sql_type": "STRING",
          "comment": "Product SKU identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "sku_name",
          "sql_type": "STRING",
          "comment": "Human-readable product SKU name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "forecasted_units",
          "sql_type": "INT",
          "comment": "Predicted demand in units",
          "is_dimension": false,
          "generation_expr": "CAST(500 + FLOOR({qty_noise} * 19500) AS INT)"
        },
        {
          "name": "actual_units",
          "sql_type": "INT",
          "comment": "Actual orders received in units",
          "is_dimension": false,
          "generation_expr": "CAST(400 + FLOOR({qty_noise} * 19600 + ({status_noise} - 0.5) * 3000) AS INT)"
        },
        {
          "name": "forecast_accuracy_pct",
          "sql_type": "DOUBLE",
          "comment": "Forecast accuracy as percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(50.0, 82.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 30.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "forecast_bias",
          "sql_type": "STRING",
          "comment": "Whether forecast was over or under",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.45 THEN 'Over-forecast' WHEN {status_noise} < 0.55 THEN 'On Target' ELSE 'Under-forecast' END"
        },
        {
          "name": "model_type",
          "sql_type": "STRING",
          "comment": "Forecasting model used",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.35 THEN 'ML Ensemble' WHEN {alt_status_noise} < 0.65 THEN 'ARIMA' ELSE 'Prophet' END"
        }
      ],
      "seasonal_patterns": {
