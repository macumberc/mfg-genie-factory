          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.25 THEN 'OEM Tier 1' WHEN {status_noise} < 0.45 THEN 'OEM Tier 2' WHEN {status_noise} < 0.65 THEN 'Distributor' WHEN {status_noise} < 0.82 THEN 'Contract Manufacturer' ELSE 'Direct Enterprise' END"
        },
        {
          "name": "order_quantity",
          "sql_type": "INT",
          "comment": "Number of units ordered",
          "is_dimension": false,
          "generation_expr": "CAST(100 + FLOOR({qty_noise} * 9900) AS INT)"
        },
        {
          "name": "unit_price_usd",
          "sql_type": "DOUBLE",
          "comment": "Unit price in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(0.50 + {qty_noise} * 49.50, 2)"
        },
        {
          "name": "order_revenue_usd",
          "sql_type": "DOUBLE",
          "comment": "Total order revenue in USD",
          "is_dimension": false,
          "generation_expr": "ROUND((100 + FLOOR({qty_noise} * 9900)) * (0.50 + {qty_noise} * 49.50), 2)"
        },
        {
          "name": "lead_time_days",
          "sql_type": "INT",
          "comment": "Quoted lead time in days",
          "is_dimension": false,
          "generation_expr": "CAST(7 + FLOOR({qty_noise} * 83) AS INT)"
        },
        {
          "name": "fulfillment_status",
          "sql_type": "STRING",
          "comment": "Order fulfillment status",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.55 THEN 'Shipped' WHEN {alt_status_noise} < 0.72 THEN 'In Production' WHEN {alt_status_noise} < 0.85 THEN 'Backlogged' WHEN {alt_status_noise} < 0.93 THEN 'Partial Ship' ELSE 'Cancelled' END"
        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Customer geographic region",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.30 THEN 'Asia Pacific' WHEN {alt_status_noise2} < 0.55 THEN 'North America' WHEN {alt_status_noise2} < 0.75 THEN 'Europe' WHEN {alt_status_noise2} < 0.90 THEN 'Greater China' ELSE 'Rest of World' END"
        }
