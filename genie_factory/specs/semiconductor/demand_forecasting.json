        {
          "name": "on_hand_units",
          "sql_type": "INT",
          "comment": "Units currently on hand",
          "is_dimension": false,
          "generation_expr": "CAST(1000 + FLOOR({qty_noise} * 49000) AS INT)"
        },
        {
          "name": "committed_units",
          "sql_type": "INT",
          "comment": "Units allocated to existing orders",
          "is_dimension": false,
          "generation_expr": "CAST(500 + FLOOR({qty_noise} * 30000) AS INT)"
        },
        {
          "name": "available_units",
          "sql_type": "INT",
          "comment": "Uncommitted available units",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(0, (1000 + FLOOR({qty_noise} * 49000)) - (500 + FLOOR({qty_noise} * 30000))) AS INT)"
        },
        {
          "name": "weeks_of_supply",
          "sql_type": "DOUBLE",
          "comment": "Estimated weeks of supply at current demand rate",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(0.5, 2.0 + {qty_noise} * 18.0), 1)"
        },
        {
          "name": "inventory_health",
          "sql_type": "STRING",
          "comment": "Inventory health status",
          "is_dimension": false,
          "generation_expr": "CASE WHEN (2.0 + ({qty_noise} * {seasonal_mult}) * 18.0) >= 8.0 THEN 'Excess' WHEN (2.0 + {qty_noise} * 18.0) >= 4.0 THEN 'Healthy' WHEN (2.0 + {qty_noise} * 18.0) >= 2.0 THEN 'Low' ELSE 'Critical' END",
          "seasonal_amplitude": 0.15
        }
      ],
