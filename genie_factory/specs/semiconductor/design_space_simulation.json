    {
      "table_name": "optimization_results",
      "description": "Monthly optimization result summaries capturing best-found PPA tradeoffs, convergence metrics, and design closure status per chip design.",
      "columns": [
        {
          "name": "result_id",
          "sql_type": "STRING",
          "comment": "Unique optimization result identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('OPT-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "result_month",
          "sql_type": "DATE",
          "comment": "Month of the optimization result",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', dt)"
        },
        {
          "name": "design_id",
          "sql_type": "STRING",
          "comment": "Chip design identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "design_name",
          "sql_type": "STRING",
          "comment": "Human-readable chip design name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "design_family",
          "sql_type": "STRING",
          "comment": "Design family grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "best_power_mw",
          "sql_type": "DOUBLE",
          "comment": "Best total power found in milliwatts",
          "is_dimension": false,
          "generation_expr": "ROUND(80.0 + {qty_noise} * 1200.0, 1)"
        },
        {
          "name": "best_performance_score",
          "sql_type": "DOUBLE",
          "comment": "Best performance score achieved (0-100)",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.0, GREATEST(30.0, 70.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 50.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "best_area_mm2",
          "sql_type": "DOUBLE",
          "comment": "Best die area found in square millimeters",
          "is_dimension": false,
          "generation_expr": "ROUND(3.0 + {qty_noise} * 80.0, 2)"
        },
        {
          "name": "pareto_front_size",
          "sql_type": "INT",
          "comment": "Number of Pareto-optimal solutions found",
          "is_dimension": false,
          "generation_expr": "CAST(3 + FLOOR({qty_noise} * 47) AS INT)"
        },
        {
          "name": "convergence_pct",
          "sql_type": "DOUBLE",
          "comment": "Optimization convergence percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(40.0, 75.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 40.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "design_closure_status",
          "sql_type": "STRING",
          "comment": "Design closure status",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.40 THEN 'On Track' WHEN {status_noise} < 0.65 THEN 'At Risk' WHEN {status_noise} < 0.85 THEN 'Behind Schedule' ELSE 'Blocked' END"
        }
      ],
