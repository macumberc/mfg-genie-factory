{
  "company_name": "SiliconPath Design",
  "industry": "Semiconductor",
  "use_case": "Chip design space exploration and multi-objective optimization",
  "space_title": "SiliconPath - Design Space Simulation \ud83e\uddea",
  "space_description": "**Subindustry:** Semiconductor\n\n**Use case:** Chip Design Space Exploration & PPA Optimization\n\nSiliconPath Design \u2014 pre-silicon EDA analytics covering 20 chip designs across 5 design families (Application Processor, AI Accelerator, RF Modem, IoT Controller, Power Management) on 3nm/5nm/7nm/14nm process nodes. Design Engineering and IP Architecture teams use this space to manage simulation throughput and DRC-clean rates; the VP of Engineering and CTO use it to track PPA closure, design-complete milestones, and which blocks are blocking tapeout.\n\n**Key KPIs**\n- Timing slack (ns) \u2014 worst negative slack; \u22650 means timing closure achieved\n- Dynamic power (mW) \u2014 switching power; critical for mobile/edge SoCs (<500 mW typical)\n- Leakage power (mW) \u2014 static power; gating factor for thermals at 5nm/3nm\n- Die area (mm\u00b2) \u2014 silicon cost driver; advanced nodes target <100 mm\u00b2 for high-volume\n- DRC violations \u2014 design rule check failures; must reach zero before tapeout\n- Pareto front size \u2014 number of optimal PPA tradeoff points discovered\n- Convergence % \u2014 share of optimization runs that closed all constraints; target 80%+\n- Design closure status \u2014 share of designs Blocked vs Complete; tapeout-readiness signal\n\n**Data sources**\n- `simulation_runs` \u2014 daily EDA simulation runs with PPA results and DRC violations\n- `parameter_explorations` \u2014 weekly parameter sweeps (clock, voltage, gate count) with Pareto flags\n- `optimization_results` \u2014 monthly multi-objective optimization summaries and design closure status",
  "schema_basename": "semiconductor_design_sim",
  "tables": [
    {
      "table_name": "simulation_runs",
      "description": "Daily simulation run records capturing timing closure, power estimates, and design rule check results for each chip design variant.",
      "columns": [
        {
          "name": "run_id",
          "sql_type": "STRING",
          "comment": "Unique simulation run identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('SIM-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "run_date",
          "sql_type": "DATE",
          "comment": "Date the simulation was executed",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "design_id",
          "sql_type": "STRING",
          "comment": "Chip design identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "design_name",
          "sql_type": "STRING",
          "comment": "Human-readable chip design name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "design_family",
          "sql_type": "STRING",
          "comment": "Design family grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "target_node_nm",
          "sql_type": "INT",
          "comment": "Target process node in nanometers",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.25 THEN 3 WHEN {status_noise} < 0.50 THEN 5 WHEN {status_noise} < 0.75 THEN 7 ELSE 14 END"
        },
        {
          "name": "timing_slack_ns",
          "sql_type": "DOUBLE",
          "comment": "Worst negative slack in nanoseconds (positive = met timing)",
          "is_dimension": false,
          "generation_expr": "ROUND(-0.5 + {qty_noise} * 1.2, 3)"
        },
        {
          "name": "dynamic_power_mw",
          "sql_type": "DOUBLE",
          "comment": "Estimated dynamic power in milliwatts",
          "is_dimension": false,
          "generation_expr": "ROUND(200.0 + {qty_noise} * 1800.0, 1)"
        },
        {
          "name": "leakage_power_mw",
          "sql_type": "DOUBLE",
          "comment": "Estimated leakage power in milliwatts",
          "is_dimension": false,
          "generation_expr": "ROUND(10.0 + {qty_noise} * 90.0, 2)"
        },
        {
          "name": "die_area_mm2",
          "sql_type": "DOUBLE",
          "comment": "Estimated die area in square millimeters",
          "is_dimension": false,
          "generation_expr": "ROUND(4.0 + {qty_noise} * 96.0, 2)"
        },
        {
          "name": "drc_violations",
          "sql_type": "INT",
          "comment": "Number of design rule check violations",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 50) AS INT)"
        },
        {
          "name": "run_status",
          "sql_type": "STRING",
          "comment": "Simulation completion status",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.65 THEN 'Completed' WHEN {alt_status_noise} < 0.80 THEN 'Timing Fail' WHEN {alt_status_noise} < 0.90 THEN 'DRC Fail' ELSE 'Aborted' END"
        }
      ],
      "seasonal_patterns": {
