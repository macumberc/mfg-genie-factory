          "sql_type": "DOUBLE",
          "comment": "Core supply voltage in volts",
          "is_dimension": false,
          "generation_expr": "ROUND(0.55 + {qty_noise} * 0.45, 3)"
        },
        {
          "name": "gate_count_millions",
          "sql_type": "DOUBLE",
          "comment": "Logic gate count in millions",
          "is_dimension": false,
          "generation_expr": "ROUND(5.0 + {qty_noise} * 495.0, 1)"
        },
        {
          "name": "total_power_mw",
          "sql_type": "DOUBLE",
          "comment": "Total estimated power in milliwatts",
          "is_dimension": false,
          "generation_expr": "ROUND(100.0 + {qty_noise} * 2400.0, 1)"
        },
        {
          "name": "performance_score",
          "sql_type": "DOUBLE",
          "comment": "Normalized performance score (0-100)",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(10.0, 55.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 80.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "pareto_optimal",
          "sql_type": "STRING",
          "comment": "Whether this point is Pareto optimal",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.15 THEN 'Yes' ELSE 'No' END"
        }
