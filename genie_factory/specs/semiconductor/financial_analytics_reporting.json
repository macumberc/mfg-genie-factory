{
  "company_name": "SemiLedger Analytics",
  "industry": "Semiconductor",
  "use_case": "Semiconductor financial analytics, margin analysis, and cost reporting",
  "space_title": "SemiLedger - Financial Analytics & Reporting 💰",
  "space_description": "**Subindustry:** Semiconductor\n\n**Use case:** Semiconductor Financial Analytics, Margin Analysis & Cost Reporting\n\nSemiLedger Analytics — close, planning, and margin analytics across 20 cost centers spanning Fab Operations, R&D Engineering, Sales & Marketing, Quality & Test, and Supply Chain departments. The CFO, Controller, and Finance Business Partners use this space to monitor gross and operating margin, R&D and capex intensity, cost per wafer, and revenue per employee against semiconductor peer benchmarks (leading-edge GM 50–60%, R&D intensity 15–25%, capex intensity 25–35%).\n\n**Key KPIs**\n- Gross margin % — semiconductor industry leading-edge 50–60%, mature analog 40–50%\n- Operating margin % — sustainable target 25–35% at scale\n- R&D intensity % — R&D / revenue; semi industry 15–25%, advanced-logic leaders 20%+\n- Capex intensity — direct-materials and equipment as % of revenue; foundries run 30–35%\n- Cost per wafer (USD) — fully loaded; varies $3k (mature 200mm) to $20k+ (5nm 300mm)\n- Revenue per employee (USD) — productivity benchmark; industry median ~$500k–$1M\n- Budget variance % — absolute variance; >10% = Critical overrun\n- Headcount by department — capacity planning input\n\n**Data sources**\n- `financial_transactions` — daily GL transactions by cost center, GL category, and fiscal quarter\n- `budget_snapshots` — weekly budget vs actual variance with budget health status and headcount\n- `financial_kpi_monthly` — monthly margin, R&D intensity, cost-per-wafer, and revenue-per-employee KPIs",
  "schema_basename": "semiconductor_financial",
  "tables": [
    {
      "table_name": "financial_transactions",
      "description": "Daily financial transaction records capturing revenue, COGS, operating expenses, and capital expenditures across cost centers.",
      "columns": [
        {
          "name": "transaction_id",
          "sql_type": "STRING",
          "comment": "Unique financial transaction identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('FT-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "transaction_date",
          "sql_type": "DATE",
          "comment": "Date the transaction was recorded",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "cost_center_id",
          "sql_type": "STRING",
          "comment": "Cost center identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "cost_center_name",
          "sql_type": "STRING",
          "comment": "Human-readable cost center name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "department",
          "sql_type": "STRING",
          "comment": "Department grouping",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "gl_category",
          "sql_type": "STRING",
          "comment": "General ledger category",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'Revenue' WHEN {status_noise} < 0.50 THEN 'COGS' WHEN {status_noise} < 0.70 THEN 'OpEx' WHEN {status_noise} < 0.85 THEN 'CapEx' ELSE 'Other' END"
        },
        {
          "name": "gl_account",
          "sql_type": "STRING",
          "comment": "Specific GL account",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.12 THEN 'Product Revenue' WHEN {alt_status_noise} < 0.22 THEN 'License Revenue' WHEN {alt_status_noise} < 0.30 THEN 'Service Revenue' WHEN {alt_status_noise} < 0.38 THEN 'Wafer Cost' WHEN {alt_status_noise} < 0.44 THEN 'Packaging Cost' WHEN {alt_status_noise} < 0.50 THEN 'Test Cost' WHEN {alt_status_noise} < 0.56 THEN 'R&D Salaries' WHEN {alt_status_noise} < 0.62 THEN 'R&D Equipment' WHEN {alt_status_noise} < 0.68 THEN 'SG&A' WHEN {alt_status_noise} < 0.73 THEN 'Marketing' WHEN {alt_status_noise} < 0.78 THEN 'Fab Equipment' WHEN {alt_status_noise} < 0.83 THEN 'IT Infrastructure' WHEN {alt_status_noise} < 0.88 THEN 'Facilities' WHEN {alt_status_noise} < 0.93 THEN 'Depreciation' ELSE 'Other Expense' END"
        },
        {
          "name": "amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Transaction amount in USD (positive = credit/revenue, negative = debit/expense)",
          "is_dimension": false,
          "generation_expr": "ROUND(CASE WHEN {alt_status_noise2} < 0.30 THEN 1000.0 + {qty_noise} * 99000.0 ELSE -500.0 - {qty_noise} * 49500.0 END, 2)"
        },
        {
          "name": "currency_code",
          "sql_type": "STRING",
          "comment": "Original transaction currency",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.50 THEN 'USD' WHEN {alt_status_noise3} < 0.70 THEN 'EUR' WHEN {alt_status_noise3} < 0.85 THEN 'TWD' ELSE 'JPY' END"
        },
        {
          "name": "fiscal_quarter",
          "sql_type": "STRING",
          "comment": "Fiscal quarter label",
          "is_dimension": false,
          "generation_expr": "CONCAT('FY', CAST(YEAR(dt) AS STRING), '-Q', CAST(QUARTER(dt) AS STRING))"
        }
      ],
