    {
      "table_name": "defect_detections",
      "description": "Monthly defect detection summaries per recipe and process step, tracking defect types, density, and kill ratio estimates.",
      "columns": [
        {
          "name": "detection_id",
          "sql_type": "STRING",
          "comment": "Unique defect detection record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('DD-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "detection_month",
          "sql_type": "DATE",
          "comment": "Month of defect detection summary",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', dt)"
        },
        {
          "name": "recipe_id",
          "sql_type": "STRING",
          "comment": "Process recipe identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "recipe_name",
          "sql_type": "STRING",
          "comment": "Human-readable recipe name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "process_step",
          "sql_type": "STRING",
          "comment": "Process step category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "defect_type",
          "sql_type": "STRING",
          "comment": "Classification of defect type",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.20 THEN 'Particle' WHEN {status_noise} < 0.38 THEN 'Scratch' WHEN {status_noise} < 0.52 THEN 'Pattern Defect' WHEN {status_noise} < 0.65 THEN 'Residue' WHEN {status_noise} < 0.78 THEN 'Void' WHEN {status_noise} < 0.90 THEN 'Bridge' ELSE 'Crack' END"
        },
        {
          "name": "defect_density_per_cm2",
          "sql_type": "DOUBLE",
          "comment": "Defect density per square centimeter",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(0.01, 0.40 - ({qty_noise} * 0.35)), 4)"
        },
        {
          "name": "kill_ratio_pct",
          "sql_type": "DOUBLE",
          "comment": "Estimated percentage of defects that are yield-killing",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(95.0, GREATEST(5.0, 40.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 60.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "wafers_inspected",
          "sql_type": "INT",
          "comment": "Number of wafers inspected in the month",
          "is_dimension": false,
          "generation_expr": "CAST(50 + FLOOR({qty_noise} * 450) AS INT)"
        },
        {
          "name": "total_defects_found",
          "sql_type": "INT",
          "comment": "Total defects found across inspections",
          "is_dimension": false,
          "generation_expr": "CAST(10 + FLOOR({qty_noise} * 990) AS INT)"
        }
      ],
