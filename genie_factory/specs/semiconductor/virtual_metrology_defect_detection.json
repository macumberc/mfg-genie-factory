    {
      "table_name": "metrology_predictions",
      "description": "Weekly virtual metrology prediction snapshots comparing ML model predictions against actual measurements for each process recipe.",
      "columns": [
        {
          "name": "prediction_id",
          "sql_type": "STRING",
          "comment": "Unique prediction record identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('VP-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "snapshot_date",
          "sql_type": "DATE",
          "comment": "Week-ending date of prediction batch",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('week', dt)"
        },
        {
          "name": "recipe_id",
          "sql_type": "STRING",
          "comment": "Process recipe identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "recipe_name",
          "sql_type": "STRING",
          "comment": "Human-readable recipe name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "process_step",
          "sql_type": "STRING",
          "comment": "Process step category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "predicted_thickness_nm",
          "sql_type": "DOUBLE",
          "comment": "Model-predicted film thickness in nm",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1.0, 50.0 + ({qty_noise} - 0.5) * 35.0), 2)"
        },
        {
          "name": "actual_thickness_nm",
          "sql_type": "DOUBLE",
          "comment": "Actual measured film thickness in nm",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1.0, 50.0 + ({qty_noise} - 0.5) * 40.0 + ({status_noise} - 0.5) * 5.0), 2)"
        },
        {
          "name": "prediction_error_pct",
          "sql_type": "DOUBLE",
          "comment": "Absolute prediction error as percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(0.1, ({qty_noise} * {seasonal_mult}) * 8.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "model_version",
          "sql_type": "STRING",
          "comment": "Virtual metrology model version",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'vm-2.0' WHEN {status_noise} < 0.65 THEN 'vm-2.1' ELSE 'vm-2.2' END"
        },
        {
          "name": "confidence_score",
          "sql_type": "DOUBLE",
          "comment": "Model prediction confidence (0-1)",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(0.99, GREATEST(0.50, 0.80 + (({qty_noise} * {seasonal_mult}) - 0.5) * 0.30)), 3)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "wafer_count",
          "sql_type": "INT",
          "comment": "Number of wafers in prediction batch",
          "is_dimension": false,
          "generation_expr": "CAST(10 + FLOOR({qty_noise} * 90) AS INT)"
        }
      ],
