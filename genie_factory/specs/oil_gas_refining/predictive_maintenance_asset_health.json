{
  "company_name": "RefineGuard Systems",
  "industry": "Oil & Gas Refining",
  "use_case": "Predictive maintenance and asset health monitoring for refinery equipment",
  "space_title": "RefineGuard Systems - Predictive Maintenance & Asset Health 🔧",
  "space_description": "**Scenario:** You run reliability across 20 critical refinery assets and your predictive program is supposed to keep mechanical availability above the Solomon top-quartile 96% mark, but a string of unplanned trips has eaten throughput this quarter. The next turnaround window is short and you can only address a few assets. Which assets do you prioritize before one of them fails unplanned and takes a unit down?\n\n**Questions:**\n\n1. Showcase the different visualization options with interesting aspects of the dataset (agent)\n2. What is the current asset composition by equipment type and process unit, and the average health score and availability of each? (agent)\n3. Which equipment has predicted remaining useful life under 30 days and the worst MTBF, making it the top intervention priority? (agent)",
  "schema_basename": "og_refining_pred_maint",
  "tables": [
    {
      "table_name": "sensor_readings",
      "description": "Real-time sensor telemetry from refinery equipment including temperature, pressure, vibration, and flow measurements.",
      "columns": [
        {
          "name": "reading_id",
          "sql_type": "STRING",
          "comment": "Unique sensor reading identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('SR-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.equipment_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "reading_timestamp",
          "sql_type": "DATE",
          "comment": "Date of the sensor reading",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "equipment_id",
          "sql_type": "STRING",
          "comment": "Refinery equipment identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "equipment_name",
          "sql_type": "STRING",
          "comment": "Equipment name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "equipment_type",
          "sql_type": "STRING",
          "comment": "Equipment type: Pump, Compressor, Heat Exchanger, Reactor, Column, Furnace",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "process_unit",
          "sql_type": "STRING",
          "comment": "Refinery process unit name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "sensor_type",
          "sql_type": "STRING",
          "comment": "Sensor measurement type",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.10 THEN 'Vibration' WHEN {status_noise} < 0.20 THEN 'Temperature' WHEN {status_noise} < 0.30 THEN 'Pressure' WHEN {status_noise} < 0.40 THEN 'Flow Rate' WHEN {status_noise} < 0.50 THEN 'Motor Current' WHEN {status_noise} < 0.58 THEN 'Bearing Temp' WHEN {status_noise} < 0.66 THEN 'Corrosion Rate' WHEN {status_noise} < 0.74 THEN 'Thickness' WHEN {status_noise} < 0.82 THEN 'Acoustic Emission' WHEN {status_noise} < 0.90 THEN 'RPM' ELSE 'Differential Pressure' END"
        },
        {
          "name": "sensor_value",
          "sql_type": "DOUBLE",
          "comment": "Raw sensor measurement value",
          "is_dimension": false,
          "generation_expr": "ROUND(20.0 + {qty_noise} * 480.0, 2)"
        },
        {
          "name": "health_score",
          "sql_type": "DOUBLE",
          "comment": "AI-computed equipment health score 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(0.0, 70.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 60.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "alert_level",
          "sql_type": "STRING",
          "comment": "Alert level: Normal, Advisory, Warning, Alarm, Trip",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.55 THEN 'Normal' WHEN {alt_status_noise} < 0.75 THEN 'Advisory' WHEN {alt_status_noise} < 0.88 THEN 'Warning' WHEN {alt_status_noise} < 0.96 THEN 'Alarm' ELSE 'Trip' END"
        },
        {
          "name": "predicted_rul_days",
          "sql_type": "INT",
          "comment": "Predicted remaining useful life in days",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(1, 10 + FLOOR(({qty_noise} * {seasonal_mult}) * 300)) AS INT)",
          "seasonal_amplitude": 0.15
        }
      ],
      "seasonal_patterns": {
        "Crude Distillation": {
          "3,4,9,10": 0.05
        },
        "Catalytic Cracking": {
