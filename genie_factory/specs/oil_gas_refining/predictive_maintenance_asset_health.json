  "benchmarks": [
    {
      "question": "What is the alarm trip count by reading timestamp?",
      "sql_lines": [
        "SELECT reading_timestamp, MEASURE(alarm_trip_count) AS alarm_trip_count",
        "FROM {fqn}.sensor_readings_metrics",
        "GROUP BY ALL",
        "ORDER BY alarm_trip_count DESC"
      ]
    },
    {
      "question": "Which process units have the highest average asset health score?",
      "sql_lines": [
        "SELECT process_unit, AVG(avg_health_score) AS average_health_score",
        "FROM {fqn}.equipment_health_monthly",
        "WHERE process_unit IS NOT NULL AND avg_health_score IS NOT NULL",
        "GROUP BY process_unit",
        "ORDER BY average_health_score DESC"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', event_date) AS event_month, COUNT(DISTINCT event_id) AS distinct_transactions",
        "FROM {fqn}.maintenance_events",
        "WHERE event_date IS NOT NULL AND event_id IS NOT NULL",
        "GROUP BY event_month",
        "ORDER BY event_month"
      ]
    },
    {
      "question": "How has highest downtime hours changed over time?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', event_date) AS month, MEASURE(max_downtime_hours) AS max_downtime_hours",
        "FROM {fqn}.maintenance_events_metrics",
        "GROUP BY ALL",
        "ORDER BY month"
      ]
    },
    {
      "question": "Which equipments have the highest total raw sensor measurement value?",
      "sql_lines": [
        "SELECT equipment_id, MEASURE(total_sensor_value) AS total_sensor_value",
        "FROM {fqn}.sensor_readings_metrics",
        "GROUP BY ALL",
        "ORDER BY total_sensor_value DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which equipments have the highest average repair cost per event?",
      "sql_lines": [
        "SELECT equipment_id, MEASURE(avg_repair_cost_usd) AS avg_repair_cost_usd",
        "FROM {fqn}.maintenance_events_metrics",
        "WHERE equipment_id IS NOT NULL",
        "GROUP BY ALL",
        "HAVING avg_repair_cost_usd IS NOT NULL",
        "ORDER BY avg_repair_cost_usd DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which equipment types have the highest average health score for the month?",
      "sql_lines": [
        "SELECT equipment_type, AVG(avg_health_score) AS avg_metric",
        "FROM {fqn}.equipment_health_monthly",
        "GROUP BY 1",
        "ORDER BY avg_metric DESC",
        "LIMIT 10"
      ]
    }
