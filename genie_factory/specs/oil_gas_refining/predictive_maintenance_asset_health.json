    {
      "table_name": "equipment_health_monthly",
      "description": "Monthly aggregated equipment health KPIs including MTBF, MTTR, availability, and failure prediction accuracy.",
      "columns": [
        {
          "name": "snapshot_id",
          "sql_type": "STRING",
          "comment": "Unique monthly snapshot identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('EH-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.equipment_id) + 30000 AS STRING), 6, '0'))"
        },
        {
          "name": "snapshot_month",
          "sql_type": "DATE",
          "comment": "First day of the snapshot month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "equipment_id",
          "sql_type": "STRING",
          "comment": "Equipment identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "equipment_type",
          "sql_type": "STRING",
          "comment": "Equipment type",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "process_unit",
          "sql_type": "STRING",
          "comment": "Refinery process unit",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "avg_health_score",
          "sql_type": "DOUBLE",
          "comment": "Average health score for the month",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(30.0, 72.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 44.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "mtbf_days",
          "sql_type": "DOUBLE",
          "comment": "Mean time between failures in days",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(5.0, 25.0 + ({qty_noise} * {seasonal_mult}) * 120.0), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "mttr_hours",
          "sql_type": "DOUBLE",
          "comment": "Mean time to repair in hours",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1.0, 3.0 + ({qty_noise} * {seasonal_mult}) * 45.0), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "availability_pct",
          "sql_type": "DOUBLE",
          "comment": "Equipment availability percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(82.0, 94.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 12.0)), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "prediction_accuracy_pct",
          "sql_type": "DOUBLE",
          "comment": "ML prediction accuracy percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.0, GREATEST(50.0, 75.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 30.0)), 1)",
          "seasonal_amplitude": 0.15
        }
      ],
