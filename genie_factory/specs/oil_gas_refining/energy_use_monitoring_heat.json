  "metric_views": [
    {
      "view_name": "energy_readings_metrics",
      "source_table": "energy_readings",
      "dimensions": [
        {
          "name": "reading_date",
          "expr": "reading_date"
        },
        {
          "name": "exchanger_id",
          "expr": "exchanger_id"
        },
        {
          "name": "equipment_category",
          "expr": "equipment_category"
        },
        {
          "name": "process_unit",
          "expr": "process_unit"
        }
      ],
      "measures": [
        {
          "name": "total_energy_mmbtu",
          "expr": "SUM(energy_consumption_mmbtu)",
          "comment": "Total energy consumption MMBTU"
        },
        {
          "name": "avg_thermal_efficiency",
          "expr": "AVG(thermal_efficiency_pct)",
          "comment": "Average thermal efficiency"
        },
        {
          "name": "avg_fouling_factor",
          "expr": "AVG(fouling_factor)",
          "comment": "Average fouling factor"
        },
        {
          "name": "avg_heat_duty",
          "expr": "AVG(heat_duty_mmbtu_hr)",
          "comment": "Average heat duty MMBTU/hr"
        },
        {
          "name": "total_inlet_temp_f",
          "expr": "SUM(inlet_temp_f)",
          "comment": "Total inlet temp f"
        },
        {
          "name": "total_outlet_temp_f",
          "expr": "SUM(outlet_temp_f)",
          "comment": "Total outlet temp f"
        },
        {
          "name": "max_energy_consumption_mmbtu",
          "expr": "MAX(energy_consumption_mmbtu)",
          "comment": "Maximum energy consumption mmbtu"
        }
      ]
    },
