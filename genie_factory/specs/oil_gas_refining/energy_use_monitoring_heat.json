  "benchmarks": [
    {
      "question": "What has been the peak energy consumption in mmbtu each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', reading_date) AS month, MAX(energy_consumption_mmbtu) AS peak_energy_consumption_mmbtu",
        "FROM {fqn}.energy_readings",
        "WHERE reading_date IS NOT NULL AND energy_consumption_mmbtu IS NOT NULL",
        "GROUP BY DATE_TRUNC('month', reading_date)",
        "ORDER BY month"
      ]
    },
