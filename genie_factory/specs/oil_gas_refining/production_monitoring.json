{
  "company_name": "RefineOps Central",
  "industry": "Oil & Gas Refining",
  "use_case": "Production monitoring and throughput optimization for refinery operations",
  "space_title": "RefineOps Central - Production Monitoring 📊",
  "space_description": "**Scenario:** You are the COO watching 20 process units, and refinery-wide utilization is hovering below the 92% top-quartile benchmark while a few conversion units quietly drag down yield and margin per barrel. Crude is committed and the slate is set, so every idle hour and every lost yield point is margin walking out the gate. Which underperforming units are costing you the most throughput and margin, and where do you push severity next?\n\n**Questions:**\n\n1. Showcase the different visualization options with interesting aspects of the dataset (agent)\n2. What is the current production composition by refinery section and unit, and the average utilization of each? (agent)\n3. Which units are running below 70% utilization with the most unplanned downtime hours, and which are below the $8/bbl gross margin threshold? (agent)",
  "schema_basename": "og_refining_production",
  "tables": [
    {
      "table_name": "throughput_readings",
      "description": "Daily throughput readings from refinery process units.",
      "columns": [
        {
          "name": "reading_id",
          "sql_type": "STRING",
          "comment": "Unique reading ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('TR-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.unit_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "reading_date",
          "sql_type": "DATE",
          "comment": "Reading date",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "unit_id",
          "sql_type": "STRING",
          "comment": "Process unit ID",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "unit_name",
          "sql_type": "STRING",
          "comment": "Process unit name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_stream",
          "sql_type": "STRING",
          "comment": "Product stream",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "refinery_section",
          "sql_type": "STRING",
          "comment": "Section: Primary, Conversion, Treating, Blending, Utilities, Gas Processing, Residue",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "throughput_bpd",
          "sql_type": "DOUBLE",
          "comment": "Throughput in barrels per day",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(500.0, 5000.0 + ({qty_noise} * {seasonal_mult}) * 45000.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "utilization_pct",
          "sql_type": "DOUBLE",
          "comment": "Unit utilization percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(100.0, GREATEST(50.0, 82.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 30.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "yield_pct",
          "sql_type": "DOUBLE",
          "comment": "Product yield percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(LEAST(99.0, GREATEST(50.0, 80.0 + (({qty_noise} * {seasonal_mult}) - 0.5) * 30.0)), 1)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "feed_quality_api",
          "sql_type": "DOUBLE",
          "comment": "Feed API gravity",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(15.0, 25.0 + {qty_noise} * 20.0), 1)"
        },
        {
          "name": "status",
          "sql_type": "STRING",
          "comment": "Status: Running, Reduced Rate, Shutdown, Startup",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.75 THEN 'Running' WHEN {status_noise} < 0.85 THEN 'Reduced Rate' WHEN {status_noise} < 0.94 THEN 'Shutdown' ELSE 'Startup' END"
        }
      ],
      "seasonal_patterns": {
        "Primary": {
          "3,4,9,10": 0.05
        }
