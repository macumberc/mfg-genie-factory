          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique KPI identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('RLK-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.cost_center_id) + 30000 AS STRING), 6, '0'))"
