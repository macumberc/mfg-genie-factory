          "is_dimension": false,
          "generation_expr": "CONCAT('RLT-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.cost_center_id) + 100000 AS STRING), 8, '0'))"
        },
        {
          "name": "transaction_date",
          "sql_type": "DATE",
          "comment": "Transaction date",
          "is_dimension": false,
