        {
          "name": "account_type",
          "sql_type": "STRING",
          "comment": "Account: Revenue, OPEX, CAPEX, Depreciation, G&A",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'Revenue' WHEN {status_noise} < 0.55 THEN 'OPEX' WHEN {status_noise} < 0.72 THEN 'CAPEX' WHEN {status_noise} < 0.85 THEN 'Depreciation' ELSE 'G&A' END"
        },
        {
          "name": "amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Transaction amount USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1000.0, {qty_noise} * 5000000.0), 2)"
        },
        {
          "name": "budget_amount_usd",
          "sql_type": "DOUBLE",
          "comment": "Budgeted amount USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(1000.0, {qty_noise} * 5200000.0), 2)"
        },
        {
          "name": "gl_category",
          "sql_type": "STRING",
          "comment": "GL category",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.20 THEN 'Operations' WHEN {alt_status_noise} < 0.40 THEN 'Maintenance' WHEN {alt_status_noise} < 0.58 THEN 'Labor' WHEN {alt_status_noise} < 0.74 THEN 'Materials' WHEN {alt_status_noise} < 0.88 THEN 'Utilities' ELSE 'Admin' END"
        }
