          "comment": "Region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "operating_margin_pct",
          "sql_type": "DOUBLE",
          "comment": "Operating margin percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-10.0, -10.0 + {qty_noise} * 55.0), 2)"
        },
        {
          "name": "roic_pct",
          "sql_type": "DOUBLE",
          "comment": "Return on invested capital",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-5.0, 3.0 + {qty_noise} * 17.0), 2)"
        },
        {
          "name": "cost_per_unit",
          "sql_type": "DOUBLE",
          "comment": "Operating cost per unit of output",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(2.0, 5.0 + {qty_noise} * 20.0), 2)"
        },
        {
          "name": "headcount",
          "sql_type": "INT",
          "comment": "Full-time equivalent headcount",
          "is_dimension": false,
          "generation_expr": "CAST(30 + FLOOR({qty_noise} * 270) AS INT)"
        }
      ],
