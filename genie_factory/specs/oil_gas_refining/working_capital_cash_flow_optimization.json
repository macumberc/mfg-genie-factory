          "is_dimension": false,
          "generation_expr": "ROUND(-3000000.0 + {qty_noise} * 30000000.0, 2)"
        },
        {
          "name": "cash_conversion_cycle_days",
          "sql_type": "DOUBLE",
          "comment": "Cash conversion cycle days",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-10.0, 15.0 + {qty_noise} * 60.0), 1)"
        },
        {
          "name": "current_ratio",
          "sql_type": "DOUBLE",
          "comment": "Current ratio",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(0.5, 0.5 + ({qty_noise} * {seasonal_mult}) * 2.5), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "net_debt_usd",
          "sql_type": "DOUBLE",
          "comment": "Net debt USD",
          "is_dimension": false,
          "generation_expr": "ROUND(GREATEST(-30000000.0, {qty_noise} * 200000000.0), 2)"
        }
