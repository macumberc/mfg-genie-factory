        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "budget_at_completion_usd",
          "sql_type": "DOUBLE",
          "comment": "Estimated budget at completion USD",
          "is_dimension": false,
          "generation_expr": "ROUND(1000000.0 + ({qty_noise} * 19000000.0), 2)"
        },
        {
          "name": "actual_cost_to_date_usd",
          "sql_type": "DOUBLE",
          "comment": "Actual cost to date USD",
          "is_dimension": false,
          "generation_expr": "ROUND(200000.0 + ({qty_noise} * 12800000.0), 2)"
        },
        {
          "name": "earned_value_usd",
          "sql_type": "DOUBLE",
          "comment": "Earned value USD",
          "is_dimension": false,
          "generation_expr": "ROUND(250000.0 + ({qty_noise} * 11750000.0), 2)"
        },
        {
          "name": "schedule_variance_days",
          "sql_type": "INT",
          "comment": "Schedule variance in days (neg=behind)",
          "is_dimension": false,
          "generation_expr": "CAST(({qty_noise} - 0.4) * 60 AS INT)"
        },
        {
          "name": "risk_level",
          "sql_type": "STRING",
          "comment": "Risk: Low, Medium, High, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.08 THEN 'Critical' WHEN {status_noise} < 0.22 THEN 'High' WHEN {status_noise} < 0.48 THEN 'Medium' ELSE 'Low' END"
        }
      ],
