        },
        {
          "name": "forecast_month",
          "sql_type": "DATE",
          "comment": "Forecast month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "project_id",
          "sql_type": "STRING",
          "comment": "Project ID",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "project_type",
