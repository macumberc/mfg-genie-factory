          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.05 THEN 'Withdrawn' WHEN {status_noise} < 0.25 THEN 'Pending' WHEN {status_noise} < 0.55 THEN 'Lost' ELSE 'Won' END"
