          "expr": "project_type"
        },
        {
          "name": "region",
          "expr": "region"
        }
      ],
      "measures": [
        {
          "name": "total_bids_submitted",
          "expr": "SUM(bids_submitted)",
          "comment": "Total bids submitted"
        },
        {
          "name": "total_bids_won",
          "expr": "SUM(bids_won)",
          "comment": "Total bids won"
        },
        {
          "name": "total_pipeline",
          "expr": "SUM(pipeline_value_usd)",
          "comment": "Total pipeline value"
        },
        {
          "name": "avg_estimate_accuracy",
          "expr": "AVG(estimate_accuracy_pct)",
          "comment": "Avg estimate accuracy"
