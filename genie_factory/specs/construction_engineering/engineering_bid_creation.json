  "metric_views": [
    {
      "view_name": "bid_kpi_monthly",
      "source_table": "projects",
      "dimensions": [
        {
          "name": "bid_date",
          "expr": "bid_date"
        },
        {
          "name": "project_type",
          "expr": "project_type"
        },
        {
          "name": "region",
          "expr": "region"
        },
        {
          "name": "bid_result",
          "expr": "bid_result"
        }
      ],
      "measures": [
        {
          "name": "total_bid_amount",
          "expr": "SUM(bid_amount_usd)",
          "comment": "Total bid amount USD"
        },
        {
          "name": "total_estimated_cost",
          "expr": "SUM(estimated_cost_usd)",
          "comment": "Total estimated cost"
        },
        {
          "name": "avg_target_margin",
          "expr": "AVG(target_margin_pct)",
          "comment": "Avg target margin"
        },
        {
          "name": "bid_count",
          "expr": "COUNT(DISTINCT bid_id)",
          "comment": "Total bids submitted"
        },
        {
          "name": "won_count",
          "expr": "COUNT(DISTINCT CASE WHEN bid_result = 'Won' THEN bid_id END)",
          "comment": "Bids won count"
        },
        {
          "name": "unique_project_count",
          "expr": "COUNT(DISTINCT project_id)",
          "comment": "Number of distinct projects"
        },
        {
          "name": "max_estimated_cost",
          "expr": "MAX(estimated_cost_usd)",
          "comment": "Maximum estimated cost usd"
        }
      ]
    },
    {
      "view_name": "pipeline_kpi_monthly",
      "source_table": "cost_estimate_snapshots",
      "dimensions": [
