          "name": "yield_pct",
          "sql_type": "DOUBLE",
          "comment": "Product yield percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(15 + ({qty_noise} * {seasonal_mult}) * 80, 2)",
          "seasonal_amplitude": 0.15
        },
        {
