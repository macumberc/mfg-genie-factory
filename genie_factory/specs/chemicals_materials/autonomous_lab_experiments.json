  "benchmarks": [
    {
      "question": "What is the monthly trend in passed experiments count?",
      "sql_lines": [
        "SELECT run_date, MEASURE(passed_experiments) AS passed_experiments",
        "FROM {fqn}.experiment_runs_metrics",
        "GROUP BY ALL",
        "ORDER BY run_date"
      ]
    },
    {
      "question": "How many distinct transactions appeared each month?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', run_date) AS month, COUNT(DISTINCT transaction) AS distinct_count",
        "FROM {fqn}.experiment_runs",
        "GROUP BY 1",
        "ORDER BY 1"
      ]
    },
    {
      "question": "What has been the peak number of experiments run in the month each month?",
      "sql_lines": [
        "SELECT report_month, MEASURE(max_experiments_run) AS max_experiments_run",
        "FROM {fqn}.optimization_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY report_month"
      ]
    },
    {
      "question": "Which formulations have the best average reaction temperature in celsius?",
      "sql_lines": [
        "SELECT formulation_name, AVG(temperature_c) AS avg_metric",
        "FROM {fqn}.experiment_runs",
        "GROUP BY 1",
        "ORDER BY avg_metric DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which category: catalysts, coatings, polymers, pharmaceuticals, nanomaterialss have the best average reaction pressure in bar?",
      "sql_lines": [
        "SELECT formulation_category, AVG(pressure_bar) AS avg_metric",
        "FROM {fqn}.experiment_runs",
        "GROUP BY 1",
        "ORDER BY avg_metric DESC",
        "LIMIT 10"
      ]
    },
    {
      "question": "Which formulations have the best model-predicted yield percentage?",
      "sql_lines": [
        "SELECT formulation_name, AVG(predicted_yield_pct) AS avg_predicted_yield_pct",
