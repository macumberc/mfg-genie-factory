  "metric_views": [
    {
      "view_name": "experiment_runs_metrics",
      "source_table": "experiment_runs",
      "dimensions": [
        {
          "name": "run_date",
          "expr": "run_date"
        },
        {
          "name": "formulation_category",
          "expr": "formulation_category"
        },
        {
          "name": "lab_facility",
          "expr": "lab_facility"
        },
        {
          "name": "run_result",
          "expr": "run_result"
        }
      ],
      "measures": [
        {
          "name": "total_experiments",
          "expr": "COUNT(DISTINCT run_id)",
          "comment": "Total experiment runs"
        },
        {
          "name": "passed_experiments",
          "expr": "COUNT(DISTINCT CASE WHEN run_result = 'Pass' THEN run_id END)",
          "comment": "Experiments that passed"
        },
        {
          "name": "avg_yield_pct",
          "expr": "AVG(yield_pct)",
          "comment": "Average product yield percentage"
        },
        {
          "name": "avg_purity_pct",
          "expr": "AVG(purity_pct)",
          "comment": "Average product purity percentage"
        },
        {
          "name": "avg_reaction_time_minutes",
          "expr": "AVG(reaction_time_minutes)",
          "comment": "Average reaction time in minutes"
        },
        {
          "name": "max_yield_pct",
          "expr": "MAX(yield_pct)",
          "comment": "Maximum yield achieved"
        },
        {
          "name": "total_temperature_c",
          "expr": "SUM(temperature_c)",
          "comment": "Total temperature c"
        },
        {
          "name": "total_pressure_bar",
          "expr": "SUM(pressure_bar)",
          "comment": "Total pressure bar"
        },
        {
          "name": "unique_formulation_count",
          "expr": "COUNT(DISTINCT formulation_id)",
          "comment": "Number of distinct formulations"
        },
        {
          "name": "max_temperature_c",
          "expr": "MAX(temperature_c)",
          "comment": "Maximum temperature c"
        }
      ]
    },
