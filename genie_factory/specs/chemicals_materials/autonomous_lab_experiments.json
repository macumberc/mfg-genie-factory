          "sql_type": "DOUBLE",
          "comment": "Product purity percentage",
          "is_dimension": false,
          "generation_expr": "ROUND(70 + ({qty_noise} * {seasonal_mult}) * 29.5, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "run_result",
          "sql_type": "STRING",
          "comment": "Result: Pass, Fail, Inconclusive",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.12 THEN 'Fail' WHEN {alt_status_noise} < 0.20 THEN 'Inconclusive' ELSE 'Pass' END"
        }
      ],
