    {
      "table_name": "traceability_monthly",
      "description": "Monthly traceability KPIs per product including recall readiness, lot traceability score, supplier audit status, and genealogy completeness.",
      "columns": [
        {
          "name": "kpi_id",
          "sql_type": "STRING",
          "comment": "Unique monthly KPI record ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('TKP-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "report_month",
          "sql_type": "DATE",
          "comment": "First day of reporting month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', dt)"
        },
        {
          "name": "product_id",
          "sql_type": "STRING",
          "comment": "Product identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_name",
          "sql_type": "STRING",
          "comment": "Product name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "lots_produced",
          "sql_type": "INT",
          "comment": "Number of lots produced in the month",
          "is_dimension": false,
          "generation_expr": "CAST(5 + FLOOR({qty_noise} * 35) AS INT)"
        },
        {
          "name": "lots_with_full_genealogy",
          "sql_type": "INT",
          "comment": "Lots with complete material genealogy records",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR((5 + {qty_noise} * 35) * (0.80 + {qty_noise} * 0.19)) AS INT)"
        },
        {
          "name": "traceability_score_pct",
          "sql_type": "DOUBLE",
          "comment": "Traceability completeness score (0-100)",
          "is_dimension": false,
          "generation_expr": "ROUND(70 + ({qty_noise} * {seasonal_mult}) * 29, 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "recall_readiness_hours",
          "sql_type": "DOUBLE",
          "comment": "Estimated hours to complete a mock recall",
          "is_dimension": false,
          "generation_expr": "ROUND(2 + {qty_noise} * 46, 1)"
        },
        {
          "name": "supplier_audits_completed",
          "sql_type": "INT",
          "comment": "Number of supplier audits completed in month",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 5) AS INT)"
        },
        {
          "name": "quality_holds_count",
          "sql_type": "INT",
          "comment": "Lots placed on quality hold in the month",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 4) AS INT)"
        }
      ],
