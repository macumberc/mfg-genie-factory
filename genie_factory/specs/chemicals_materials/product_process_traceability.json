{
  "company_name": "TraceCore Materials",
  "industry": "Chemicals & Materials",
  "use_case": "Product and process traceability for chemical manufacturing",
  "space_title": "TraceCore Materials - Product & Process Traceability 📋",
  "space_description": "**Subindustry:** Chemicals & Materials\n\n**Use case:** Product & Process Traceability\n\nTraceCore Materials — end-to-end lot genealogy, supplier provenance, and recall-readiness analytics across 20 products (resins, pigments, catalysts, surfactants, intermediates) and 5 production facilities. The Quality Director uses this space to defend REACH / GHS / TSCA compliance audits (responsible-care audits typically require lot trace in < 4 hours); the Supply Chain VP tracks supplier audit cadence and held-lot exposure; the CFO monitors recalled / quarantined inventory as direct write-down risk.\n\n**Key KPIs**\n- Traceability score (%) — completeness of lot genealogy records; target ≥ 95%\n- Recall readiness (hours) — time to trace a lot end-to-end; regulatory target < 4 hours\n- Quality pass rate (%) — share of production events passing QC; target ≥ 95%\n- Lots with full genealogy / lots produced — audit-readiness indicator\n- Quality holds count — held-inventory exposure and working-capital lock\n- Supplier audits completed — supply-chain compliance cadence\n- Process step yield (output_kg / input_kg) — material efficiency by step\n- Quarantined / recalled lot count — direct write-down and customer-notification trigger\n\n**Data sources**\n- `production_events` — daily process-step records with lot, supplier, input/output kg, QC result\n- `lot_tracking_snapshots` — weekly lot status, downstream customers, shelf life, storage temp\n- `traceability_monthly` — monthly rollups: lots produced, genealogy completeness, recall hours, supplier audits",
  "schema_basename": "product_traceability",
  "tables": [
    {
      "table_name": "production_events",
      "description": "Individual production event records capturing process steps, lot numbers, input materials, equipment, and quality checkpoints.",
      "columns": [
        {
          "name": "event_id",
          "sql_type": "STRING",
          "comment": "Unique production event identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('PEV-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "event_date",
          "sql_type": "DATE",
          "comment": "Date event occurred",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "product_id",
          "sql_type": "STRING",
          "comment": "Product identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_name",
          "sql_type": "STRING",
          "comment": "Product name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Category: Resins, Pigments, Catalysts, Surfactants, Intermediates",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "lot_number",
          "sql_type": "STRING",
          "comment": "Production lot number",
          "is_dimension": false,
          "generation_expr": "CONCAT('LOT-', LPAD(CAST(FLOOR({qty_noise} * 9999) AS STRING), 4, '0'))"
        },
        {
          "name": "facility_id",
          "sql_type": "STRING",
          "comment": "Production facility",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.20 THEN 'FAC-TX' WHEN {status_noise} < 0.40 THEN 'FAC-OH' WHEN {status_noise} < 0.60 THEN 'FAC-NJ' WHEN {status_noise} < 0.80 THEN 'FAC-CA' ELSE 'FAC-GA' END"
        },
        {
          "name": "process_step",
          "sql_type": "STRING",
          "comment": "Process step: Mixing, Reaction, Purification, Drying, Packaging",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.22 THEN 'Mixing' WHEN {alt_status_noise} < 0.44 THEN 'Reaction' WHEN {alt_status_noise} < 0.62 THEN 'Purification' WHEN {alt_status_noise} < 0.80 THEN 'Drying' ELSE 'Packaging' END"
        },
        {
          "name": "supplier_id",
          "sql_type": "STRING",
          "comment": "Raw material supplier",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.15 THEN 'SUP-01' WHEN {alt_status_noise2} < 0.30 THEN 'SUP-02' WHEN {alt_status_noise2} < 0.45 THEN 'SUP-03' WHEN {alt_status_noise2} < 0.60 THEN 'SUP-04' WHEN {alt_status_noise2} < 0.75 THEN 'SUP-05' WHEN {alt_status_noise2} < 0.88 THEN 'SUP-06' ELSE 'SUP-07' END"
        },
        {
          "name": "input_quantity_kg",
          "sql_type": "DOUBLE",
          "comment": "Input material quantity in kg",
          "is_dimension": false,
          "generation_expr": "ROUND(50 + {qty_noise} * 4950, 1)"
        },
        {
          "name": "output_quantity_kg",
          "sql_type": "DOUBLE",
          "comment": "Output product quantity in kg",
          "is_dimension": false,
          "generation_expr": "ROUND((50 + {qty_noise} * 4950) * (0.80 + {qty_noise} * 0.18), 1)"
        },
        {
          "name": "quality_check_result",
          "sql_type": "STRING",
          "comment": "Quality checkpoint result: Pass, Fail, Hold",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.05 THEN 'Fail' WHEN {alt_status_noise3} < 0.12 THEN 'Hold' ELSE 'Pass' END"
        }
      ],
