        },
        {
          "name": "lot_status",
          "sql_type": "STRING",
          "comment": "Lot status: Released, Quarantine, Shipped, Expired, Recalled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.02 THEN 'Recalled' WHEN {status_noise} < 0.06 THEN 'Expired' WHEN {status_noise} < 0.15 THEN 'Quarantine' WHEN {status_noise} < 0.50 THEN 'Shipped' ELSE 'Released' END"
        },
        {
          "name": "quantity_on_hand_kg",
          "sql_type": "DOUBLE",
          "comment": "Quantity remaining in lot in kg",
          "is_dimension": false,
          "generation_expr": "ROUND(100 + {qty_noise} * 9900, 1)"
        },
        {
          "name": "downstream_customers",
          "sql_type": "INT",
          "comment": "Number of downstream customers who received this lot",
          "is_dimension": false,
          "generation_expr": "CAST(1 + FLOOR({qty_noise} * 19) AS INT)"
        },
        {
          "name": "shelf_life_remaining_days",
          "sql_type": "INT",
          "comment": "Estimated shelf life remaining in days",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 365) AS INT)"
        },
        {
