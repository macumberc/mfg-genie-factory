{
  "company_name": "PureChem Analytics",
  "industry": "Chemicals & Materials",
  "use_case": "Quality event tracking and root cause analysis for chemical manufacturing",
  "space_title": "PureChem Analytics - Quality Event Root Cause Analysis 🔍",
  "space_description": "**Subindustry:** Chemicals & Materials\n\n**Use case:** Quality Event Tracking & Root Cause Analysis\n\nPureChem Analytics — quality event, deviation, and CAPA analytics across 20 chemicals (acids, bases, solvents, polymers, specialty) and 6 production lines. The Quality Director uses this space to manage deviation aging, CAPA effectiveness, and audit readiness; the Plant Manager investigates equipment- vs. process- vs. material-driven root causes; the CFO tracks cost-of-quality (COQ) as a leading indicator of margin leakage (industry COQ typically runs 5-10% of revenue in basic chemicals).\n\n**Key KPIs**\n- Critical event count — escalation and regulatory reporting trigger\n- Total cost of quality ($) — direct margin impact; benchmark 5-10% of revenue\n- CAPA closure rate (%) — target ≥ 90% closed-effective within 90 days\n- Average resolution time (days) — target ≤ 30 days for major deviations\n- Batch pass rate / first-pass yield (%) — target ≥ 95% on-spec\n- Root-cause mix (Equipment / Process / Material / Human Error / Environmental) — capex vs. training priority signal\n- Open / In-Progress event backlog — quality system health indicator\n- Temperature deviation magnitude — process-stability leading indicator\n\n**Data sources**\n- `quality_events` — individual deviation records with severity, root cause, COQ, CAPA status\n- `batch_records` — weekly batch outcomes with yield, purity, temperature deviation, pass/fail\n- `quality_kpi_monthly` — monthly rollups: event counts, CAPA closure rate, COQ, batch pass rate",
  "schema_basename": "quality_rca",
  "tables": [
    {
      "table_name": "quality_events",
      "description": "Individual quality event records including deviations, non-conformances, customer complaints, and root cause classifications.",
      "columns": [
        {
          "name": "event_id",
          "sql_type": "STRING",
          "comment": "Unique quality event identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('QE-', LPAD(CAST({id_seq} AS STRING), 5, '0'))"
        },
        {
          "name": "event_date",
          "sql_type": "DATE",
          "comment": "Date event was recorded",
          "is_dimension": false,
          "generation_expr": "dt"
        },
        {
          "name": "product_id",
          "sql_type": "STRING",
          "comment": "Chemical product identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_name",
          "sql_type": "STRING",
          "comment": "Chemical product name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Category: Acids, Bases, Solvents, Polymers, Specialty",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "production_line",
          "sql_type": "STRING",
          "comment": "Production line where event occurred",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.17 THEN 'Line-A1' WHEN {status_noise} < 0.33 THEN 'Line-A2' WHEN {status_noise} < 0.50 THEN 'Line-B1' WHEN {status_noise} < 0.67 THEN 'Line-B2' WHEN {status_noise} < 0.83 THEN 'Line-C1' ELSE 'Line-C2' END"
        },
        {
          "name": "event_type",
          "sql_type": "STRING",
          "comment": "Type: Deviation, Non-Conformance, Customer Complaint, Audit Finding",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.40 THEN 'Deviation' WHEN {alt_status_noise} < 0.65 THEN 'Non-Conformance' WHEN {alt_status_noise} < 0.85 THEN 'Customer Complaint' ELSE 'Audit Finding' END"
        },
        {
          "name": "severity",
          "sql_type": "STRING",
          "comment": "Severity: Critical, Major, Minor",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.08 THEN 'Critical' WHEN {alt_status_noise2} < 0.35 THEN 'Major' ELSE 'Minor' END"
        },
        {
          "name": "root_cause_category",
          "sql_type": "STRING",
          "comment": "Root cause: Equipment, Process, Material, Human Error, Environmental",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise3} < 0.25 THEN 'Equipment' WHEN {alt_status_noise3} < 0.50 THEN 'Process' WHEN {alt_status_noise3} < 0.70 THEN 'Material' WHEN {alt_status_noise3} < 0.88 THEN 'Human Error' ELSE 'Environmental' END"
        },
        {
          "name": "cost_of_quality_usd",
          "sql_type": "DOUBLE",
          "comment": "Estimated cost of the quality event in USD",
          "is_dimension": false,
          "generation_expr": "ROUND(500 + {qty_noise} * 49500, 2)"
        },
        {
          "name": "resolution_days",
          "sql_type": "INT",
          "comment": "Days from event to resolution",
          "is_dimension": false,
          "generation_expr": "CAST(1 + FLOOR({qty_noise} * 59) AS INT)"
        },
        {
          "name": "capa_status",
          "sql_type": "STRING",
          "comment": "CAPA status: Open, In Progress, Closed Effective, Closed Ineffective",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise4} < 0.10 THEN 'Open' WHEN {alt_status_noise4} < 0.25 THEN 'In Progress' WHEN {alt_status_noise4} < 0.90 THEN 'Closed Effective' ELSE 'Closed Ineffective' END"
        }
      ],
