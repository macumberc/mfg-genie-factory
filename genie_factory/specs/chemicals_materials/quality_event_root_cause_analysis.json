  "benchmarks": [
    {
      "question": "What is the monthly trend in critical event count?",
      "sql_lines": [
        "SELECT DATE_TRUNC('month', event_date) AS month, MEASURE(critical_event_count) AS critical_event_count",
        "FROM {fqn}.quality_events_metrics",
        "GROUP BY ALL",
        "ORDER BY month"
      ]
    },
    {
      "question": "How has closed effective count changed over time?",
      "sql_lines": [
        "SELECT event_date, MEASURE(closed_effective_count) AS closed_effective_count",
        "FROM {fqn}.quality_events_metrics",
        "GROUP BY ALL",
        "ORDER BY event_date"
      ]
    },
    {
      "question": "What has been the peak total quality events in the month each month?",
      "sql_lines": [
        "SELECT report_month, MEASURE(max_total_events) AS max_total_events",
        "FROM {fqn}.quality_kpi_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY report_month"
      ]
    },
    {
      "question": "How has total quality events per month changed over time?",
      "sql_lines": [
        "SELECT report_month, MEASURE(total_monthly_events) AS total_monthly_events",
        "FROM {fqn}.quality_kpi_monthly_metrics",
        "GROUP BY ALL",
        "ORDER BY report_month"
      ]
    },
    {
      "question": "Which chemical products have the highest total cost of quality for the month?",
      "sql_lines": [
        "WITH ranked_products AS (",
        "SELECT report_month, product_name, SUM(cost_of_quality_usd) AS total_cost_of_quality_usd, RANK() OVER (PARTITION BY report_month",
        "ORDER BY SUM(cost_of_quality_usd) DESC) AS rnk",
        "FROM {fqn}.quality_kpi_monthly",
        "WHERE product_name IS NOT NULL AND cost_of_quality_usd IS NOT NULL",
        "GROUP BY report_month, product_name )",
        "SELECT report_month, product_name, total_cost_of_quality_usd",
        "FROM ranked_products",
        "WHERE rnk <= 10",
        "ORDER BY report_month, total_cost_of_quality_usd DESC"
      ]
    },
    {
      "question": "What is the average batch yield percentage by chemical product name?",
      "sql_lines": [
        "SELECT product_name, AVG(yield_pct) AS avg_yield_pct",
        "FROM {fqn}.batch_records",
        "GROUP BY product_name ORDER BY avg_yield_pct DESC"
      ]
    },
    {
      "question": "Which chemical products have the highest average capa closure rate?",
      "sql_lines": [
        "WITH avg_closure_rate_per_product AS (",
        "SELECT product_id, MEASURE(avg_capa_closure_rate) AS avg_capa_closure_rate",
        "FROM {fqn}.quality_kpi_monthly_metrics",
        "GROUP BY ALL )",
        "SELECT p.product_name, a.avg_capa_closure_rate",
        "FROM avg_closure_rate_per_product a",
        "JOIN (",
        "SELECT DISTINCT product_id, product_name",
        "FROM {fqn}.quality_kpi_monthly ) p ON a.product_id = p.product_id",
        "WHERE a.avg_capa_closure_rate IS NOT NULL AND p.product_name IS NOT NULL",
        "QUALIFY RANK() OVER (ORDER BY a.avg_capa_closure_rate DESC) <= 10",
        "ORDER BY a.avg_capa_closure_rate DESC"
      ]
    }
  ]
