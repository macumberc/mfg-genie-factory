          "comment": "Fulfillment status: Fulfilled, Partial, Backorder, Cancelled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise2} < 0.02 THEN 'Cancelled' WHEN {alt_status_noise2} < 0.08 THEN 'Backorder' WHEN {alt_status_noise2} < 0.15 THEN 'Partial' ELSE 'Fulfilled' END"
        }
