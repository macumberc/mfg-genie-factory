          "sql_type": "DOUBLE",
          "comment": "Planned throughput tons/day",
          "is_dimension": false,
          "generation_expr": "ROUND(2000.0 + (({qty_noise} * {seasonal_mult}) * 18000.0), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "actual_throughput_tpd",
          "sql_type": "DOUBLE",
          "comment": "Actual throughput tons/day",
          "is_dimension": false,
          "generation_expr": "ROUND((2000.0 + (({qty_noise} * {seasonal_mult}) * 18000.0)) * (0.75 + {status_noise} * 0.35), 0)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "utilization_pct",
          "sql_type": "DOUBLE",
          "comment": "Equipment utilization 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(55.0 + (({qty_noise} * {seasonal_mult}) * 40.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "downtime_hours",
          "sql_type": "DOUBLE",
          "comment": "Unplanned downtime hours",
          "is_dimension": false,
          "generation_expr": "ROUND({qty_noise} * 24.0, 1)"
        },
        {
          "name": "bottleneck_flag",
          "sql_type": "STRING",
          "comment": "Bottleneck: Yes, No",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.20 THEN 'Yes' ELSE 'No' END"
        }
