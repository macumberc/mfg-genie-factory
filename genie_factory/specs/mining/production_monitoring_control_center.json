    {
      "question": "What is the monthly trend in running count?",
      "sql_lines": [
        "SELECT record_date, MEASURE(running_count) AS running_count",
        "FROM {fqn}.production_kpi_monthly",
        "GROUP BY ALL",
        "ORDER BY record_date"
      ]
