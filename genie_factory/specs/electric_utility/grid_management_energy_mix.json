          "is_dimension": false,
          "generation_expr": "ROUND(5.0 + (({qty_noise} * {seasonal_mult}) * 55.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "saifi_events",
          "sql_type": "DOUBLE",
          "comment": "SAIFI - System Average Interruption Frequency Index",
          "is_dimension": false,
          "generation_expr": "ROUND(0.1 + (({qty_noise} * {seasonal_mult}) * 1.4), 3)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "total_carbon_tons",
          "sql_type": "DOUBLE",
          "comment": "Total carbon emissions in metric tons",
          "is_dimension": false,
          "generation_expr": "ROUND(5000.0 + ({qty_noise} * 45000.0), 2)"
        },
        {
          "name": "avg_lmp_usd_mwh",
          "sql_type": "DOUBLE",
          "comment": "Average locational marginal price in USD/MWh",
          "is_dimension": false,
          "generation_expr": "ROUND(25.0 + ({qty_noise} * 75.0), 2)"
        },
