          "comment": "Peak demand in MW for the day",
          "is_dimension": false,
          "generation_expr": "ROUND(200.0 + ({qty_noise} * 1800.0) + (CASE WHEN MONTH(d.dt) IN (7,8) THEN 200.0 WHEN MONTH(d.dt) IN (1,2) THEN 150.0 ELSE 0.0 END), 2)"
        },
