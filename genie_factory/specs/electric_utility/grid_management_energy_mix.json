{
  "company_name": "PowerGrid Analytics",
  "industry": "Electric Utility",
  "use_case": "Grid management, energy mix optimization, and renewable integration",
  "space_title": "PowerGrid Analytics - Grid Management & Energy Mix ⚡",
  "space_description": "**Subindustry:** Electric Utility\n\n**Use case:** Grid Management & Energy Mix Optimization\n\nPowerGrid Analytics — bulk power system analytics for generation dispatch, renewable integration, and reliability across multiple grid zones and regions. Grid Operations and Resource Planning teams use this space to monitor frequency, congestion, and curtailment in near real-time; T&D VPs and ESG leadership use it to track renewable share, carbon intensity, and SAIDI/SAIFI against regulatory targets and decarbonization commitments.\n\n**Key KPIs**\n- Renewable share (%) — generation mix and clean energy target tracking\n- Curtailment (MW / MWh) — wasted renewable energy; healthy <5% of renewable output\n- Carbon intensity (kg CO2/MWh) — sub-200 = mostly clean, 400+ = heavy fossil\n- Capacity factor (%) — asset productivity (solar ~20-25%, wind ~35-45%, nuclear ~90%)\n- Grid frequency (Hz) — target 60.00; deviation >0.05 Hz triggers reliability concerns\n- SAIDI (minutes) — IEEE 1366 industry median ~120 minutes/customer/year\n- SAIFI (events) — industry median ~1.0-1.4 events/customer/year\n- LMP ($/MWh) — locational marginal price; market and congestion signal\n\n**Data sources**\n- `generation_readings` — daily MW output, capacity factor, curtailment, and carbon intensity by zone and fuel type\n- `load_snapshots` — daily peak demand, frequency, congestion, imports/exports, renewable served % by zone\n- `grid_kpi_monthly` — monthly per-zone rollups: renewable share, SAIDI, SAIFI, total carbon, avg LMP, curtailment MWh",
  "schema_basename": "utility_grid_management",
  "tables": [
    {
      "table_name": "generation_readings",
      "description": "Hourly generation readings by fuel source and grid zone including MW output, capacity factor, and curtailment.",
      "columns": [
        {
          "name": "reading_id",
          "sql_type": "STRING",
          "comment": "Unique generation reading identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('GR-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.zone_id) + 10000 AS STRING), 7, '0'))"
        },
        {
          "name": "reading_date",
          "sql_type": "DATE",
          "comment": "Date of generation reading",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "zone_id",
          "sql_type": "STRING",
          "comment": "Grid zone identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "zone_name",
          "sql_type": "STRING",
          "comment": "Grid zone descriptive name",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Geographic region: North, South, East, West, Central",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "fuel_type",
          "sql_type": "STRING",
          "comment": "Generation fuel: Solar, Wind, Natural Gas, Nuclear, Hydro, Coal",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.22 THEN 'Solar' WHEN {status_noise} < 0.42 THEN 'Wind' WHEN {status_noise} < 0.62 THEN 'Natural Gas' WHEN {status_noise} < 0.75 THEN 'Nuclear' WHEN {status_noise} < 0.88 THEN 'Hydro' ELSE 'Coal' END"
        },
        {
          "name": "generation_mw",
          "sql_type": "DOUBLE",
          "comment": "Generation output in megawatts",
          "is_dimension": false,
          "generation_expr": "ROUND(50.0 + ({qty_noise} * 950.0), 2)"
        },
        {
          "name": "capacity_factor_pct",
          "sql_type": "DOUBLE",
          "comment": "Capacity factor as percentage 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(15.0 + (({qty_noise} * {seasonal_mult}) * 80.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "curtailment_mw",
          "sql_type": "DOUBLE",
          "comment": "Curtailed generation in MW (renewable only)",
          "is_dimension": false,
          "generation_expr": "ROUND(CASE WHEN {alt_status_noise} < 0.42 THEN {qty_noise} * 120.0 ELSE 0.0 END, 2)"
        },
        {
          "name": "carbon_intensity_kg_mwh",
          "sql_type": "DOUBLE",
          "comment": "Carbon intensity in kg CO2 per MWh",
          "is_dimension": false,
          "generation_expr": "ROUND(CASE WHEN {alt_status_noise2} < 0.42 THEN 0.0 WHEN {alt_status_noise2} < 0.62 THEN 400.0 + (({qty_noise} * {seasonal_mult}) * 100.0) WHEN {alt_status_noise2} < 0.75 THEN 12.0 WHEN {alt_status_noise2} < 0.88 THEN 24.0 ELSE 900.0 + ({qty_noise} * 100.0) END, 2)",
          "seasonal_amplitude": 0.15
        }
      ],
      "seasonal_patterns": {
