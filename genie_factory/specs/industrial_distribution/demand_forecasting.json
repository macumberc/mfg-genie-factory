          "sql_type": "STRING",
          "comment": "Unique sales order identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('SO-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.sku) + 10000 AS STRING), 6, '0'))"
        },
        {
          "name": "order_date",
          "sql_type": "DATE",
          "comment": "Date order was placed",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "sku",
