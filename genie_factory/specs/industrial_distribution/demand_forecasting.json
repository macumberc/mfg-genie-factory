    {
      "table_name": "demand_forecasts",
      "description": "Monthly demand forecast vs actual by SKU with model accuracy and confidence intervals.",
      "columns": [
        {
          "name": "forecast_id",
          "sql_type": "STRING",
          "comment": "Unique forecast record ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('FC-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.sku) AS STRING), 7, '0'))"
        },
        {
          "name": "forecast_month",
          "sql_type": "DATE",
          "comment": "Forecast month (first day)",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "sku",
          "sql_type": "STRING",
          "comment": "Product SKU",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "forecasted_units",
          "sql_type": "INT",
          "comment": "Model-predicted demand units",
          "is_dimension": false,
          "generation_expr": "CAST(100 + FLOOR({qty_noise} * 4900) AS INT)"
        },
        {
          "name": "actual_units",
          "sql_type": "INT",
          "comment": "Actual units sold",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(0, (100 + FLOOR({qty_noise} * 4900)) * (0.80 + {status_noise} * 0.40)) AS INT)"
        },
        {
          "name": "forecast_error_pct",
          "sql_type": "DOUBLE",
          "comment": "Absolute forecast error percent",
          "is_dimension": false,
          "generation_expr": "ROUND(ABS(({qty_noise} * 0.40) - 0.10) * 100.0, 2)"
        },
        {
          "name": "confidence_lower",
          "sql_type": "INT",
          "comment": "Lower bound of 90% confidence interval",
          "is_dimension": false,
          "generation_expr": "CAST(GREATEST(0, (100 + FLOOR({qty_noise} * 4900)) * 0.75) AS INT)"
        },
        {
          "name": "confidence_upper",
          "sql_type": "INT",
          "comment": "Upper bound of 90% confidence interval",
          "is_dimension": false,
          "generation_expr": "CAST((100 + FLOOR({qty_noise} * 4900)) * 1.25 AS INT)"
        },
        {
          "name": "model_version",
          "sql_type": "STRING",
          "comment": "Forecast model version",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.30 THEN 'v2.0' WHEN {status_noise} < 0.65 THEN 'v2.1' ELSE 'v2.2' END"
        }
      ],
      "seasonal_patterns": {
