          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "customer_segment",
          "sql_type": "STRING",
          "comment": "Customer segment: MRO, OEM, Contractor, Government",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'MRO' WHEN {status_noise} < 0.60 THEN 'OEM' WHEN {status_noise} < 0.85 THEN 'Contractor' ELSE 'Government' END"
        },
        {
          "name": "order_quantity",
          "sql_type": "INT",
          "comment": "Units ordered",
          "is_dimension": false,
          "generation_expr": "CAST(10 + FLOOR({qty_noise} * 990) AS INT)"
        },
        {
          "name": "unit_price_usd",
          "sql_type": "DOUBLE",
          "comment": "Unit price in USD",
          "is_dimension": false,
          "generation_expr": ""
        },
        {
          "name": "lead_time_days",
          "sql_type": "INT",
          "comment": "Promised lead time in days",
          "is_dimension": false,
          "generation_expr": "CAST(1 + FLOOR({qty_noise} * 29) AS INT)"
        },
        {
          "name": "order_status",
          "sql_type": "STRING",
          "comment": "Status: Shipped, Backordered, In Process, Cancelled",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {alt_status_noise} < 0.03 THEN 'Cancelled' WHEN {alt_status_noise} < 0.12 THEN 'Backordered' WHEN {alt_status_noise} < 0.25 THEN 'In Process' ELSE 'Shipped' END"
        }
