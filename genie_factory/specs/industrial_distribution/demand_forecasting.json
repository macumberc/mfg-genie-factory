        {
          "name": "fill_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "Order fill rate 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(80.0 + ({qty_noise} * 19.0), 2)"
        },
        {
          "name": "backorder_units",
          "sql_type": "INT",
          "comment": "Units currently backordered",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 500) AS INT)"
        },
        {
          "name": "avg_days_to_ship",
          "sql_type": "DOUBLE",
          "comment": "Average days from order to ship",
          "is_dimension": false,
          "generation_expr": "ROUND(1.0 + ({qty_noise} * 14.0), 1)"
        },
        {
          "name": "customer_satisfaction_score",
          "sql_type": "DOUBLE",
          "comment": "Customer satisfaction 1-5 scale",
          "is_dimension": false,
          "generation_expr": "ROUND(3.0 + ({qty_noise} * 2.0), 1)"
        },
        {
          "name": "pipeline_status",
          "sql_type": "STRING",
          "comment": "Pipeline: Healthy, Caution, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.08 THEN 'Critical' WHEN {status_noise} < 0.25 THEN 'Caution' ELSE 'Healthy' END"
        }
