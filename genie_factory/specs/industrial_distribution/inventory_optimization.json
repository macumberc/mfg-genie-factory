          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Category: Pipe Fittings, Power Tools, Abrasives, Cutting Tools, Welding",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "quantity_moved",
          "sql_type": "INT",
          "comment": "Units moved (positive=receipt, negative=issue)",
          "is_dimension": false,
          "generation_expr": "CAST(({qty_noise} * 200) - 80 AS INT)"
        },
        {
          "name": "unit_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Unit cost in USD",
          "is_dimension": false,
          "generation_expr": ""
        },
        {
          "name": "movement_type",
          "sql_type": "STRING",
          "comment": "Type: Receipt, Issue, Return, Adjustment, Transfer",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.35 THEN 'Receipt' WHEN {status_noise} < 0.70 THEN 'Issue' WHEN {status_noise} < 0.82 THEN 'Return' WHEN {status_noise} < 0.92 THEN 'Transfer' ELSE 'Adjustment' END"
        },
        {
          "name": "lot_number",
          "sql_type": "STRING",
          "comment": "Lot or batch number",
          "is_dimension": false,
          "generation_expr": "CONCAT('LOT-', LPAD(CAST(FLOOR({qty_noise} * 999) AS STRING), 4, '0'))"
        }
      ],
