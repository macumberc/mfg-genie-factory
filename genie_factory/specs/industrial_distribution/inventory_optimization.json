    {
      "table_name": "inventory_snapshots",
      "description": "Monthly inventory performance snapshots with turnover ratios, stockout rates, and optimization recommendations.",
      "columns": [
        {
          "name": "perf_id",
          "sql_type": "STRING",
          "comment": "Unique performance record ID",
          "is_dimension": false,
          "generation_expr": "CONCAT('IP-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.wp_id) AS STRING), 7, '0'))"
        },
        {
          "name": "perf_month",
          "sql_type": "DATE",
          "comment": "Performance month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "wp_id",
          "sql_type": "STRING",
          "comment": "Warehouse-product identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "warehouse",
          "sql_type": "STRING",
          "comment": "Warehouse",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_category",
          "sql_type": "STRING",
          "comment": "Product category",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "turnover_ratio",
          "sql_type": "DOUBLE",
          "comment": "Inventory turnover ratio",
          "is_dimension": false,
          "generation_expr": "ROUND(2.0 + (({qty_noise} * {seasonal_mult}) * 18.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "stockout_days",
          "sql_type": "INT",
          "comment": "Number of stockout days in month",
          "is_dimension": false,
          "generation_expr": "CAST(FLOOR({qty_noise} * 8) AS INT)"
        },
        {
          "name": "total_carrying_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Monthly carrying cost USD",
          "is_dimension": false,
          "generation_expr": "ROUND(50.0 + ({qty_noise} * 1950.0), 2)"
        },
        {
          "name": "fill_rate_pct",
          "sql_type": "DOUBLE",
          "comment": "Order fill rate 0-100",
          "is_dimension": false,
          "generation_expr": "ROUND(82.0 + (({qty_noise} * {seasonal_mult}) * 17.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "optimization_action",
          "sql_type": "STRING",
          "comment": "Action: Rebalance, Increase Safety Stock, Reduce, No Action",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.15 THEN 'Increase Safety Stock' WHEN {status_noise} < 0.30 THEN 'Reduce' WHEN {status_noise} < 0.45 THEN 'Rebalance' ELSE 'No Action' END"
        }
      ],
      "seasonal_patterns": {
        "Pipe Fittings": {
          "3,4,5": 0.06
        },
        "Power Tools": {
          "4,5": 0.05
        },
        "Abrasives": {
          "3,4": 0.04
        },
        "Cutting Tools": {
          "5,6": 0.05
        },
        "Welding": {
          "4,5,6": 0.06
        }
      },
