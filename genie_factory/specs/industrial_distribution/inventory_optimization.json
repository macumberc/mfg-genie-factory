          "sql_type": "STRING",
          "comment": "Unique inventory movement identifier",
          "is_dimension": false,
          "generation_expr": "CONCAT('INV-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.wp_id) + 10000 AS STRING), 6, '0'))"
        },
        {
          "name": "movement_date",
          "sql_type": "DATE",
          "comment": "Date of inventory movement",
          "is_dimension": false,
          "generation_expr": "d.dt"
        },
        {
          "name": "wp_id",
          "sql_type": "STRING",
          "comment": "Warehouse-product combo identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "product_name",
