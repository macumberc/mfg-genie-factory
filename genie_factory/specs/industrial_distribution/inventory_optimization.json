        {
          "name": "on_hand_qty",
          "sql_type": "INT",
          "comment": "Units on hand",
          "is_dimension": false,
          "generation_expr": "CAST(10 + FLOOR({qty_noise} * 990) AS INT)"
        },
        {
          "name": "reorder_point",
          "sql_type": "INT",
          "comment": "Reorder trigger quantity",
          "is_dimension": false,
          "generation_expr": "CAST(20 + FLOOR({qty_noise} * 180) AS INT)"
        },
        {
          "name": "days_of_supply",
          "sql_type": "DOUBLE",
          "comment": "Estimated days of stock remaining",
          "is_dimension": false,
          "generation_expr": "ROUND(5.0 + {qty_noise} * 200.0, 1)"
        },
        {
          "name": "carrying_cost_usd",
          "sql_type": "DOUBLE",
          "comment": "Weekly inventory carrying cost USD",
          "is_dimension": false,
          "generation_expr": "ROUND(10.0 + ({qty_noise} * 490.0), 2)"
        },
        {
          "name": "stock_status",
          "sql_type": "STRING",
          "comment": "Status: Adequate, Low, Stockout, Overstock",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.05 THEN 'Stockout' WHEN {status_noise} < 0.18 THEN 'Low' WHEN {status_noise} < 0.30 THEN 'Overstock' ELSE 'Adequate' END"
        }
      ],
