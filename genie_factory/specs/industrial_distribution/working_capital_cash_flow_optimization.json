          "name": "total_cash_inflow",
          "expr": "SUM(cash_inflow_usd)",
          "comment": "Total cash inflow USD"
        },
        {
          "name": "total_cash_outflow",
          "expr": "SUM(cash_outflow_usd)",
          "comment": "Total cash outflow USD"
        },
        {
          "name": "total_ar_collected",
