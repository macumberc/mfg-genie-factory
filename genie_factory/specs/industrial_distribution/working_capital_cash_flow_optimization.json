          "comment": "Total AR collected USD"
        },
        {
          "name": "net_cash_flow",
          "expr": "SUM(cash_inflow_usd) - SUM(cash_outflow_usd)",
          "comment": "Net cash flow USD"
        },
        {
          "name": "transaction_count",
          "expr": "COUNT(DISTINCT txn_id)",
          "comment": "Number of transactions"
        },
        {
