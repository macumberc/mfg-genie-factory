      "columns": [
        {
          "name": "forecast_id",
          "sql_type": "STRING",
          "comment": "Unique forecast record",
          "is_dimension": false,
          "generation_expr": "CONCAT('CF-', LPAD(CAST(ROW_NUMBER() OVER (ORDER BY d.dt, e.bu_id) AS STRING), 7, '0'))"
        },
        {
          "name": "forecast_month",
          "sql_type": "DATE",
          "comment": "Forecast month",
          "is_dimension": false,
          "generation_expr": "DATE_TRUNC('month', d.dt)"
        },
        {
          "name": "bu_id",
          "sql_type": "STRING",
          "comment": "Business unit identifier",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "business_segment",
          "sql_type": "STRING",
          "comment": "Business segment",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "region",
          "sql_type": "STRING",
          "comment": "Region",
          "is_dimension": true,
          "generation_expr": ""
        },
        {
          "name": "forecasted_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Forecasted net cash flow USD",
          "is_dimension": false,
          "generation_expr": "ROUND(({qty_noise} - 0.3) * 200000.0, 2)"
        },
        {
          "name": "actual_cash_flow_usd",
          "sql_type": "DOUBLE",
          "comment": "Actual net cash flow USD",
          "is_dimension": false,
          "generation_expr": "ROUND(({qty_noise} - 0.3) * 200000.0 * (0.80 + {status_noise} * 0.40), 2)"
        },
        {
          "name": "cash_conversion_cycle_days",
          "sql_type": "DOUBLE",
          "comment": "Cash conversion cycle in days",
          "is_dimension": false,
          "generation_expr": "ROUND(15.0 + {qty_noise} * 120.0, 1)"
        },
        {
          "name": "current_ratio",
          "sql_type": "DOUBLE",
          "comment": "Current ratio (assets/liabilities)",
          "is_dimension": false,
          "generation_expr": "ROUND(1.0 + (({qty_noise} * {seasonal_mult}) * 2.0), 2)",
          "seasonal_amplitude": 0.15
        },
        {
          "name": "liquidity_status",
          "sql_type": "STRING",
          "comment": "Status: Strong, Adequate, Tight, Critical",
          "is_dimension": false,
          "generation_expr": "CASE WHEN {status_noise} < 0.05 THEN 'Critical' WHEN {status_noise} < 0.15 THEN 'Tight' WHEN {status_noise} < 0.40 THEN 'Adequate' ELSE 'Strong' END"
        }
      ],
