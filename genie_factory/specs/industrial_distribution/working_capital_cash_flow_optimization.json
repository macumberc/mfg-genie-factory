  "metric_views": [
    {
      "view_name": "cashflow_monthly",
      "source_table": "business_units",
      "dimensions": [
        {
          "name": "txn_date",
          "expr": "txn_date"
        },
        {
          "name": "business_segment",
          "expr": "business_segment"
        },
        {
          "name": "region",
          "expr": "region"
        },
        {
          "name": "payment_type",
          "expr": "payment_type"
        }
      ],
      "measures": [
        {
          "name": "total_cash_inflow",
          "expr": "SUM(cash_inflow_usd)",
          "comment": "Total cash inflow USD"
        },
        {
          "name": "total_cash_outflow",
          "expr": "SUM(cash_outflow_usd)",
          "comment": "Total cash outflow USD"
        },
        {
          "name": "total_ar_collected",
          "expr": "SUM(ar_collected_usd)",
          "comment": "Total AR collected USD"
        },
        {
          "name": "net_cash_flow",
          "expr": "SUM(cash_inflow_usd) - SUM(cash_outflow_usd)",
          "comment": "Net cash flow USD"
        },
        {
          "name": "transaction_count",
          "expr": "COUNT(DISTINCT txn_id)",
          "comment": "Number of transactions"
        },
        {
          "name": "unique_bu_count",
          "expr": "COUNT(DISTINCT bu_id)",
          "comment": "Number of distinct bus"
        },
        {
          "name": "max_cash_inflow",
          "expr": "MAX(cash_inflow_usd)",
          "comment": "Maximum cash inflow usd"
        }
      ]
    },
    {
      "view_name": "working_capital_monthly",
      "source_table": "working_capital_snapshots",
      "dimensions": [
        {
          "name": "forecast_month",
          "expr": "forecast_month"
        },
        {
          "name": "business_segment",
          "expr": "business_segment"
        },
        {
          "name": "region",
          "expr": "region"
        },
        {
          "name": "liquidity_status",
          "expr": "liquidity_status"
        }
      ],
      "measures": [
        {
          "name": "total_forecasted_cf",
          "expr": "SUM(forecasted_cash_flow_usd)",
          "comment": "Total forecasted cash flow"
        },
        {
          "name": "total_actual_cf",
          "expr": "SUM(actual_cash_flow_usd)",
          "comment": "Total actual cash flow"
        },
        {
          "name": "avg_ccc_days",
          "expr": "AVG(cash_conversion_cycle_days)",
          "comment": "Average cash conversion cycle days"
        },
        {
          "name": "avg_current_ratio",
          "expr": "AVG(current_ratio)",
          "comment": "Average current ratio"
